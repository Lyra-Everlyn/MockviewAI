@{
    Layout = null;
    var email = ViewBag.Email as string ?? Context.Request.Query["email"].ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Xác thực mã khôi phục - MockviewAI</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/VerifyResetCode.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/themes/theme-indigo.css" media="(prefers-color-scheme: light)" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/themes/theme-dark-1.css" media="(prefers-color-scheme: dark)" asp-append-version="true" />
</head>
<body class="app-layout app-layout--auth">
    <div class="app-layout__content">
        <main class="auth-page reset-otp-page">
            <div class="auth-shell reset-otp-shell">
                <section class="auth-intro" aria-labelledby="reset-otp-intro-title">
                    <div class="auth-intro__top">
                        <a class="auth-brand" asp-controller="Home" asp-action="Index" aria-label="MockviewAI - Trang chủ">
                            <span class="auth-brand__mark" aria-hidden="true">
                                <img src="~/favicon.ico" asp-append-version="true" alt="" />
                            </span>
                            <span>Mockview<span>AI</span></span>
                        </a>
                        <span class="auth-intro__badge">2.0.0</span>
                    </div>

                    <div class="auth-intro__body">
                        <span class="auth-intro__eyebrow">
                            <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                            KHÔI PHỤC TÀI KHOẢN
                        </span>
                        <h1 id="reset-otp-intro-title">Thêm một bước để bảo vệ tài khoản của bạn.</h1>
                        <p>Nhập mã từ email để xác minh yêu cầu khôi phục trước khi đặt lại mật khẩu.</p>

                        <ol class="auth-steps reset-otp-steps" aria-label="Tiến trình khôi phục mật khẩu">
                            <li class="reset-otp-steps__done">
                                <span class="auth-steps__icon"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
                                <span><strong>Nhập email đã đăng ký</strong><small>Đã hoàn tất</small></span>
                            </li>
                            <li class="reset-otp-steps__current" aria-current="step">
                                <span class="auth-steps__icon"><i class="fa-solid fa-envelope-open-text" aria-hidden="true"></i></span>
                                <span><strong>Nhận mã xác thực</strong><small>Đang thực hiện</small></span>
                            </li>
                            <li>
                                <span class="auth-steps__icon"><i class="fa-solid fa-lock" aria-hidden="true"></i></span>
                                <span><strong>Tạo mật khẩu mới</strong><small>Hoàn tất khôi phục tài khoản</small></span>
                            </li>
                        </ol>
                    </div>
                    <p class="auth-intro__bottom">Xác thực an toàn · MockviewAI</p>
                </section>

                <section class="auth-panel reset-otp-panel" aria-labelledby="reset-otp-heading">
                    <div class="auth-panel__mobile-brand">
                        <span class="auth-brand__mark" aria-hidden="true">
                            <img src="~/favicon.ico" asp-append-version="true" alt="" />
                        </span>
                        <strong>Mockview<span>AI</span></strong>
                    </div>
                    <div class="reset-otp-panel__symbol" aria-hidden="true">
                        <i class="fa-regular fa-envelope-open"></i>
                    </div>

                    <div class="auth-panel__header reset-otp-panel__header">
                        <span class="auth-panel__eyebrow">BƯỚC 2 / 3 · XÁC THỰC EMAIL</span>
                        <h2 id="reset-otp-heading">Kiểm tra hộp thư của bạn</h2>
                        <p>Nhập mã khôi phục gồm 6 chữ số đã được gửi đến:</p>
                        <p class="reset-otp-panel__email">
                            <i class="fa-regular fa-envelope" aria-hidden="true"></i>
                            <strong>@email</strong>
                        </p>
                        <p class="reset-otp-panel__expiry">
                            <i class="fa-regular fa-clock" aria-hidden="true"></i>
                            Mã có hiệu lực trong 5 phút.
                        </p>
                    </div>

                    <form id="verifyForm" class="auth-form reset-otp-form" method="post"
                          asp-controller="Auth" asp-action="VerifyResetCode"
                          data-loading-text="Đang xác thực..."
                          data-loading-overlay="Hệ thống đang xác minh mã khôi phục của bạn.">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="email" value="@email" />
                        <input type="hidden" name="code" id="finalCode" />

                        <fieldset class="otp-fieldset">
                            <legend class="form-field__label">Mã xác thực</legend>
                            <div class="otp-control" role="group" aria-label="Mã xác thực gồm 6 chữ số">
                                @for (int i = 0; i < 6; i++)
                                {
                                    <input class="otp-control__digit otp-input" type="text"
                                           inputmode="numeric" pattern="[0-9]*"
                                           autocomplete="@(i == 0 ? "one-time-code" : "off")"
                                           aria-label="Chữ số @(i + 1)" required />
                                }
                            </div>
                            <p class="otp-control__message" id="otp-message" role="status" aria-live="polite"></p>
                        </fieldset>

                        <button type="submit" class="button button--primary auth-submit">
                            <span>Xác thực mã</span>
                            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                        </button>
                    </form>

                    <p class="reset-otp-panel__help">
                        Chưa nhận được mã? Hãy kiểm tra cả thư mục Spam hoặc Thư rác.
                    </p>
                    <a class="reset-otp-panel__back text-link" asp-controller="Auth" asp-action="ForgotPassword">
                        <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
                        Nhầm email? Quay lại
                    </a>
                </section>
            </div>
        </main>
    </div>

    <partial name="Partials/_AppFooter" />
    <partial name="Partials/_Notify" />
    <script src="~/js/VerifyCode.js" asp-append-version="true" defer></script>
    <script src="~/js/_SubmitLoading.js" asp-append-version="true" defer></script>
</body>
</html>
