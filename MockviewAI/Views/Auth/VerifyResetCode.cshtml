@{
    Layout = null;
    var email = Context.Request.Query["email"].ToString();
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Xác thực mã khôi phục - MockviewAI</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/ForgotPassword.css">
</head>

<body>
    <div class="forgot-wrapper">
        <div class="forgot-container">

            <div class="info-panel">
                <div class="logo">Mockview<span>AI</span></div>
                <h1>Bảo vệ tài khoản của bạn</h1>
                <p class="subtitle">Chúng tôi đã gửi mã xác thực an toàn đến email của bạn. Bước này giúp đảm bảo chỉ có bạn mới có quyền truy cập vào tài khoản.</p>
                <ul class="features">
                    <li><span class="step"><i class="fas fa-envelope"></i></span> Nhập email đã đăng ký</li>
                    <li><span class="step active"><i class="fas fa-paper-plane"></i></span> Nhận mã khôi phục bảo mật</li>
                    <li><span class="step"><i class="fas fa-lock"></i></span> Tạo mật khẩu mới</li>
                </ul>
            </div>

            <div class="form-panel">

                <div class="mobile-header hide-on-desktop">
                    <div class="logo-dark">Mockview<span>AI</span></div>
                </div>

                <div class="form-header">
                    <h2>Kiểm tra hộp thư của bạn</h2>
                </div>

                <p class="description">
                    Chúng tôi đã gửi mã xác thực 6 số đến <strong>@email</strong>.
                    Mã này sẽ hết hạn trong vòng 5 phút.
                </p>

                <form method="post" asp-controller="Auth" asp-action="VerifyResetCode" id="verifyForm">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="email" value="@email" />
                    <input type="hidden" name="code" id="finalCode" />

                    <div class="form-group">
                        <label>Mã xác thực</label>
                        <div class="otp-wrapper">
                            <input type="text" class="otp-input" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code" aria-label="Chữ số 1" required autofocus>
                            <input type="text" class="otp-input" inputmode="numeric" pattern="[0-9]*" autocomplete="off" aria-label="Chữ số 2" required>
                            <input type="text" class="otp-input" inputmode="numeric" pattern="[0-9]*" autocomplete="off" aria-label="Chữ số 3" required>
                            <input type="text" class="otp-input" inputmode="numeric" pattern="[0-9]*" autocomplete="off" aria-label="Chữ số 4" required>
                            <input type="text" class="otp-input" inputmode="numeric" pattern="[0-9]*" autocomplete="off" aria-label="Chữ số 5" required>
                            <input type="text" class="otp-input" inputmode="numeric" pattern="[0-9]*" autocomplete="off" aria-label="Chữ số 6" required>
                        </div>
                    </div>

                    <button type="submit" class="btn-submit">Xác thực mã</button>

                    <div class="back-link">
                        <a href="/Auth/ForgotPassword"><i class="fas fa-arrow-left"></i> Nhầm email? Quay lại</a>
                    </div>
                </form>

            </div>
        </div>
    </div>

    <partial name="Partials/_Notify" />
    <script src="~/js/VerifyCode.js"></script>
</body>
</html>