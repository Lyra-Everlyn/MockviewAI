@{
    Layout = null;
    var email = Context.Request.Query["email"].ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Reset Code - MockviewAI</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/ForgotPassword.css">
</head>

<body>
    <div class="forgot-wrapper">
        <div class="forgot-container">

            <div class="info-panel">
                <div class="logo">Mockview<span>AI</span></div>
                <h1>Secure your account</h1>
                <p class="subtitle">We've sent a secure code to your email. This step ensures that only you can access your account.</p>
                <ul class="features">
                    <li><span class="step"><i class="fas fa-envelope"></i></span> Enter your registered email</li>
                    <li><span class="step active"><i class="fas fa-paper-plane"></i></span> Receive a secure reset code</li>
                    <li><span class="step"><i class="fas fa-lock"></i></span> Create a new password</li>
                </ul>
            </div>


            <div class="form-panel">
                
                <div class="mobile-header hide-on-desktop">
                    <div class="logo-dark">Mockview<span>AI</span></div>
                </div>

                <div class="form-header">
                    <h2>Check your email</h2>
                </div>
                
                <p class="description">
                    We've sent a 6-digit verification code to <strong>@email</strong>. 
                    The code expires in 5 minutes.
                </p>

                <form method="post" asp-controller="Auth" asp-action="VerifyResetCode" id="verifyForm">
                    @Html.AntiForgeryToken()
                    
                    <input type="hidden" name="email" value="@email" />
                    <input type="hidden" name="code" id="finalCode" />

                    <div class="form-group">
                        <label>Verification Code</label>
                        <div class="otp-wrapper">
                            <input type="text" class="otp-input" maxlength="1" autocomplete="off" required autofocus>
                            <input type="text" class="otp-input" maxlength="1" autocomplete="off" required>
                            <input type="text" class="otp-input" maxlength="1" autocomplete="off" required>
                            <input type="text" class="otp-input" maxlength="1" autocomplete="off" required>
                            <input type="text" class="otp-input" maxlength="1" autocomplete="off" required>
                            <input type="text" class="otp-input" maxlength="1" autocomplete="off" required>
                        </div>
                    </div>

                    <button type="submit" class="btn-submit">Verify Code</button>

                    <div class="back-link">
                        <a href="/Auth/ForgotPassword"><i class="fas fa-arrow-left"></i> Wrong email? Go back</a>
                    </div>
                </form>

            </div>
        </div>
    </div>

    <partial name="Partials/_Notify"/>
    <<script src="~/js/VerifyCode.js"></script>
</body>
</html>