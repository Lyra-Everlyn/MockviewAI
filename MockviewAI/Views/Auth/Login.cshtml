@*
    NOTE: 
        Đây chỉ là mẫu form đăng nhập, nếu bạn có đọc được thì hãy tự triển khai thêm các tính năng cần thiết.
    TODO: 
        Add a "Remember Me" checkbox to the login form for user convenience.
        Implement a full Login page with proper styling and error handling.
        Ensure that the Google login button is functional and redirects to the appropriate authentication flow.
*@

@* Part 1: Template Form *@
<form method="post" asp-controller="Auth" asp-action="Login" id="loginForm">
    @Html.AntiForgeryToken()

    <!-- Google Login Button -->
    <a asp-controller="Auth" asp-action="LoginGoogle" class="btn-google">
        <img src="" alt="Google Logo">
        Login with Google
    </a>


    <div class="divider">OR WITH LOCAL ACCOUNT</div>

    <div class="input-group">
        <i class="fas fa-envelope"></i>
        <input type="email" name="email" id="email-login" placeholder="Email" required>
    </div>

    <div class="input-group">
        <i class="fas fa-lock"></i>
        <input type="password" name="password" id="pass-login" placeholder="Password" required>
        <i class="far fa-eye toggle-password" onclick="togglePass('pass-login', this)"></i>
    </div>

    <div class="form-group">
        <label>
            <input type="checkbox" name="rememberMe" id="rememberMe">
            Remember Me
        </label>
    </div>

    <button type="submit">Login</button>
</form>



@* Part 2: Display Error Messages, put this at the bottom of the form *@
@{
    var errorMessage = "";
    // Get Exception or Validation error from Controller
    if (!ViewData.ModelState.IsValid)
    {
        errorMessage = ViewData.ModelState.Values
                        .SelectMany(v => v.Errors)
                        .Select(e => e.ErrorMessage)
                        .FirstOrDefault();
    }
    // Get error from Google
    else if (TempData["ErrorMessage"] != null)
    {
        errorMessage = TempData["ErrorMessage"]?.ToString();
    }
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const serverError = '@Html.Raw(errorMessage.Replace("'", "\\'"))';
            const passElement = document.getElementById('pass-login');
            const emailElement = document.getElementById('email-login');

            if (serverError.toLowerCase().includes('account') || serverError.toLowerCase().includes('email')) {
                showError(emailElement, serverError);
            } else {
                showError(passElement, serverError);
            }
        });
    </script>
}

<script src="~/js/handle-input-error.js"></script>
