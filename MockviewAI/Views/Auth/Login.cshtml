@{
    Layout = null;
    @inject IConfiguration Configuration
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng nhập - MockviewAI</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/Login.css">

    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</head>
<body>

    <div class="login-wrapper">
        <div class="login-box">

            <div class="login-banner">
                <div class="banner-logo">MockviewAI</div>
                <h1 class="banner-title">Luyện phỏng vấn với AI trước ngày phỏng vấn thật</h1>
                <p class="banner-subtitle">Dành cho sinh viên sắp ra trường và người mới đi làm.</p>
                <ul class="banner-features">
                    <li><span class="step-num">1</span> Chọn vị trí và người phỏng vấn</li>
                    <li><span class="step-num">2</span> Trả lời bằng giọng nói hoặc gõ chữ</li>
                    <li><span class="step-num">3</span> Xem điểm, nhận xét và mức lo lắng</li>
                </ul>
            </div>

            <div class="login-form-container">
                <div class="form-header">
                    <div class="title-wrapper">
                        <h2>Đăng nhập</h2>
                        <span class="badge-beta">BETA</span>
                    </div>
                    <p class="subtitle">Luyện phỏng vấn với AI, hoàn toàn miễn phí.</p>
                </div>

                <form method="post" asp-controller="Auth" asp-action="Login" id="loginForm" data-loading-text="Đang đăng nhập...">
                    @Html.AntiForgeryToken()

                    <a asp-controller="Auth" asp-action="LoginGoogle" class="btn-google">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/c/c1/Google_%22G%22_logo.svg" alt="Google Logo">
                        Đăng nhập bằng Google
                    </a>

                    <div class="divider">
                        <span>HOẶC VỚI TÀI KHOẢN MOCKVIEW</span>
                    </div>

                    <div class="form-group">
                        <label for="email-login">Email</label>
                        <div class="input-group">
                            <i class="fas fa-envelope icon-left"></i>
                            <input type="email" name="email" id="email-login" placeholder="you@email.com" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="pass-login">Mật khẩu</label>
                        <div class="input-group">
                            <i class="fas fa-lock icon-left"></i>
                            <input type="password" name="password" id="pass-login" placeholder="Nhập mật khẩu" required>
                            <i class="far fa-eye toggle-password" onclick="togglePass('pass-login', this)"></i>
                        </div>
                    </div>

                    <div class="form-group">
                        <a href="/Auth/ForgotPassword" class="forgot-password-link">Quên mật khẩu?</a>
                    </div>

                    <div class="form-group">
                        <div class="cf-turnstile" data-theme="light" data-size="flexible" data-sitekey="@Configuration["Turnstile:SiteKey"]"></div>
                    </div>

                    <button type="submit" class="btn-submit">Đăng nhập</button>

                </form>

                <div class="auth-switch">
                    Chưa có tài khoản? <a href="/Auth/Register">Đăng ký ngay</a>
                </div>
            </div>

        </div>
    </div>

    <partial name="Partials/_Notify" />
    <script src="~/js/_TogglePassword.js"></script>
    <script src="~/js/_SubmitLoading.js"></script>
</body>
</html>