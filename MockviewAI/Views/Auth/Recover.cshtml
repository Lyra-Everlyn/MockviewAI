<form asp-controller="Auth" asp-action="ForgotPassword" method="post">
    @Html.AntiForgeryToken()
    <input type="email" name="email" placeholder="Nhập email của bạn" required />
    <button type="submit">Gửi mã xác nhận</button>
</form>

<form asp-controller="Auth" asp-action="VerifyOTP" method="post">
    @Html.AntiForgeryToken()
    <!-- Ẩn email để server biết đang xác thực cho ai -->
    <input type="hidden" name="email" value="@Model.Email" />
    <input type="text" name="otpCode" placeholder="Nhập mã 8 ký tự" required />
    <button type="submit">Xác nhận</button>
</form>

<form asp-controller="Auth" asp-action="ResetPassword" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="email" value="@Model.Email" />
    <input type="hidden" name="otpCode" value="@Model.OtpCode" /> <!-- Giữ lại mã để xác thực lần cuối -->

    <input type="password" name="newPassword" placeholder="Mật khẩu mới" required />
    <input type="password" name="confirmPassword" placeholder="Xác nhận mật khẩu" required />
    <button type="submit">Đổi mật khẩu</button>
</form>