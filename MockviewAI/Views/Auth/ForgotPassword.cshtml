@{
    Layout = null;
    @inject IConfiguration Configuration
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quên mật khẩu - MockviewAI</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/ForgotPassword.css">

    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</head>

<body>
    <div class="forgot-wrapper">
        <div class="forgot-container">

            <div class="info-panel">
                <div class="logo">Mockview<span>AI</span></div>
                <h1>Bảo vệ tài khoản của bạn</h1>
                <p class="subtitle">Đừng lo lắng, sự cố này rất thường gặp. Chúng tôi sẽ hỗ trợ bạn lấy lại quyền truy cập an toàn.</p>
                <ul class="features">
                    <li><span class="step active"><i class="fas fa-envelope"></i></span> Nhập email đã đăng ký</li>
                    <li><span class="step"><i class="fas fa-paper-plane"></i></span> Nhận mã xác thực bảo mật</li>
                    <li><span class="step"><i class="fas fa-lock"></i></span> Tạo mật khẩu mới</li>
                </ul>
            </div>

            <div class="form-panel">

                <!-- Mobile Header -->
                <div class="mobile-header hide-on-desktop">
                    <div class="logo-dark">Mockview<span>AI</span></div>
                </div>

                <div class="form-header">
                    <h2>Quên mật khẩu?</h2>
                </div>

                <p class="description">Nhập địa chỉ email liên kết với tài khoản của bạn và chúng tôi sẽ gửi mã đặt lại mật khẩu.</p>

                <form method="post" asp-controller="Auth" asp-action="ForgotPassword" data-loading-text="Đang gửi..." data-loading-overlay="Đang gửi mã khôi phục đến email của bạn. Quá trình này có thể mất vài giây...">
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label>Địa chỉ Email</label>
                        <input type="email" name="email" placeholder="you@email.com" required>
                    </div>

                    <div class="form-group">
                        <div class="cf-turnstile" data-theme="light" data-size="flexible" data-sitekey="@Configuration["Turnstile:SiteKey"]"></div>
                    </div>

                    <button type="submit" class="btn-submit">Gửi mã khôi phục</button>

                    <div class="back-link">
                        <a href="/Auth/Login"><i class="fas fa-arrow-left"></i> Quay lại Đăng nhập</a>
                    </div>
                </form>

            </div>
        </div>
    </div>

    <partial name="Partials/_Notify" />
    <script src="~/js/_SubmitLoading.js"></script>
</body>
</html>