@inject IConfiguration Configuration
@{
    Layout = null;
    ViewData["Title"] = "Quên mật khẩu";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Quên mật khẩu - MockviewAI</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ForgotPassword.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/themes/theme-indigo.css" asp-append-version="true" />
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</head>
<body class="app-layout app-layout--auth">
    <div class="app-layout__content">
        <main class="auth-page recovery-page">
            <div class="auth-shell recovery-shell">
                <section class="auth-intro" aria-labelledby="recovery-intro-title">
                    <div class="auth-intro__top">
                        <a class="auth-brand" asp-controller="Home" asp-action="Index"
                           aria-label="MockviewAI - Trang chủ">
                            <span class="auth-brand__mark" aria-hidden="true">
                                <img src="~/favicon.ico" asp-append-version="true" alt="" />
                            </span>
                            <span>Mockview<span>AI</span></span>
                        </a>
                        <span class="auth-intro__badge">2.0.0</span>
                    </div>

                    <div class="auth-intro__body">
                        <span class="auth-intro__eyebrow">
                            <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                            KHÔI PHỤC TÀI KHOẢN
                        </span>
                        <h1 id="recovery-intro-title">Lấy lại quyền truy cập một cách an toàn.</h1>
                        <p>Chúng tôi sẽ hướng dẫn bạn xác minh email và đặt lại mật khẩu để tiếp tục luyện phỏng vấn.</p>

                        <ol class="auth-steps recovery-steps" aria-label="Các bước khôi phục tài khoản">
                            <li class="recovery-steps__current" aria-current="step">
                                <span class="auth-steps__icon">
                                    <i class="fa-regular fa-envelope" aria-hidden="true"></i>
                                </span>
                                <span>
                                    <strong>Nhập email đã đăng ký</strong>
                                    <small>Đang thực hiện</small>
                                </span>
                            </li>
                            <li>
                                <span class="auth-steps__icon">
                                    <i class="fa-solid fa-envelope-open-text" aria-hidden="true"></i>
                                </span>
                                <span>
                                    <strong>Nhận mã xác thực</strong>
                                    <small>Kiểm tra hộp thư đến</small>
                                </span>
                            </li>
                            <li>
                                <span class="auth-steps__icon">
                                    <i class="fa-solid fa-lock" aria-hidden="true"></i>
                                </span>
                                <span>
                                    <strong>Tạo mật khẩu mới</strong>
                                    <small>Hoàn tất khôi phục tài khoản</small>
                                </span>
                            </li>
                        </ol>
                    </div>
                    <p class="auth-intro__bottom">Bảo vệ tài khoản của bạn · MockviewAI</p>
                </section>

                <section class="auth-panel recovery-panel" aria-labelledby="recovery-heading">
                    <div class="auth-panel__mobile-brand">
                        <span class="auth-brand__mark" aria-hidden="true">
                            <img src="~/favicon.ico" asp-append-version="true" alt="" />
                        </span>
                        <strong>Mockview<span>AI</span></strong>
                    </div>

                    <div class="recovery-panel__symbol" aria-hidden="true">
                        <i class="fa-regular fa-envelope-open"></i>
                    </div>
                    <div class="auth-panel__header">
                        <span class="auth-panel__eyebrow">KHÔI PHỤC MẬT KHẨU</span>
                        <h2 id="recovery-heading">Quên mật khẩu?</h2>
                        <p>
                            Nhập email liên kết với tài khoản. Chúng tôi sẽ gửi mã xác thực
                            để bạn đặt lại mật khẩu.
                        </p>
                    </div>

                    <form class="auth-form" method="post"
                          asp-controller="Auth" asp-action="ForgotPassword"
                          data-loading-text="Đang gửi mã..."
                          data-loading-overlay="Đang gửi mã khôi phục đến email của bạn. Quá trình này có thể mất vài giây.">
                        @Html.AntiForgeryToken()

                        <div class="form-field">
                            <label class="form-field__label" for="recovery-email">
                                Địa chỉ email
                            </label>
                            <div class="form-control-wrap">
                                <i class="fa-regular fa-envelope" aria-hidden="true"></i>
                                <input id="recovery-email" class="form-control"
                                       type="email" name="email"
                                       placeholder="you@email.com"
                                       autocomplete="email" required autofocus />
                            </div>
                        </div>

                        <div class="auth-turnstile">
                            <div class="cf-turnstile"
                                 data-theme="light" data-size="flexible"
                                 data-sitekey="@Configuration["Turnstile:SiteKey"]"></div>
                        </div>

                        <button type="submit" class="button button--primary auth-submit">
                            <span>Gửi mã khôi phục</span>
                            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                        </button>
                    </form>

                    <a class="recovery-panel__back text-link"
                       asp-controller="Auth" asp-action="Login">
                        <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
                        Quay lại đăng nhập
                    </a>
                    <p class="auth-panel__note">
                        <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                        Xác minh email giúp bảo vệ quyền truy cập tài khoản.
                    </p>
                </section>
            </div>
        </main>
    </div>

    <partial name="Partials/_AppFooter" />
    <partial name="Partials/_Notify" />
    <script src="~/js/_SubmitLoading.js" asp-append-version="true" defer></script>
</body>
</html>
