@inject IConfiguration Configuration
@{
    Layout = null;
    ViewData["Title"] = "Quên mật khẩu";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Quên mật khẩu - MockviewAI</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Login.css" asp-append-version="true" />
    <partial name="Partials/_ThemeHead" />
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</head>
<body class="app-layout app-layout--auth">
    <div class="app-layout__content">
        <main class="auth-page">
            <div class="auth-shell">
                <partial name="_AuthSteps" model="1" />

                <section class="auth-panel" aria-labelledby="recovery-heading">
                    <div class="auth-panel__header">
                        <h1 id="recovery-heading">Quên mật khẩu?</h1>
                        <p>Nhập email của tài khoản, chúng tôi sẽ gửi mã 6 số để bạn đặt lại mật khẩu.</p>
                    </div>

                    <form class="auth-form" method="post" asp-controller="Auth" asp-action="ForgotPassword"
                          data-loading-text="Đang gửi mã..."
                          data-loading-overlay="Đang gửi mã khôi phục đến email của bạn. Quá trình này có thể mất vài giây.">
                        @Html.AntiForgeryToken()

                        <div class="form-field">
                            <label class="form-field__label" for="recovery-email">Email</label>
                            <div class="form-control-wrap">
                                <i class="fa-regular fa-envelope" aria-hidden="true"></i>
                                <input id="recovery-email" class="form-control" type="email" name="email"
                                       placeholder="you@email.com" autocomplete="email" required autofocus />
                            </div>
                        </div>

                        <div class="auth-turnstile">
                            <div class="cf-turnstile" data-theme="light" data-size="flexible" data-sitekey="@Configuration["Turnstile:SiteKey"]"></div>
                        </div>

                        <button type="submit" class="button button--primary button--icon auth-submit">
                            <span class="button__icon" aria-hidden="true"><i class="fa-solid fa-arrow-right"></i></span>
                            <span>Gửi mã</span>
                        </button>
                    </form>

                    <a class="auth-back" asp-controller="Auth" asp-action="Login">
                        <i class="fa-solid fa-chevron-left" aria-hidden="true"></i> Quay lại đăng nhập
                    </a>
                </section>
            </div>
        </main>
    </div>

    <partial name="Partials/_AppFooter" />
    <partial name="Partials/_Notify" />
    <script src="~/js/_SubmitLoading.js" asp-append-version="true" defer></script>
</body>
</html>
