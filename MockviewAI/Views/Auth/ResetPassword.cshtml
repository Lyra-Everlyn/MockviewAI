@{
    Layout = null;
    var email = ViewBag.Email as string;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đặt lại mật khẩu - MockviewAI</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/ForgotPassword.css">
    <link rel="stylesheet" href="~/css/ResetPassword.css">
</head>

<body>
    <div class="forgot-wrapper">
        <div class="forgot-container">

            <div class="info-panel">
                <div class="logo">Mockview<span>AI</span></div>
                <h1>Bảo vệ tài khoản của bạn</h1>
                <p class="subtitle">Sắp hoàn tất rồi! Hãy tạo một mật khẩu mới đủ mạnh để bảo vệ tiến trình luyện phỏng vấn của bạn.</p>
                <ul class="features">
                    <li><span class="step"><i class="fas fa-envelope"></i></span> Nhập email đã đăng ký</li>
                    <li><span class="step"><i class="fas fa-paper-plane"></i></span> Nhận mã khôi phục bảo mật</li>
                    <li><span class="step active"><i class="fas fa-lock"></i></span> Tạo mật khẩu mới</li>
                </ul>
            </div>

            <div class="form-panel">
                <div class="mobile-header hide-on-desktop">
                    <div class="logo-dark">Mockview<span>AI</span></div>
                </div>

                <div class="form-header">
                    <h2>Tạo mật khẩu mới</h2>
                </div>
                <p class="description">Mật khẩu mới phải có ít nhất 8 ký tự, bao gồm chữ hoa, chữ thường và chữ số.</p>

                <form method="post" asp-controller="Auth" asp-action="ResetPassword" data-loading-text="Đang lưu...">

                    @Html.AntiForgeryToken()
                    <input type="hidden" name="email" value="@email" />

                    <div class="form-group">
                        <label>Mật khẩu mới</label>
                        <div class="input-group">
                            <input type="password" name="newPassword" id="reset-pass" placeholder="Nhập mật khẩu mới" required autofocus>
                            <i class="far fa-eye toggle-password" onclick="togglePass('reset-pass', this)"></i>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Xác nhận mật khẩu mới</label>
                        <div class="input-group">
                            <input type="password" name="confirmPassword" id="reset-confirm" placeholder="Nhập lại mật khẩu mới" required>
                            <i class="far fa-eye toggle-password" onclick="togglePass('reset-confirm', this)"></i>
                        </div>
                    </div>

                    <button type="submit" class="btn-submit">Đặt lại mật khẩu</button>
                </form>
            </div>
        </div>
    </div>

    <partial name="Partials/_Notify" />
    <script src="~/js/_TogglePassword.js"></script>
    <script src="~/js/_SubmitLoading.js"></script>
</body>
</html>