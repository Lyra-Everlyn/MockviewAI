@{
    Layout = null;
    var email = ViewBag.Email as string;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password - MockviewAI</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/ForgotPassword.css">
    <link rel="stylesheet" href="~/css/ResetPassword.css">
</head>

<body>
    <div class="forgot-wrapper">
        <div class="forgot-container">

            <div class="info-panel">
                <div class="logo">Mockview<span>AI</span></div>
                <h1>Secure your account</h1>
                <p class="subtitle">Almost there! Create a new, strong password to protect your interview progress.</p>
                <ul class="features">
                    <li><span class="step"><i class="fas fa-envelope"></i></span> Enter your registered email</li>
                    <li><span class="step"><i class="fas fa-paper-plane"></i></span> Receive a secure reset code</li>
                    <li><span class="step active" style="background: #fff; color: var(--primary-color);"><i class="fas fa-lock"></i></span> Create a new password</li>
                </ul>
            </div>

            <div class="form-panel">
                <div class="mobile-header hide-on-desktop">
                    <div class="logo-dark">Mockview<span>AI</span></div>
                </div>

                <div class="form-header">
                    <h2>Create new password</h2>
                </div>
                <p class="description">Your new password must be at least 8 characters and include uppercase, lowercase, and numbers.</p>

                <form method="post" asp-controller="Auth" asp-action="ResetPassword">
                    
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="email" value="@email" />
                    
                    <div class="form-group">
                        <label>New Password</label>
                        <div class="input-group">
                            <input type="password" name="newPassword" id="reset-pass" placeholder="Enter new password" required autofocus>
                            <i class="far fa-eye toggle-password" onclick="togglePass('reset-pass', this)"></i>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Confirm New Password</label>
                        <div class="input-group">
                            <input type="password" name="confirmPassword" id="reset-confirm" placeholder="Confirm new password" required>
                            <i class="far fa-eye toggle-password" onclick="togglePass('reset-confirm', this)"></i>
                        </div>
                    </div>

                    <button type="submit" class="btn-submit">Reset Password</button>
                </form>
            </div>
        </div>
    </div>

    <partial name="Partials/_Notify"/>
    <script src="~/js/_TogglePassword.js"></script>
</body>
</html>