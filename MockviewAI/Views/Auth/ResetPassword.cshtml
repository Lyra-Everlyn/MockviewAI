@{
    Layout = null;
    var email = ViewBag.Email as string ?? Context.Request.Query["email"].ToString();
    var resetToken = ViewBag.ResetToken as string ?? string.Empty;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đặt lại mật khẩu - MockviewAI</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ResetPassword.css" asp-append-version="true" />
    <partial name="Partials/_ThemeHead" />
</head>
<body class="app-layout app-layout--auth">
    <div class="app-layout__content">
        <main class="auth-page">
            <div class="auth-shell">
                <partial name="_AuthSteps" model="3" />

                <section class="auth-panel" aria-labelledby="reset-heading">
                    <div class="auth-panel__header">
                        <h1 id="reset-heading">Tạo mật khẩu mới</h1>
                        <p>Đặt mật khẩu dễ nhớ với bạn nhưng khó đoán với người khác.</p>
                    </div>

                    <form class="auth-form" method="post" asp-controller="Auth" asp-action="ResetPassword"
                          data-loading-text="Đang cập nhật..."
                          data-loading-overlay="Đang cập nhật mật khẩu của bạn. Vui lòng không gửi yêu cầu nhiều lần.">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="email" value="@email" />
                        <input type="hidden" name="resetToken" value="@resetToken" />

                        <div class="form-field">
                            <label class="form-field__label" for="reset-pass">Mật khẩu mới</label>
                            <div class="form-control-wrap auth-password-field">
                                <i class="fa-solid fa-lock" aria-hidden="true"></i>
                                <input class="form-control" type="password" id="reset-pass" name="newPassword"
                                       placeholder="Nhập mật khẩu mới" autocomplete="new-password" minlength="8" required autofocus aria-describedby="reset-rules" />
                                <button class="auth-password-toggle" type="button" data-password-toggle="reset-pass" aria-controls="reset-pass"
                                        aria-label="Hiển thị mật khẩu" aria-pressed="false">
                                    <i class="fa-regular fa-eye" aria-hidden="true"></i>
                                </button>
                            </div>
                            <ul class="reset-rules" id="reset-rules" aria-label="Yêu cầu mật khẩu">
                                <li><i class="fa-solid fa-check" aria-hidden="true"></i> Ít nhất 8 ký tự</li>
                                <li><i class="fa-solid fa-check" aria-hidden="true"></i> Chữ hoa và chữ thường</li>
                                <li><i class="fa-solid fa-check" aria-hidden="true"></i> Có chữ số</li>
                            </ul>
                        </div>

                        <div class="form-field">
                            <label class="form-field__label" for="reset-confirm">Nhập lại mật khẩu mới</label>
                            <div class="form-control-wrap auth-password-field">
                                <i class="fa-solid fa-lock" aria-hidden="true"></i>
                                <input class="form-control" type="password" id="reset-confirm" name="confirmPassword"
                                       placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" minlength="8" required />
                                <button class="auth-password-toggle" type="button" data-password-toggle="reset-confirm" aria-controls="reset-confirm"
                                        aria-label="Hiển thị mật khẩu" aria-pressed="false">
                                    <i class="fa-regular fa-eye" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>

                        <button type="submit" class="button button--primary button--icon auth-submit">
                            <span class="button__icon" aria-hidden="true"><i class="fa-solid fa-arrow-right"></i></span>
                            <span>Lưu mật khẩu mới</span>
                        </button>
                    </form>

                    <p class="auth-register">Lưu xong bạn sẽ được chuyển tới trang đăng nhập.</p>
                </section>
            </div>
        </main>
    </div>

    <partial name="Partials/_AppFooter" />
    <partial name="Partials/_Notify" />
    <script src="~/js/_TogglePassword.js" asp-append-version="true" defer></script>
    <script src="~/js/_SubmitLoading.js" asp-append-version="true" defer></script>
</body>
</html>
