@{
    Layout = null;
    var email = ViewBag.Email as string ?? Context.Request.Query["email"].ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đặt lại mật khẩu - MockviewAI</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ResetPassword.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/themes/theme-indigo.css" media="(prefers-color-scheme: light)" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/themes/theme-dark-1.css" media="(prefers-color-scheme: dark)" asp-append-version="true" />
</head>
<body class="app-layout app-layout--auth">
    <div class="app-layout__content">
        <main class="auth-page reset-page">
            <div class="auth-shell reset-shell">
                <section class="auth-intro" aria-labelledby="reset-intro-heading">
                    <div class="auth-intro__top">
                        <a class="auth-brand" asp-controller="Home" asp-action="Index" aria-label="MockviewAI - Trang chủ">
                            <span class="auth-brand__mark" aria-hidden="true">
                                <img src="~/favicon.ico" asp-append-version="true" alt="" />
                            </span>
                            <span>Mockview<span>AI</span></span>
                        </a>
                        <span class="auth-intro__badge">2.0.0</span>
                    </div>
                    <div class="auth-intro__body">
                        <span class="auth-intro__eyebrow">
                            <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                            BẢO VỆ TÀI KHOẢN
                        </span>
                        <h1 id="reset-intro-heading">Chỉ còn một bước nữa.</h1>
                        <p>Tạo mật khẩu mới để bảo vệ tài khoản và trở lại hành trình luyện phỏng vấn cùng MockviewAI.</p>
                        <ol class="auth-steps reset-steps" aria-label="Tiến trình khôi phục tài khoản">
                            <li>
                                <span class="auth-steps__icon"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
                                <span><strong>Nhập email đã đăng ký</strong><small>Đã hoàn tất</small></span>
                            </li>
                            <li>
                                <span class="auth-steps__icon"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
                                <span><strong>Xác thực mã bảo mật</strong><small>Đã hoàn tất</small></span>
                            </li>
                            <li class="reset-steps__current" aria-current="step">
                                <span class="auth-steps__icon"><i class="fa-solid fa-lock" aria-hidden="true"></i></span>
                                <span><strong>Tạo mật khẩu mới</strong><small>Bước 3/3 · Đang thực hiện</small></span>
                            </li>
                        </ol>
                    </div>
                    <p class="auth-intro__bottom">An toàn hơn trong từng lần đăng nhập.</p>
                </section>
                <section class="auth-panel reset-panel" aria-labelledby="reset-heading">
                    <div class="auth-panel__mobile-brand">
                        <span class="auth-brand__mark" aria-hidden="true"><img src="~/favicon.ico" asp-append-version="true" alt="" /></span>
                        <strong>Mockview<span>AI</span></strong>
                    </div>
                    <div class="reset-panel__symbol" aria-hidden="true">
                        <i class="fa-solid fa-key"></i>
                    </div>
                    <div class="auth-panel__header">
                        <span class="auth-panel__eyebrow">BƯỚC 3 / 3 · HOÀN TẤT KHÔI PHỤC</span>
                        <h2 id="reset-heading">Tạo mật khẩu mới</h2>
                        <p>Đặt một mật khẩu dễ nhớ với bạn nhưng khó đoán với người khác.</p>
                    </div>
                    <div class="reset-requirements" role="note">
                        <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                        <span>Mật khẩu phải có ít nhất 8 ký tự, bao gồm chữ hoa, chữ thường và chữ số.</span>
                    </div>
                    <form class="auth-form" method="post"
                          asp-controller="Auth" asp-action="ResetPassword"
                          data-loading-text="Đang cập nhật..."
                          data-loading-overlay="Đang cập nhật mật khẩu của bạn. Vui lòng không gửi yêu cầu nhiều lần.">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="email" value="@email" />
                        <div class="form-field">
                            <label class="form-field__label" for="reset-pass">Mật khẩu mới</label>
                            <div class="form-control-wrap auth-password-field">
                                <i class="fa-solid fa-lock" aria-hidden="true"></i>
                                <input class="form-control" type="password" id="reset-pass" name="newPassword"
                                       placeholder="Nhập mật khẩu mới" autocomplete="new-password"
                                       minlength="8" required autofocus />
                                <button class="auth-password-toggle" type="button"
                                        data-password-toggle="reset-pass" aria-controls="reset-pass"
                                        aria-label="Hiển thị mật khẩu" aria-pressed="false">
                                    <i class="fa-regular fa-eye" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                        <div class="form-field">
                            <label class="form-field__label" for="reset-confirm">Xác nhận mật khẩu mới</label>
                            <div class="form-control-wrap auth-password-field">
                                <i class="fa-solid fa-lock" aria-hidden="true"></i>
                                <input class="form-control" type="password" id="reset-confirm" name="confirmPassword"
                                       placeholder="Nhập lại mật khẩu mới" autocomplete="new-password"
                                       minlength="8" required />
                                <button class="auth-password-toggle" type="button"
                                        data-password-toggle="reset-confirm" aria-controls="reset-confirm"
                                        aria-label="Hiển thị mật khẩu" aria-pressed="false">
                                    <i class="fa-regular fa-eye" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                        <button type="submit" class="button button--primary auth-submit">
                            <span>Đặt lại mật khẩu</span>
                            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                        </button>
                    </form>
                    <p class="auth-panel__note">
                        <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                        Bạn sẽ được chuyển đến đăng nhập sau khi cập nhật thành công.
                    </p>
                </section>
            </div>
        </main>
    </div>
    <partial name="Partials/_AppFooter" />
    <partial name="Partials/_Notify" />
    <script src="~/js/_TogglePassword.js" asp-append-version="true" defer></script>
    <script src="~/js/_SubmitLoading.js" asp-append-version="true" defer></script>
</body>
</html>
