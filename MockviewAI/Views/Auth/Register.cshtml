@inject IConfiguration Configuration
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tạo tài khoản - MockviewAI</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    
    <link rel="stylesheet" href="~/css/Login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Register.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/themes/theme-indigo.css" asp-append-version="true" />
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</head>

<body class="app-layout app-layout--auth">
    <div class="app-layout__content">
        <main class="auth-page register-page">
            <div class="auth-shell register-shell">
                <section class="auth-intro" aria-labelledby="register-intro-title">
                    <div class="auth-intro__top">
                        <a class="auth-brand" asp-controller="Home" asp-action="Index"
                           aria-label="MockviewAI - Trang chủ">
                            <span class="auth-brand__mark" aria-hidden="true">
                                <img src="~/favicon.ico" asp-append-version="true" alt="" />
                            </span>
                            <span>Mockview<span>AI</span></span>
                        </a>
                        <span class="auth-intro__badge">2.0.0</span>
                    </div>

                    <div class="auth-intro__body">
                        <span class="auth-intro__eyebrow">
                            <i class="fa-solid fa-sparkles" aria-hidden="true"></i>
                            BẮT ĐẦU HÀNH TRÌNH
                        </span>
                        <h1 id="register-intro-title">Bước đầu tiên để tự tin phỏng vấn.</h1>
                        <p>Tạo tài khoản MockviewAI và luyện tập trong môi trường phỏng vấn mô phỏng cùng AI.</p>
                        <ol class="auth-steps" aria-label="Ba bước luyện tập">
                            <li>
                                <span class="auth-steps__icon"><i class="fa-solid fa-briefcase" aria-hidden="true"></i></span>
                                <span><strong>Chọn vị trí ứng tuyển</strong><small>Luyện tập theo mục tiêu nghề nghiệp.</small></span>
                            </li>
                            <li>
                                <span class="auth-steps__icon"><i class="fa-solid fa-microphone" aria-hidden="true"></i></span>
                                <span><strong>Thực hành cùng AI</strong><small>Trả lời bằng giọng nói hoặc văn bản.</small></span>
                            </li>
                            <li>
                                <span class="auth-steps__icon"><i class="fa-solid fa-chart-line" aria-hidden="true"></i></span>
                                <span><strong>Nhận đánh giá</strong><small>Nhìn lại kết quả sau mỗi buổi luyện.</small></span>
                            </li>
                        </ol>
                    </div>
                    <p class="auth-intro__bottom">Luyện tập hôm nay, vững vàng ngày mai.</p>
                </section>

                <section class="auth-panel register-panel" aria-labelledby="register-title">
                    <div class="auth-panel__mobile-brand">
                        <span class="auth-brand__mark" aria-hidden="true">
                            <img src="~/favicon.ico" asp-append-version="true" alt="" />
                        </span>
                        <strong>Mockview<span>AI</span></strong>
                    </div>

                    <div class="auth-panel__header">
                        <span class="auth-panel__eyebrow">THAM GIA MOCKVIEWAI</span>
                        <h2 id="register-title">Tạo tài khoản</h2>
                        <p>Điền thông tin để bắt đầu hành trình luyện phỏng vấn.</p>
                    </div>

                    <form id="registerForm" class="auth-form" method="post"
                          asp-controller="Auth" asp-action="Register"
                          data-loading-text="Đang tạo tài khoản..."
                          data-loading-overlay="Đang gửi mã xác thực đến email của bạn. Quá trình này có thể mất vài giây.">
                        @Html.AntiForgeryToken()

                        <div class="register-form-grid">
                            <div class="form-field">
                                <label class="form-field__label" for="reg-first-name">Tên</label>
                                <div class="form-control-wrap">
                                    <i class="fa-regular fa-user" aria-hidden="true"></i>
                                    <input class="form-control" id="reg-first-name" name="firstName"
                                           type="text" placeholder="Nhập tên" autocomplete="given-name" required />
                                </div>
                            </div>
                            <div class="form-field">
                                <label class="form-field__label" for="reg-last-name">Họ</label>
                                <div class="form-control-wrap">
                                    <i class="fa-regular fa-user" aria-hidden="true"></i>
                                    <input class="form-control" id="reg-last-name" name="lastName"
                                           type="text" placeholder="Nhập họ" autocomplete="family-name" required />
                                </div>
                            </div>
                            <div class="form-field register-form-grid__full">
                                <label class="form-field__label" for="reg-email">Địa chỉ email</label>
                                <div class="form-control-wrap">
                                    <i class="fa-regular fa-envelope" aria-hidden="true"></i>
                                    <input class="form-control" id="reg-email" name="email"
                                           type="email" placeholder="you@email.com" autocomplete="email" required />
                                </div>
                            </div>
                            <div class="form-field">
                                <label class="form-field__label" for="reg-pass">Mật khẩu</label>
                                <div class="form-control-wrap auth-password-field">
                                    <i class="fa-solid fa-lock" aria-hidden="true"></i>
                                    <input class="form-control" id="reg-pass" name="password"
                                           type="password" placeholder="Tối thiểu 8 ký tự"
                                           autocomplete="new-password" required />
                                    <button class="auth-password-toggle" type="button"
                                            data-password-toggle="reg-pass" aria-controls="reg-pass"
                                            aria-label="Hiển thị mật khẩu" aria-pressed="false">
                                        <i class="fa-regular fa-eye" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="form-field">
                                <label class="form-field__label" for="reg-confirm-pass">Xác nhận mật khẩu</label>
                                <div class="form-control-wrap auth-password-field">
                                    <i class="fa-solid fa-lock" aria-hidden="true"></i>
                                    <input class="form-control" id="reg-confirm-pass" name="confirmPassword"
                                           type="password" placeholder="Nhập lại mật khẩu"
                                           autocomplete="new-password" required />
                                    <button class="auth-password-toggle" type="button"
                                            data-password-toggle="reg-confirm-pass"
                                            aria-controls="reg-confirm-pass"
                                            aria-label="Hiển thị mật khẩu" aria-pressed="false">
                                        <i class="fa-regular fa-eye" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="register-consent">
                            <input class="register-consent__checkbox" id="terms" type="checkbox"
                                   name="terms" value="true" required />
                            <div class="register-consent__text">
                                <label for="terms">Tôi đồng ý với</label>
                                @* Replace these two URLs with your project's real policy routes. *@
                                <a href="/Terms" target="_blank" rel="noopener noreferrer">Điều khoản dịch vụ</a>
                                <span>và</span>
                                <a href="/Privacy" target="_blank" rel="noopener noreferrer">Chính sách bảo mật</a>
                            </div>
                        </div>

                        <div class="auth-turnstile">
                            <div class="cf-turnstile" data-theme="light" data-size="flexible"
                                 data-sitekey="@Configuration["Turnstile:SiteKey"]"></div>
                        </div>

                        <button class="button button--primary auth-submit" type="submit">
                            <span>Tạo tài khoản</span>
                            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                        </button>
                    </form>

                    <p class="auth-register">
                        Đã có tài khoản?
                        <a class="text-link" asp-controller="Auth" asp-action="Login">Đăng nhập</a>
                    </p>
                    <p class="auth-panel__note">
                        <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                        Xác thực an toàn để bảo vệ tài khoản của bạn.
                    </p>
                </section>
            </div>
        </main>
    </div>

    <partial name="Partials/_AppFooter" />
    <partial name="Partials/_Notify" />

    <script src="~/js/_TogglePassword.js" asp-append-version="true" defer></script>
    <script src="~/js/_SubmitLoading.js" asp-append-version="true" defer></script>
</body>
</html>
