@inject IConfiguration Configuration
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tạo tài khoản - MockviewAI</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Register.css" asp-append-version="true" />
    <partial name="Partials/_ThemeHead" />
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</head>
<body class="app-layout app-layout--auth">
    <div class="app-layout__content">
        <main class="auth-page register-page">
            <div class="auth-shell">
                <partial name="_AuthIntro" model="@("Tạo tài khoản và luyện tập phỏng vấn ngay hôm nay.")" />

                <section class="auth-panel" aria-labelledby="register-title">
                    <div class="auth-panel__header">
                        <h1 id="register-title">Tạo tài khoản</h1>
                        <p>Miễn phí, chỉ mất khoảng 1 phút.</p>
                    </div>

                    @* Google tự tạo tài khoản nếu email chưa có (AuthController.GoogleResponse) *@
                    <a class="auth-google" asp-controller="Auth" asp-action="LoginGoogle">
                        <svg class="auth-google__logo" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3 0 5.8 1.1 7.9 3l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3 0 5.8 1.1 7.9 3l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
                        <span>Đăng ký với Google</span>
                    </a>

                    <div class="auth-divider" aria-hidden="true"><span>hoặc dùng email</span></div>

                    <form id="registerForm" class="auth-form" method="post" asp-controller="Auth" asp-action="Register"
                          data-loading-text="Đang tạo tài khoản..."
                          data-loading-overlay="Đang gửi mã xác thực đến email của bạn. Quá trình này có thể mất vài giây.">
                        @Html.AntiForgeryToken()

                        <div class="register-form-grid">
                            <div class="form-field">
                                <label class="form-field__label" for="reg-last-name">Họ</label>
                                <div class="form-control-wrap">
                                    <i class="fa-regular fa-user" aria-hidden="true"></i>
                                    <input class="form-control" id="reg-last-name" name="lastName" type="text" placeholder="Nhập họ" autocomplete="family-name" required />
                                </div>
                            </div>
                            <div class="form-field">
                                <label class="form-field__label" for="reg-first-name">Tên</label>
                                <div class="form-control-wrap">
                                    <i class="fa-regular fa-user" aria-hidden="true"></i>
                                    <input class="form-control" id="reg-first-name" name="firstName" type="text" placeholder="Nhập tên" autocomplete="given-name" required />
                                </div>
                            </div>
                            <div class="form-field register-form-grid__full">
                                <label class="form-field__label" for="reg-email">Email</label>
                                <div class="form-control-wrap">
                                    <i class="fa-regular fa-envelope" aria-hidden="true"></i>
                                    <input class="form-control" id="reg-email" name="email" type="email" placeholder="you@email.com" autocomplete="email" required />
                                </div>
                            </div>
                            <div class="form-field">
                            <label class="form-field__label" for="reg-pass">Mật khẩu</label>
                            <div class="form-control-wrap auth-password-field">
                                <i class="fa-solid fa-lock" aria-hidden="true"></i>
                                <input class="form-control" id="reg-pass" name="password" type="password" placeholder="Tối thiểu 8 ký tự" autocomplete="new-password" required />
                                <button class="auth-password-toggle" type="button" data-password-toggle="reg-pass" aria-controls="reg-pass" aria-label="Hiển thị mật khẩu" aria-pressed="false">
                                    <i class="fa-regular fa-eye" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                            <div class="form-field">
                            <label class="form-field__label" for="reg-confirm-pass">Nhập lại mật khẩu</label>
                            <div class="form-control-wrap auth-password-field">
                                <i class="fa-solid fa-lock" aria-hidden="true"></i>
                                <input class="form-control" id="reg-confirm-pass" name="confirmPassword" type="password" placeholder="Nhập lại mật khẩu" autocomplete="new-password" required />
                                <button class="auth-password-toggle" type="button" data-password-toggle="reg-confirm-pass" aria-controls="reg-confirm-pass" aria-label="Hiển thị mật khẩu" aria-pressed="false">
                                    <i class="fa-regular fa-eye" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                        </div>

                        <div class="register-terms">
                            <input class="register-terms__checkbox" id="terms" type="checkbox" name="terms" value="true" required />
                            <label class="register-terms__text" for="terms">
                                Tôi đồng ý với
                                <a asp-controller="Home" asp-action="Terms" target="_blank" rel="noopener noreferrer">Điều khoản sử dụng</a>
                                và
                                <a asp-controller="Home" asp-action="Privacy" target="_blank" rel="noopener noreferrer">Chính sách quyền riêng tư</a>
                            </label>
                        </div>

                        <div class="auth-turnstile">
                            <div class="cf-turnstile" data-theme="light" data-size="flexible" data-sitekey="@Configuration["Turnstile:SiteKey"]"></div>
                        </div>

                        <button class="button button--primary button--icon auth-submit" type="submit">
                            <span class="button__icon" aria-hidden="true"><i class="fa-solid fa-arrow-right"></i></span>
                            <span>Tạo tài khoản</span>
                        </button>
                    </form>

                    <p class="auth-register">Đã có tài khoản? <a class="text-link" asp-controller="Auth" asp-action="Login">Đăng nhập</a></p>
                </section>
            </div>
        </main>
    </div>

    <partial name="Partials/_AppFooter" />
    <partial name="Partials/_Notify" />

    <script src="~/js/_TogglePassword.js" asp-append-version="true" defer></script>
    <script src="~/js/_SubmitLoading.js" asp-append-version="true" defer></script>
</body>
</html>
