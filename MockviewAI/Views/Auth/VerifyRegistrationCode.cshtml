@{
    Layout = null;
    var email = ViewBag.Email ?? Context.Request.Query["email"].ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Registration Code - MockviewAI</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/css/ForgotPassword.css">
</head>

<body>
    <div class="forgot-wrapper">
        <div class="forgot-container">

            <div class="info-panel">
                <div class="logo">Mockview<span>AI</span></div>
                <h1>Verify your email address</h1>
                <p class="subtitle">Just one more step! We need to verify your email to secure your new account.</p>
                <ul class="features">
                    <li><span class="step">1</span> Fill in your details</li>
                    <li><span class="step active">2</span> Verify email</li>
                    <li><span class="step">3</span> Start practicing</li>
                </ul>
            </div>

            <div class="form-panel">       
                <div class="mobile-header hide-on-desktop">
                    <div class="logo-dark">Mockview<span>AI</span></div>
                </div>

                <div class="form-header">
                    <h2>Check your email</h2>
                </div>

                <p class="description">
                    We've sent a 6-digit verification code to <strong>@email</strong>. 
                    The code expires in 5 minutes.
                </p>

                <form method="post" asp-controller="Auth" asp-action="VerifyRegistrationCode" id="verifyForm">
                    @Html.AntiForgeryToken()     

                    <input type="hidden" name="email" value="@email" />
                    <input type="hidden" name="code" id="finalCode" />

                    <div class="form-group">
                        <label>Verification Code</label>
                        <div class="otp-wrapper">
                            <input type="text" class="otp-input" maxlength="1" autocomplete="off" required autofocus>
                            <input type="text" class="otp-input" maxlength="1" autocomplete="off" required>
                            <input type="text" class="otp-input" maxlength="1" autocomplete="off" required>
                            <input type="text" class="otp-input" maxlength="1" autocomplete="off" required>
                            <input type="text" class="otp-input" maxlength="1" autocomplete="off" required>
                            <input type="text" class="otp-input" maxlength="1" autocomplete="off" required>
                        </div>

                    </div>
                    <button type="submit" class="btn-submit">Verify Account</button>

                    <div class="back-link">
                        <a href="/Auth/Register">Wrong email? Go back to register</a>
                    </div>
                </form>

            </div>
        </div>
    </div>
    <partial name="Partials/_Notify"/>
    <script src="~/js/VerifyCode.js"></script>
</body>
</html>