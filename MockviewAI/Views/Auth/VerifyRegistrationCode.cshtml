@{
    Layout = null;
    var email = ViewBag.Email as string ?? Context.Request.Query["email"].ToString();
    ViewData["AuthFlow"] = "register";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Xác thực email - MockviewAI</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/VerifyCode.css" asp-append-version="true" />
    <partial name="Partials/_ThemeHead" />
</head>
<body class="app-layout app-layout--auth">
    <div class="app-layout__content">
        <main class="auth-page">
            <div class="auth-shell">
                <partial name="_AuthSteps" model="2" />

                <section class="auth-panel" aria-labelledby="otp-heading">
                    <div class="auth-panel__header">
                        <h1 id="otp-heading">Xác thực email</h1>
                        <p>Mã 6 số đã được gửi tới</p>
                    </div>
                    <span class="otp-email"><i class="fa-regular fa-envelope" aria-hidden="true"></i> @email</span>

                    <form id="verifyForm" class="auth-form otp-form" method="post"
                          asp-controller="Auth" asp-action="VerifyRegistrationCode"
                          data-loading-text="Đang xác thực..."
                          data-loading-overlay="Hệ thống đang kiểm tra mã và kích hoạt tài khoản của bạn.">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="email" value="@email" />
                        <input type="hidden" name="code" id="finalCode" />

                        @* VerifyCode.js: tự nhảy ô, dán cả mã, ghép 6 ô vào #finalCode *@
                        <fieldset class="otp-fieldset">
                            <legend class="visually-hidden">Mã xác thực gồm 6 chữ số</legend>
                            <div class="otp-control" role="group" aria-label="Mã xác thực gồm 6 chữ số">
                                @for (int i = 0; i < 6; i++)
                                {
                                    @* placeholder=" " để CSS biết ô đã điền (:placeholder-shown) *@
                                    <input class="otp-control__digit otp-input" type="text" placeholder=" "
                                           inputmode="numeric" pattern="[0-9]*" maxlength="6"
                                           autocomplete="@(i == 0 ? "one-time-code" : "off")"
                                           aria-label="Chữ số @(i + 1)" required />
                                }
                            </div>
                            <p class="otp-control__message" id="otp-message" role="status" aria-live="polite"></p>
                            <p class="otp-hint"><span>Mã hết hạn sau 5 phút.</span><span>Dán được cả mã</span></p>
                        </fieldset>

                        <button class="button button--primary button--icon auth-submit" type="submit">
                            <span class="button__icon" aria-hidden="true"><i class="fa-solid fa-arrow-right"></i></span>
                            <span>Xác thực tài khoản</span>
                        </button>
                    </form>

                    <p class="otp-help">Không thấy thư? Xem thêm thư mục Spam hoặc Quảng cáo.</p>
                    <a class="auth-back" asp-controller="Auth" asp-action="Register">
                        <i class="fa-solid fa-chevron-left" aria-hidden="true"></i> Nhầm email? Quay lại đăng ký
                    </a>
                </section>
            </div>
        </main>
    </div>

    <partial name="Partials/_AppFooter" />
    <partial name="Partials/_Notify" />
    <script src="~/js/VerifyCode.js" asp-append-version="true" defer></script>
    <script src="~/js/_SubmitLoading.js" asp-append-version="true" defer></script>
</body>
</html>
