@*
    #region _ThemeHead
    <summary>
    [THEME] Nạp theme sáng / tối và áp dụng NGAY theme người dùng đã chọn (lưu trong localStorage)
    trước khi trang được vẽ, nhờ vậy trang không bị nháy màu khi tải.
    - Mặc định là giao diện SÁNG; không còn tự đổi theo chế độ sáng / tối của hệ điều hành.
    - Đặt partial này ở CUỐI thẻ <head>, sau CSS riêng của trang, để theme ghi đè được màu.
    - Script bên dưới cung cấp window.MockviewTheme cho nút chuyển theme (~/js/_ThemeToggle.js).
    - Không dùng ký tự a-còng trong script vì Razor sẽ hiểu nhầm là mã C#.
    </summary>
    #endregion
*@
<link id="theme-light" rel="stylesheet" href="~/css/themes/theme-indigo.css" asp-append-version="true" />
<link id="theme-dark" rel="stylesheet" href="~/css/themes/theme-dark-1.css" media="not all" asp-append-version="true" />
<script>
    (function (window, document) {
        'use strict';

        var STORAGE_KEY = 'mockview-theme';
        var THEMES = { light: 'light', dark: 'dark' };
        var META_COLORS = { light: '#f5f7fb', dark: '#0c1220' };

        /// <summary>Chỉ chấp nhận 'dark'; mọi giá trị khác (rỗng, sai) đều là 'light'.</summary>
        function normalize(value) {
            return value === THEMES.dark ? THEMES.dark : THEMES.light;
        }

        /// <summary>Đọc theme đã lưu. Trình duyệt chặn localStorage (ẩn danh, chính sách) thì dùng mặc định.</summary>
        function read() {
            try {
                return normalize(window.localStorage.getItem(STORAGE_KEY));
            } catch (e) {
                return THEMES.light;
            }
        }

        /// <summary>Lưu theme. Lưu không được thì vẫn đổi giao diện cho trang hiện tại.</summary>
        function save(theme) {
            try {
                window.localStorage.setItem(STORAGE_KEY, normalize(theme));
            } catch (e) {
                /* bỏ qua: chỉ mất phần ghi nhớ, không ảnh hưởng giao diện */
            }
        }

        /// <summary>Theme đang hiển thị trên trang (đọc từ thẻ html, không phụ thuộc localStorage).</summary>
        function current() {
            return normalize(document.documentElement.getAttribute('data-theme'));
        }

        /// <summary>Bật file CSS của theme được chọn, tắt file còn lại và đồng bộ màu thanh trình duyệt.</summary>
        function apply(theme) {
            var selected = normalize(theme);
            var isDark = selected === THEMES.dark;
            var lightSheet = document.getElementById('theme-light');
            var darkSheet = document.getElementById('theme-dark');

            if (lightSheet) lightSheet.media = isDark ? 'not all' : 'all';
            if (darkSheet) darkSheet.media = isDark ? 'all' : 'not all';

            document.documentElement.setAttribute('data-theme', selected);
            document.documentElement.style.colorScheme = selected;

            var meta = document.querySelector('meta[name="theme-color"]');
            if (meta) meta.setAttribute('content', META_COLORS[selected]);

            return selected;
        }

        window.MockviewTheme = {
            storageKey: STORAGE_KEY,
            themes: THEMES,
            normalize: normalize,
            read: read,
            save: save,
            current: current,
            apply: apply
        };

        apply(read());
    })(window, document);
</script>
