<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/js/_Notify.js" asp-append-version="true"></script>

<script>
    window.SystemAlerts = {
        success: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["SuccessMessage"])),
        error: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ErrorMessage"])),
        info: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["InfoMessage"]))
    };
</script>