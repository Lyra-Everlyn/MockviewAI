@{
    var pageTitle = ViewData["Title"]?.ToString();
    var title = string.IsNullOrWhiteSpace(pageTitle)
        ? "MockviewAI"
        : $"{pageTitle} - MockviewAI";

    // Sử dụng trên các trang đăng nhập / trang đặc biệt khi cần.
    var hideNavigation = ViewData["HideNavigation"] is true;
    var hideFooter = ViewData["HideFooter"] is true;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    <meta name="theme-color" content="#f5f7fb" />

    <!-- Tài nguyên chung, nạp đúng một lần cho toàn bộ ứng dụng. -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />

    <!-- CSS riêng cho từng trang được khai báo trong section Styles. -->
    @await RenderSectionAsync("Styles", required: false)

    <!-- Theme đặt sau component/page styles để có thể thay đổi màu tập trung. -->
    <link rel="stylesheet" href="~/css/themes/theme-indigo.css" asp-append-version="true" />
</head>
<body class="app-layout">
    @if (!hideNavigation)
    {
        <partial name="Partials/_AppNavigation" />
    }

    <div class="app-layout__content">
        @RenderBody()
    </div>

    @if (!hideFooter)
    {
        <partial name="Partials/_AppFooter" />
    }

    @* Optional: khi tất cả trang đã dùng layout, có thể chuyển _Notify về đây.
       Hiện chưa chuyển để tránh render hai lần trong giai đoạn migrate. *@

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>