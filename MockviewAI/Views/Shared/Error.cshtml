@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container text-center" style="margin-top: 100px; font-family: Inter, Arial, sans-serif;">
    <h1 class="text-danger" style="font-size: 3rem; font-weight: bold;">Oops! 500</h1>
    <h2 class="text-secondary mt-3">An unexpected error occurred.</h2>
    <p class="mt-4" style="font-size: 1.1rem; color: #555;">
        We are working on fixing the issue. Please try again later or return to the homepage.
    </p>

    <div class="mt-4">
        <a href="/" class="btn btn-primary px-4 py-2" style="background-color: #3348E0; border: none; border-radius: 8px;">
            Return to Homepage
        </a>
    </div>


    @if (Model != null && Model.ShowRequestId)
    {
        <p class="text-muted mt-5" style="font-size: 0.9rem;">
            <em>Error Tracking Code (Request ID): <code>@Model.RequestId</code></em>
        </p>
    }
</div>