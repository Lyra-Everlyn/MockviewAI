@model MockviewAI.Models.ViewModels.SessionResultViewModel
@{
    Layout = null;
    // Chữ cái đầu của tên người đang đăng nhập (avatar góc phải)
    var userName = User.Identity?.Name ?? "";
    var initial = string.IsNullOrWhiteSpace(userName) ? "?" : userName.Substring(0, 1).ToUpper();
    // Ảnh Google của tài khoản (nếu có), không có thì hiện chữ cái đầu
    var avatarUrl = User.FindFirst("AvatarUrl")?.Value;
    // Dấu hiệu lo lắng do hệ thống ước tính (0 = chưa đủ dữ liệu: buổi dừng sớm hoặc dữ liệu cũ)
    var hasAnxiety = Model.AnxietyIndicator > 0;
    var anxietyChange = Model.PreviousAnxietyIndicator > 0 ? Model.AnxietyIndicator - Model.PreviousAnxietyIndicator : 0;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kết quả buổi luyện - MockviewAI</title>
    <!-- Font Inter chuẩn thiết kế -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome Icon -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/Result.css">
    <link rel="stylesheet" href="~/css/theme.css"> <!-- thử giao diện mới (theme.css) -->
</head>
<body>

    <!-- Header Desktop -->
    <header class="desktop-header">
        <div class="header-content">
            <div class="logo-nav">
                <div class="logo">Mockview<span>AI</span></div>
                <nav class="nav-links">
                    <a href="/Home">Trang chủ</a>
                    <a href="/Interview/Create" class="active">Luyện tập</a>
                    <a href="/Home/History">Lịch sử</a>
                </nav>
            </div>
            <div class="header-actions">
                <span class="badge-beta">Bản thử V1</span>
                <div class="profile-icon" style="cursor: pointer;" title="Hồ sơ" onclick="location.href='/Profile'">@if (!string.IsNullOrEmpty(avatarUrl)) { <img src="@avatarUrl" alt="" referrerpolicy="no-referrer" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;" /> } else { @initial }</div>
            </div>
        </div>
    </header>

    <main class="main-container">
        <!-- Phần tiêu đề trang -->
        <div class="page-title-section">
            <h1>Kết quả buổi luyện</h1>
            <p class="subtitle">
                @Model.Position &middot; @Model.StartedAt.ToString("dd/MM") &middot; @Model.QuestionCount câu
                <span class="desktop-only">&middot; Người phỏng vấn: @Model.InterviewerName</span>
            </p>
        </div>

        <!-- Bố cục Grid chính (Desktop 2 cột / Mobile 1 cột) -->
        <div class="result-grid">
            
            <!-- Cột trái: Thẻ điểm tổng & Thanh tiến trình -->
            <div class="card score-card">
                <div class="card-header">
                    <span class="card-title">Điểm tổng</span>
                    <span class="badge-reference">Điểm tham khảo</span>
                </div>

                <!-- Hiển thị con số điểm -->
                <div class="score-display">
                    <span class="score-number">@(Model.HasScore ? Model.TotalScore.ToString() : "—")</span>
                    <span class="score-total">/100</span>
                </div>

                @if (!Model.HasScore)
                {
                    @* [#21] Buổi dừng trước khi trả lời câu nào: không có điểm, không hiện thanh 0 *@
                    <p class="score-footer">Buổi này dừng trước khi bạn trả lời câu nào nên chưa có điểm. Hãy luyện lại để nhận nhận xét của AI.</p>
                }
                else
                {
                @* Thanh tiến trình 1: Nội dung *@
                <div class="metric-item">
                    <div class="metric-info">
                        <span class="metric-label desktop-only">Nội dung câu trả lời</span>
                        <span class="metric-label mobile-only">Nội dung</span>
                        <span class="metric-value">@(Model.HasContentScore ? Model.ContentScore.ToString() : "—")</span>
                    </div>
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: @(Model.HasContentScore ? Model.ContentScore : 0)%;"></div>
                    </div>
                </div>

                @* Thanh tiến trình 2: Cách nói *@
                <div class="metric-item">
                    <div class="metric-info">
                        <span class="metric-label">Cách nói</span>
                        <span class="metric-value">@Model.DeliveryScore</span>
                    </div>
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: @(Model.DeliveryScore)%;"></div>
                    </div>
                </div>

                }

                @if (Model.HasScore && !Model.HasContentScore)
                {
                    <p class="score-footer">AI đang bận nên chưa nhận xét được nội dung. Điểm tổng lúc này chỉ tính phần cách nói.</p>
                }

                <!-- Chú thích cách tính điểm -->
                <div class="score-footer">
                    Điểm tổng = 60% nội dung + 40% cách nói. <a href="#" title="Chưa có trang giải thích cách tính điểm">Cách tính điểm?</a>
                </div>
            </div>

            <!-- Cột phải: Mức lo lắng & Các nút hành động -->
            <div class="actions-column">
                
                <!-- Khối màu xanh lá: Đánh giá mức lo lắng -->
                <div class="anxiety-card">
                    <div class="anxiety-title">Dấu hiệu lo lắng (hệ thống ước tính, 1–10)</div>
                    <div class="anxiety-body">
                        @if (hasAnxiety)
                        {
                            <div class="anxiety-values">
                                <strong>@Model.AnxietyIndicator</strong>/10 &middot; @Model.AnxietyLevelText
                            </div>
                            if (Model.PreviousAnxietyIndicator > 0)
                            {
                                <span class="badge-reduced">@(anxietyChange < 0 ? $"Giảm {-anxietyChange} so với buổi trước" : anxietyChange > 0 ? $"Tăng {anxietyChange} so với buổi trước" : "Không đổi so với buổi trước")</span>
                            }
                            <div class="anxiety-note">Ước tính tự động từ cách nói của bạn (từ đệm, khoảng lặng, tốc độ). Không phải đánh giá y tế.</div>
                        }
                        else
                        {
                            <div class="anxiety-values" style="font-size: 15px;">Chưa đủ dữ liệu để ước tính. Hãy trả lời ít nhất 1 câu.</div>
                        }
                    </div>
                </div>

                @if (Model.EmailRequested)
                {
                    <div class="email-note">Kết quả này cũng được gửi về email tài khoản của bạn.</div>
                }

                <!-- Cụm nút hành động -->
                <div class="btn-group">
                    <a href="/Home/InterviewDetail/@Model.SessionId" class="btn btn-primary">Xem lại hội thoại buổi này</a>
                    <a href="/Feedback" class="btn btn-feedback">Góp ý cho BETA</a>
                    <a href="/Home" class="btn btn-outline">Về trang chủ</a>
                </div>

            </div>

        </div>

        @if (Model.HasScore)
        {
            <!-- Nhận xét chi tiết: AI nhận xét nội dung + gợi ý cách nói -->
            <section class="feedback-card">
                <h2>Nhận xét chi tiết</h2>
                @if (!string.IsNullOrWhiteSpace(Model.AiSummary))
                {
                    <p class="feedback-summary">@Model.AiSummary</p>
                }
                @if (Model.Strengths.Count > 0)
                {
                    <h3>Điểm mạnh</h3>
                    <ul>@foreach (var item in Model.Strengths) { <li>@item</li> }</ul>
                }
                @if (Model.Improvements.Count > 0)
                {
                    <h3>Nên cải thiện</h3>
                    <ul>@foreach (var item in Model.Improvements) { <li>@item</li> }</ul>
                }
                @if (Model.DeliveryTips.Count > 0)
                {
                    <h3>Gợi ý về cách nói</h3>
                    <ul>@foreach (var item in Model.DeliveryTips) { <li>@item</li> }</ul>
                }
            </section>
        }
    </main>

</body>
</html>
