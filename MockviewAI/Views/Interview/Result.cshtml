@model MockviewAI.Models.ViewModels.SessionResultViewModel
@using MockviewAI.Models.Ai
@{
    Layout = null;
    ViewData["Title"] = "Kết quả phỏng vấn";
    ViewData["ActiveNav"] = "practice";

    var hasAnxiety = Model.AnxietyIndicator > 0;
    var anxietyChange = Model.PreviousAnxietyIndicator > 0
        ? Model.AnxietyIndicator - Model.PreviousAnxietyIndicator
        : 0;
    var anxietyLevelClass = Model.AnxietyIndicator <= 3 ? "is-low"
        : Model.AnxietyIndicator <= 6 ? "is-medium" : "is-high";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Kết quả phỏng vấn - MockviewAI</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Interview-Result.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/themes/theme-indigo.css" asp-append-version="true" />
</head>
<body class="app-layout interview-result-body">
    <partial name="Partials/_AppNavigation" />
    <div class="app-layout__content">
        <main class="page-shell interview-result-page">
            <header class="page-header interview-result-header">
                <div class="page-header__content">
                    <span class="page-header__eyebrow">TỔNG KẾT BUỔI PHỎNG VẤN</span>
                    <h1 class="page-header__title">Kết quả phỏng vấn</h1>
                    <p class="page-header__description">
                        Xem điểm tham khảo, cách tiếp cận từng câu và gợi ý cải thiện cho lần phỏng vấn tiếp theo.
                    </p>
                    <div class="interview-result-meta">
                        <span><i class="fa-solid fa-briefcase" aria-hidden="true"></i> @Model.Position</span>
                        <span><i class="fa-regular fa-calendar" aria-hidden="true"></i> @Model.StartedAt.ToString("dd/MM")</span>
                        <span><i class="fa-regular fa-comments" aria-hidden="true"></i> @Model.QuestionCount câu hỏi</span>
                        <span><i class="fa-regular fa-user" aria-hidden="true"></i> @Model.InterviewerName</span>
                        @if (Model.IsLive)
                        {
                            <span class="interview-result-meta__live"><i class="fa-solid fa-stopwatch" aria-hidden="true"></i> Thực chiến</span>
                        }
                    </div>
                </div>
                <div class="interview-result-header__actions">
                    <a class="button button--primary" href="/Home/InterviewDetail/@Model.SessionId">
                        <i class="fa-regular fa-message" aria-hidden="true"></i> Xem lại hội thoại
                    </a>
                    <a class="button button--secondary" href="/Interview/Create">
                        <i class="fa-solid fa-chevron-right" aria-hidden="true"></i> Phỏng vấn mới
                    </a>
                </div>
            </header>

            @if (Model.HasCategories)
            {
                <section class="interview-result-card interview-result-record" aria-labelledby="answer-path-title">
                    <div class="interview-result-card__heading">
                        <span class="interview-result-card__icon"><i class="fa-solid fa-list-check" aria-hidden="true"></i></span>
                        <div>
                            <span class="interview-result-eyebrow">PHÂN TÍCH TỪNG CÂU</span>
                            <h2 id="answer-path-title">Cách bạn tiếp cận từng câu</h2>
                        </div>
                    </div>
                    <p class="interview-result-record__description">
                        Đây là phân loại cách trả lời, không phải thang điểm. “Hơi đặc biệt” và “Đặc biệt” vẫn là câu trả lời đúng theo một cách tiếp cận khác.
                    </p>
                    @if (Model.FollowUpCount > 0)
                    {
                        <p class="interview-result-notice interview-result-notice--info">
                            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                            Người phỏng vấn đã hỏi thêm @Model.FollowUpCount lần để làm rõ ý còn thiếu. Câu trả lời bổ sung được tính vào câu chính.
                        </p>
                    }
                    <div class="interview-result-tape" aria-label="Phân loại các câu trả lời">
                        @for (int i = 0; i < Model.AnswerCategories.Count; i++)
                        {
                            var category = Model.AnswerCategories[i];
                            var valid = AnswerCategory.IsValid(category);
                            var categoryName = valid ? AnswerCategory.DisplayName(category) : "Chưa xếp loại / bỏ qua";
                            <a href="/Home/InterviewDetail/@Model.SessionId#cau-@(i + 1)"
                               class="interview-result-tape__item @(valid ? "is-" + category : "is-none")"
                               title="Câu @(i + 1): @categoryName"
                               aria-label="Câu @(i + 1): @categoryName">
                                <strong>@(valid ? AnswerCategory.Icon(category) : "–")</strong>
                                <small>Câu @(i + 1)</small>
                            </a>
                        }
                    </div>
                    <div class="interview-result-legend" aria-label="Tổng hợp phân loại">
                        <span><i class="interview-result-dot is-dung" aria-hidden="true"></i> @Model.CorrectCount Đúng</span>
                        <span><i class="interview-result-dot is-hoi_dac_biet" aria-hidden="true"></i> @Model.AlternativePathCount Hơi đặc biệt</span>
                        <span><i class="interview-result-dot is-dac_biet" aria-hidden="true"></i> @Model.SpecialCount Đặc biệt</span>
                        <span><i class="interview-result-dot is-sai" aria-hidden="true"></i> @Model.WrongCount Sai</span>
                    </div>
                    @if (Model.IsPreliminaryScore)
                    {
                        <p class="interview-result-notice interview-result-notice--warning">
                            <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                            AI đang bận nên nội dung được chấm sơ bộ theo bộ đề, chưa nhận diện đầy đủ các câu trả lời theo hướng “Đặc biệt”.
                        </p>
                    }
                </section>
            }

            <div class="interview-result-grid">
                <div class="interview-result-primary-column">
                    <section class="interview-result-card interview-result-score" aria-labelledby="result-score-title">
                        <div class="interview-result-card__heading">
                            <span class="interview-result-card__icon"><i class="fa-solid fa-chart-column" aria-hidden="true"></i></span>
                            <div>
                                <span class="interview-result-eyebrow">HIỆU SUẤT PHỎNG VẤN</span>
                                <h2 id="result-score-title">Điểm đánh giá</h2>
                            </div>
                            <span class="interview-result-chip interview-result-chip--reference">Tham khảo</span>
                        </div>
                        <div class="interview-result-score__total">
                            <strong>@(Model.HasScore ? Model.TotalScore.ToString() : "—")</strong>
                            <span>/ 100 điểm</span>
                        </div>
                        @if (!Model.HasScore)
                        {
                            <p class="interview-result-notice interview-result-notice--info">
                                Buổi phỏng vấn kết thúc trước khi có câu trả lời, nên chưa đủ dữ liệu để tính điểm.
                            </p>
                        }
                        else
                        {
                            <div class="interview-result-metrics">
                                <div class="interview-result-metric">
                                    <div class="interview-result-metric__heading">
                                        <span>Nội dung câu trả lời</span>
                                        <strong>@(Model.HasContentScore ? Model.ContentScore.ToString() : "—")</strong>
                                    </div>
                                    <progress max="100" value="@(Model.HasContentScore ? Model.ContentScore : 0)" aria-label="Điểm nội dung"></progress>
                                </div>
                                <div class="interview-result-metric">
                                    <div class="interview-result-metric__heading">
                                        <span>Cách nói và diễn đạt</span>
                                        <strong>@Model.DeliveryScore</strong>
                                    </div>
                                    <progress max="100" value="@Model.DeliveryScore" aria-label="Điểm cách nói"></progress>
                                </div>
                            </div>
                            @if (Model.HasVoice)
                            {
                                <div class="interview-result-voice">
                                    <h3><i class="fa-solid fa-wave-square" aria-hidden="true"></i> Phân tích giọng nói</h3>
                                    <dl>
                                        <div><dt>Âm lượng</dt><dd>@Model.VoiceLevelLabel</dd></div>
                                        <div><dt>Thời gian nói nhỏ</dt><dd>@Model.QuietPercent%</dd></div>
                                        <div><dt>Ngữ điệu</dt><dd>@Model.ToneLabel</dd></div>
                                    </dl>
                                </div>
                            }
                        }
                        @if (Model.InvalidAnswerCount > 0)
                        {
                            <p class="interview-result-notice interview-result-notice--error">
                                @Model.InvalidAnswerCount câu trả lời chưa đủ ý nghĩa được tính 0 điểm. Xem chi tiết ở “Xem lại hội thoại”.
                            </p>
                        }
                        @if (Model.IsPreliminaryScore && !Model.HasCategories)
                        {
                            <p class="interview-result-notice interview-result-notice--warning">AI đang bận, nội dung được chấm sơ bộ theo bộ đề.</p>
                        }
                        @if (Model.HasScore && !Model.HasContentScore)
                        {
                            <p class="interview-result-notice interview-result-notice--warning">AI chưa đánh giá được nội dung; điểm tổng hiện chỉ tính phần cách nói.</p>
                        }
                        <p class="interview-result-score__foot">Cách tính thông thường: 60% nội dung + 40% cách nói.</p>
                    </section>

                    <section class="interview-result-card interview-result-feedback" aria-labelledby="result-feedback-title">
                        <div class="interview-result-card__heading">
                            <span class="interview-result-card__icon"><i class="fa-regular fa-lightbulb" aria-hidden="true"></i></span>
                            <div>
                                <span class="interview-result-eyebrow">GỢI Ý CẢI THIỆN</span>
                                <h2 id="result-feedback-title">Nhận xét chi tiết</h2>
                            </div>
                        </div>
                        @if (!Model.HasScore)
                        {
                            <p class="interview-result-feedback__empty">Chưa có nhận xét cho buổi phỏng vấn này.</p>
                        }
                        else
                        {
                            @if (!string.IsNullOrWhiteSpace(Model.AiSummary))
                            {
                                <p class="interview-result-feedback__summary">@Model.AiSummary</p>
                            }
                            @if (Model.Strengths.Count > 0)
                            {
                                <div class="interview-result-feedback__group">
                                    <h3><i class="fa-regular fa-circle-check" aria-hidden="true"></i> Điểm mạnh</h3>
                                    <ul>@foreach (var item in Model.Strengths) { <li>@item</li> }</ul>
                                </div>
                            }
                            @if (Model.Improvements.Count > 0)
                            {
                                <div class="interview-result-feedback__group interview-result-feedback__group--improve">
                                    <h3><i class="fa-solid fa-arrow-trend-up" aria-hidden="true"></i> Nên cải thiện</h3>
                                    <ul>@foreach (var item in Model.Improvements) { <li>@item</li> }</ul>
                                </div>
                            }
                            @if (Model.DeliveryTips.Count > 0)
                            {
                                <div class="interview-result-feedback__group">
                                    <h3><i class="fa-regular fa-comment-dots" aria-hidden="true"></i> Cách nói</h3>
                                    <ul>@foreach (var item in Model.DeliveryTips) { <li>@item</li> }</ul>
                                </div>
                            }
                        }
                    </section>
                </div>

                <aside class="interview-result-secondary-column" aria-label="Đánh giá và hành động">
                    <section class="interview-result-card interview-result-anxiety" aria-labelledby="result-anxiety-title">
                        <div class="interview-result-card__heading">
                            <span class="interview-result-card__icon"><i class="fa-solid fa-heart-pulse" aria-hidden="true"></i></span>
                            <div>
                                <span class="interview-result-eyebrow">GÓC NHÌN THAM KHẢO</span>
                                <h2 id="result-anxiety-title">Dấu hiệu lo lắng</h2>
                            </div>
                        </div>
                        <p class="interview-result-anxiety__subtitle">Ước tính theo thang 1–10</p>
                        @if (hasAnxiety)
                        {
                            <div class="interview-result-anxiety__value">
                                <strong>@Model.AnxietyIndicator</strong><span>/10</span>
                                <span class="interview-result-anxiety__level @anxietyLevelClass">@Model.AnxietyLevelText</span>
                            </div>
                            @if (Model.PreviousAnxietyIndicator > 0)
                            {
                                <p class="interview-result-anxiety__trend @(anxietyChange <= 0 ? "is-decreasing" : "is-increasing")">
                                    @(anxietyChange < 0 ? $"Giảm {-anxietyChange} so với buổi trước" : anxietyChange > 0 ? $"Tăng {anxietyChange} so với buổi trước" : "Bằng buổi trước")
                                </p>
                            }
                            <p class="interview-result-anxiety__note">Ước tính từ từ đệm, khoảng lặng và tốc độ nói; không phải đánh giá y tế.</p>
                        }
                        else
                        {
                            <p class="interview-result-notice interview-result-notice--info">Chưa đủ dữ liệu để ước tính. Hãy trả lời ít nhất một câu hỏi.</p>
                        }
                    </section>

                    @if (Model.EmailRequested)
                    {
                        <p class="interview-result-notice interview-result-notice--info interview-result-email">
                            <i class="fa-regular fa-envelope" aria-hidden="true"></i>
                            Kết quả này cũng được gửi đến email tài khoản của bạn.
                        </p>
                    }

                    <section class="interview-result-card interview-result-next" aria-labelledby="result-next-title">
                        <h2 id="result-next-title">Bước tiếp theo</h2>
                        <p>Tiếp tục luyện tập hoặc xem lại những câu trả lời để chuẩn bị tốt hơn cho lần sau.</p>
                        <div class="interview-result-next__actions">
                            <a class="button button--primary" href="/Interview/Create"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i> Phỏng vấn buổi mới</a>
                            <a class="button button--secondary" href="/Home/InterviewDetail/@Model.SessionId"><i class="fa-regular fa-message" aria-hidden="true"></i> Xem lại hội thoại</a>
                            <a class="interview-result-next__feedback" href="/Feedback"><i class="fa-regular fa-comment-dots" aria-hidden="true"></i> Góp ý cho bản 2.0.0</a>
                        </div>
                    </section>
                </aside>
            </div>
        </main>
    </div>
    <partial name="Partials/_AppFooter" />
    <partial name="Partials/_Notify" />
</body>
</html>
