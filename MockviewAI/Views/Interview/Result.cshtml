@model MockviewAI.Models.ViewModels.SessionResultViewModel
@using MockviewAI.Models.Ai
@{
    Layout = null;
    ViewData["ActiveNav"] = "practice";   // mục sáng trên thanh menu dùng chung
    // Dấu hiệu lo lắng do hệ thống ước tính (0 = chưa đủ dữ liệu: buổi dừng sớm hoặc dữ liệu cũ)
    var hasAnxiety = Model.AnxietyIndicator > 0;
    var anxietyChange = Model.PreviousAnxietyIndicator > 0 ? Model.AnxietyIndicator - Model.PreviousAnxietyIndicator : 0;
    var anxietyClass = Model.AnxietyIndicator <= 3 ? "c-dung" : Model.AnxietyIndicator <= 6 ? "c-dac_biet" : "c-sai";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kết quả buổi luyện - MockviewAI</title>

    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/themes/theme-indigo.css" asp-append-version="true" />

    @* [UI-DARK] Đợt 4 (02/11): giao diện tối "phòng thu". Bản sáng cũ: Result.css + theme.css *@
    <link rel="stylesheet" href="~/css/studio.css">
    <link rel="stylesheet" href="~/css/studio-result.css">
</head>
<body class="studio">
    <partial name="Partials/_AppNavigation" />

    <main class="wrap">
        <div class="head">
            <div>
                <h1>Kết quả buổi luyện</h1>
                <p class="sub">@Model.Position &middot; @Model.StartedAt.ToString("dd/MM") &middot; @Model.QuestionCount câu &middot; Người phỏng vấn: @Model.InterviewerName</p>
            </div>
            <div class="acts">
                <a href="/Home/InterviewDetail/@Model.SessionId" class="btn btn-main">Xem lại hội thoại</a>
                <a href="/Interview/Create" class="btn btn-ghost">Luyện buổi mới</a>
            </div>
        </div>

        @if (Model.HasCategories)
        {
            <!-- [QUESTION-BANK] Dải băng: cách tiếp cận từng câu (không phải thang điểm) -->
            <section class="panel record" aria-label="Cách bạn tiếp cận từng câu">
                <h2>Cách bạn tiếp cận từng câu</h2>
                <p class="record-note">Đây là bản ghi cách trả lời, không phải thang điểm. Hơi đặc biệt và Đặc biệt vẫn là câu trả lời đúng, chỉ là bạn đi theo đường khác.</p>
                <div class="tape big">
                    @for (int i = 0; i < Model.AnswerCategories.Count; i++)
                    {
                        var c = Model.AnswerCategories[i];
                        var name = AnswerCategory.IsValid(c) ? AnswerCategory.DisplayName(c) : "Chưa xếp loại / bỏ qua";
                        <a class="seg @(AnswerCategory.IsValid(c) ? "is-" + c : "is-none")" href="/Home/InterviewDetail/@Model.SessionId#cau-@(i + 1)"
                           title="Câu @(i + 1): @name" aria-label="Câu @(i + 1): @name">@(AnswerCategory.IsValid(c) ? AnswerCategory.Icon(c) : "–")</a>
                    }
                </div>
                <div class="qnums" aria-hidden="true">
                    @for (int i = 1; i <= Model.AnswerCategories.Count; i++) { <span><span class="w">Câu </span>@i</span> }
                </div>
                <div class="legend">
                    <span><i class="bg-dung"></i>@Model.CorrectCount Đúng</span>
                    <span><i class="bg-hoi_dac_biet"></i>@Model.AlternativePathCount Hơi đặc biệt</span>
                    <span><i class="bg-dac_biet"></i>@Model.SpecialCount Đặc biệt</span>
                    <span><i class="bg-sai"></i>@Model.WrongCount Sai</span>
                </div>
                @if (Model.IsPreliminaryScore)
                {
                    <p class="note warn">AI đang bận nên phần nội dung được <strong>chấm sơ bộ theo bộ đề</strong> (so các ý cốt lõi), không dùng AI. Cách chấm này chưa nhận ra câu trả lời "Đặc biệt"; hãy luyện lại khi AI hoạt động để có nhận xét chi tiết.</p>
                }
            </section>
        }

        <div class="cols">
            <!-- Điểm -->
            <section class="panel">
                <h2>Điểm tham khảo</h2>
                <div class="score"><b>@(Model.HasScore ? Model.TotalScore.ToString() : "—")</b><span>/100</span></div>
                @if (!Model.HasScore)
                {
                    @* [#21] Buổi dừng trước khi trả lời câu nào: không có điểm *@
                    <p class="note info">Buổi này dừng trước khi bạn trả lời câu nào nên chưa có điểm. Hãy luyện lại để nhận nhận xét của AI.</p>
                }
                else
                {
                    <div class="metric">
                        <div class="row"><span>Nội dung câu trả lời</span><b>@(Model.HasContentScore ? Model.ContentScore.ToString() : "—")</b></div>
                        <div class="bar"><i style="width: @(Model.HasContentScore ? Model.ContentScore : 0)%"></i></div>
                    </div>
                    <div class="metric">
                        <div class="row"><span>Cách nói</span><b>@Model.DeliveryScore</b></div>
                        <div class="bar"><i style="width: @(Model.DeliveryScore)%"></i></div>
                    </div>
                }
                @if (Model.InvalidAnswerCount > 0)
                {
                    <p class="note err">@Model.InvalidAnswerCount câu trả lời chưa có ý nghĩa nên được tính sai (0 điểm). Xem lại ở "Xem lại hội thoại".</p>
                }
                @if (Model.IsPreliminaryScore && !Model.HasCategories)
                {
                    <p class="note warn">AI đang bận nên phần nội dung được chấm sơ bộ theo bộ đề, không dùng AI.</p>
                }
                @if (Model.HasScore && !Model.HasContentScore)
                {
                    <p class="note warn">AI đang bận nên chưa nhận xét được nội dung. Điểm tổng lúc này chỉ tính phần cách nói.</p>
                }
                <p class="foot">Điểm tổng = 60% nội dung + 40% cách nói.</p>
            </section>

            <!-- Dấu hiệu lo lắng -->
            <section class="panel anx">
                <h2>Dấu hiệu lo lắng</h2>
                <p class="foot top">Hệ thống ước tính, thang 1–10</p>
                @if (hasAnxiety)
                {
                    <div class="anx-value"><b>@Model.AnxietyIndicator</b><span class="muted">/10</span><span class="lvl @anxietyClass">@Model.AnxietyLevelText</span></div>
                    if (Model.PreviousAnxietyIndicator > 0)
                    {
                        <span class="trend @(anxietyChange <= 0 ? "down" : "up")">@(anxietyChange < 0 ? $"Giảm {-anxietyChange} so với buổi trước" : anxietyChange > 0 ? $"Tăng {anxietyChange} so với buổi trước" : "Bằng buổi trước")</span>
                    }
                    <p class="foot">Ước tính từ từ đệm, khoảng lặng, tốc độ nói. Không phải đánh giá y tế.</p>
                }
                else
                {
                    <p class="note info">Chưa đủ dữ liệu để ước tính. Hãy trả lời ít nhất 1 câu.</p>
                }
                @if (Model.EmailRequested)
                {
                    <p class="note info">Kết quả này cũng được gửi về email tài khoản của bạn.</p>
                }
                <a href="/Feedback" class="btn btn-ghost feedback-btn">Góp ý cho bản 2.0.0</a>
            </section>

            <!-- Nhận xét chi tiết -->
            <section class="panel fb">
                <h2>Nhận xét chi tiết</h2>
                @if (!Model.HasScore)
                {
                    <p class="foot">Chưa có nhận xét cho buổi này.</p>
                }
                else
                {
                    if (!string.IsNullOrWhiteSpace(Model.AiSummary))
                    {
                        <p class="summary">@Model.AiSummary</p>
                    }
                    if (Model.Strengths.Count > 0)
                    {
                        <h3>Điểm mạnh</h3>
                        <ul>@foreach (var item in Model.Strengths) { <li>@item</li> }</ul>
                    }
                    if (Model.Improvements.Count > 0)
                    {
                        <h3>Nên cải thiện</h3>
                        <ul>@foreach (var item in Model.Improvements) { <li>@item</li> }</ul>
                    }
                    if (Model.DeliveryTips.Count > 0)
                    {
                        <h3>Cách nói</h3>
                        <ul>@foreach (var item in Model.DeliveryTips) { <li>@item</li> }</ul>
                    }
                }
            </section>
        </div>
    </main>

    <nav class="mobile-bottom-nav" aria-label="Điều hướng">
        <a href="/Home">Trang chủ</a>
        <a href="/Interview/Create" class="active">Luyện</a>
        <a href="/Home/History">Lịch sử</a>
        <a href="/Profile">Hồ sơ</a>
    </nav>
    <partial name="Partials/_Notify" />
</body>
</html>
