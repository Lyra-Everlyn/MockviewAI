@{
    Layout = null;
    ViewData["ActiveNav"] = "practice";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tạo buổi luyện - MockviewAI</title>
    
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/themes/theme-indigo.css" asp-append-version="true" />

    @* [UI-DARK] Đợt 4 (02/11): giao diện tối "phòng thu". Bản sáng cũ: CreateSession.css + theme.css *@
    <link rel="stylesheet" href="~/css/studio.css">
    <link rel="stylesheet" href="~/css/studio-create.css">
</head>
<body class="studio">
    <partial name="Partials/_AppNavigation" />

    <main class="wrap">
        <h1>Tạo buổi luyện</h1>
        <p class="sub">Chọn người phỏng vấn trước, mỗi người hỏi một kiểu khác nhau.</p>

        <form method="post" asp-controller="Interview" asp-action="Start" id="createSessionForm" class="create-grid">

            <!-- Người phỏng vấn -->
            <fieldset class="people">
                <legend class="sr-only">Người phỏng vấn</legend>

                <label class="person">
                    <input type="radio" name="interviewer" value="linh" data-name="Linh" checked>
                    <span class="face">L</span>
                    <span class="person-body">
                        <span class="pname">Linh</span>
                        <span class="prole">Chuyên viên tuyển dụng (HR)</span>
                        <span class="pask"><em>Hỏi về:</em> bản thân, động lực, làm việc nhóm, vì sao chọn công ty</span>
                        <span class="picked">Đã chọn</span>
                    </span>
                </label>

                <label class="person">
                    <input type="radio" name="interviewer" value="nam" data-name="Nam">
                    <span class="face f-nam">N</span>
                    <span class="person-body">
                        <span class="pname">Nam</span>
                        <span class="prole">Trưởng nhóm kỹ thuật (Tech Lead)</span>
                        <span class="pask"><em>Hỏi về:</em> kiến thức chuyên môn theo vị trí: code, kiểm thử, phân tích yêu cầu</span>
                        <span class="picked">Đã chọn</span>
                    </span>
                </label>

                <label class="person">
                    <input type="radio" name="interviewer" value="an" data-name="An">
                    <span class="face f-an">A</span>
                    <span class="person-body">
                        <span class="pname">An</span>
                        <span class="prole">Quản lý dự án (Project Manager)</span>
                        <span class="pask"><em>Hỏi về:</em> deadline, ưu tiên công việc, xử lý tình huống trong dự án</span>
                        <span class="picked">Đã chọn</span>
                    </span>
                </label>
            </fieldset>

            <!-- Thông tin buổi luyện -->
            <section class="panel setup" aria-label="Thông tin buổi luyện">
                <fieldset class="field">
                    <legend class="label">Vị trí ứng tuyển</legend>
                    <div class="pills">
                        <label class="choice"><input type="radio" name="position" value="developer" checked><span>Lập trình viên</span></label>
                        <label class="choice"><input type="radio" name="position" value="tester"><span>Tester</span></label>
                        <label class="choice"><input type="radio" name="position" value="ba"><span>BA</span></label>
                    </div>
                </fieldset>

                <fieldset class="field">
                    <legend class="label">Số câu hỏi</legend>
                    <div class="counts">
                        @* [QUESTION-BANK] Chọn từ 5 đến 10 câu (server kiểm tra lại khoảng này) *@
                        @for (int n = 5; n <= 10; n++)
                        {
                            <label class="choice"><input type="radio" name="questionCount" value="@n" @(n == 5 ? "checked" : null)><span>@n</span></label>
                        }
                    </div>
                </fieldset>

                <!-- Email kết quả: CHỈ gửi khi người dùng tick đồng ý -->
                <label class="check-row field">
                    <input type="checkbox" name="emailResult" value="true">
                    <span>Gửi kết quả về email tài khoản của tôi sau buổi luyện</span>
                </label>

                <div class="summary">
                    <span class="label">Buổi của bạn</span>
                    <div class="tape" id="preview-tape" aria-hidden="true"></div>
                    <p id="preview-text">5 câu với Linh · khoảng 10–15 phút · câu đầu luôn là giới thiệu bản thân</p>
                    <button type="submit" class="btn btn-main start">Bắt đầu phỏng vấn</button>
                </div>
            </section>
        </form>
    </main>

    <!-- Menu dưới đáy (điện thoại) -->
    <nav class="mobile-bottom-nav" aria-label="Điều hướng">
        <a href="/Home">Trang chủ</a>
        <a href="/Interview/Create" class="active">Luyện</a>
        <a href="/Home/History">Lịch sử</a>
        <a href="/Profile">Hồ sơ</a>
    </nav>

    <script>
        // Xem trước buổi luyện: dải băng theo số câu + người phỏng vấn + thời gian ước tính (~2–3 phút/câu)
        (function () {
            var form = document.getElementById('createSessionForm');
            var tape = document.getElementById('preview-tape');
            var text = document.getElementById('preview-text');
            function update() {
                var n = parseInt(form.querySelector('input[name="questionCount"]:checked').value, 10);
                var who = form.querySelector('input[name="interviewer"]:checked').dataset.name;
                tape.innerHTML = '';
                for (var i = 0; i < n; i++) {
                    var seg = document.createElement('span');
                    seg.className = 'seg' + (i === 0 ? ' now' : '');
                    tape.appendChild(seg);
                }
                text.textContent = n + ' câu với ' + who + ' · khoảng ' + (n * 2) + '–' + (n * 3) + ' phút · câu đầu luôn là giới thiệu bản thân';
            }
            form.addEventListener('change', update);
            update();
        })();
    </script>
    <partial name="Partials/_Notify" />
</body>
</html>
