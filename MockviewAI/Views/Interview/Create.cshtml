@{
    Layout = null;
    // Chữ cái đầu của tên người đang đăng nhập (avatar góc phải)
    var userName = User.Identity?.Name ?? "";
    var initial = string.IsNullOrWhiteSpace(userName) ? "?" : userName.Substring(0, 1).ToUpper();
    // Ảnh Google của tài khoản (nếu có), không có thì hiện chữ cái đầu
    var avatarUrl = User.FindFirst("AvatarUrl")?.Value;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tạo buổi luyện - MockviewAI</title>
    <!-- Import font Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Import FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/CreateSession.css">
</head>
<body>

    <!-- Header Desktop -->
    <header class="desktop-header">
        <div class="header-content">
            <div class="logo-nav">
                <div class="logo">Mockview<span>AI</span></div>
                <nav class="nav-links">
                    <a href="/Home">Trang chủ</a>
                    <a href="/Interview/Create" class="active">Luyện tập</a>
                    <a href="/Home/History">Lịch sử</a>
                </nav>
            </div>
            <div class="header-actions">
                <span class="badge-beta">Bản thử V1</span>
                <div class="profile-icon" style="cursor: pointer;" title="Hồ sơ" onclick="location.href='/Profile'">@if (!string.IsNullOrEmpty(avatarUrl)) { <img src="@avatarUrl" alt="" referrerpolicy="no-referrer" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;" /> } else { @initial }</div>
            </div>
        </div>
    </header>

    <!-- Header Mobile -->
    <header class="mobile-header">
        <a href="/Home" class="back-btn"><i class="fas fa-chevron-left"></i> Trang chủ</a>
    </header>

    <main class="main-container">
        <div class="page-title-section">
            <h1>Tạo buổi luyện</h1>
            <p class="desktop-subtitle">Chọn vị trí, người phỏng vấn và bắt đầu.</p>
            <p class="mobile-subtitle">Chọn người phỏng vấn và vị trí bạn muốn luyện.</p>
        </div>

        <form method="post" asp-controller="Interview" asp-action="Start" id="createSessionForm">
            <div class="form-grid">
                
                <!-- Cột trái (Desktop) / Phần 2 (Mobile) -->
                <div class="card info-card">
                    <h3 class="section-title"><span class="step-num">1. </span>Thông tin buổi luyện</h3>
                    
                    <div class="form-group">
                        <label>Vị trí ứng tuyển</label>
                        <select name="position" required>
                            <option value="developer">Lập trình viên</option>
                            <option value="tester">Kiểm thử viên (Tester)</option>
                            <option value="ba">Chuyên viên Phân tích (BA)</option>
                        </select>
                    </div>

                    <div class="row-group">
                        <div class="form-group half">
                            <label>Số câu hỏi</label>
                            <select name="questionCount">
                                <option value="5">5 câu</option>
                                <option value="10">10 câu</option>
                            </select>
                        </div>
                        <!-- Email kết quả: CHỈ gửi khi người dùng tick đồng ý -->
                        <div class="form-group half">
                            <label>Nhận kết quả qua email</label>
                            <label style="display:flex;gap:8px;align-items:flex-start;font-weight:500;cursor:pointer;line-height:1.4;margin-top:6px">
                                <input type="checkbox" name="emailResult" value="true" style="margin-top:3px;width:auto">
                                <span>Gửi kết quả về email tài khoản của tôi sau buổi luyện</span>
                            </label>
                        </div>
                    </div>

                    @* [#22] Tạm ẩn: server chưa dùng "Mô tả công việc" nên không hứa "AI hỏi sát hơn". Bật lại khi làm tính năng #25.
                    <div class="form-group">
                        <label>Mô tả công việc (không bắt buộc)</label>
                        <textarea name="description" rows="4" placeholder="Dán mô tả công việc để AI hỏi sát hơn..."></textarea>
                    </div>
                    *@
                </div>

                <!-- Cột phải (Desktop) / Phần 1 (Mobile) -->
                <div class="card interviewer-card">
                    <h3 class="section-title"><span class="step-num">2. </span>Chọn người phỏng vấn <span class="mobile-only">(khuôn mặt AI)</span></h3>
                    
                    <div class="interviewer-list">
                        <!-- Lựa chọn 1: Linh -->
                        <input type="radio" name="interviewer" id="int-linh" value="linh" checked>
                        <label for="int-linh" class="interviewer-item">
                            <div class="avatar avatar-linh">
                                <div class="avatar-inner bg-blue"><i class="fas fa-user"></i></div>
                            </div>
                            <div class="int-name">Linh</div>
                            <div class="int-role desktop-role">Nhân sự</div>
                            <div class="int-role mobile-role">HR</div>
                        </label>

                        <!-- Lựa chọn 2: Nam -->
                        <input type="radio" name="interviewer" id="int-nam" value="nam">
                        <label for="int-nam" class="interviewer-item">
                            <div class="avatar avatar-nam">
                                <div class="avatar-inner bg-green"><i class="fas fa-user"></i></div>
                            </div>
                            <div class="int-name">Nam</div>
                            <div class="int-role desktop-role">Kỹ thuật</div>
                            <div class="int-role mobile-role">Kỹ thuật</div>
                        </label>

                        <!-- Lựa chọn 3: An -->
                        <input type="radio" name="interviewer" id="int-an" value="an">
                        <label for="int-an" class="interviewer-item">
                            <div class="avatar avatar-an">
                                <div class="avatar-inner bg-purple"><i class="fas fa-user"></i></div>
                            </div>
                            <div class="int-name">An</div>
                            <div class="int-role desktop-role">Quản lý</div>
                            <div class="int-role mobile-role">Quản lý</div>
                        </label>
                    </div>
                </div>

                <!-- Phần text phụ và nút Submit -->
                <div class="form-actions">
                    <p class="helper-text desktop-only">Linh hỏi về bản thân và thái độ làm việc; Nam hỏi kỹ thuật; An hỏi tình huống quản lý.</p>
                    <p class="time-text">Buổi 5 câu mất khoảng 10-15 phút.</p>
                    <button type="submit" class="btn-submit">Bắt đầu phỏng vấn</button>
                </div>

            </div>
        </form>
    </main>

    <!-- Bottom Navigation Mobile -->
    <nav class="mobile-bottom-nav">
        <a href="/Home" class="nav-item"><i class="fas fa-home"></i></a>
        <a href="/Interview/Create" class="nav-item active"><i class="fas fa-microphone"></i></a>
        <a href="/Home/History" class="nav-item"><i class="fas fa-history"></i></a>
        <a href="/Profile" class="nav-item"><i class="far fa-user"></i></a>
    </nav>
    <partial name="Partials/_Notify" />
</body>
</html>
