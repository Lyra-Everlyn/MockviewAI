@model MockviewAI.Models.ViewModels.Admin.AdminFeedbackListViewModel
@*
    #region Admin/Feedbacks
    <summary>[ADMIN] Danh sách góp ý (chỉ xem): lọc số sao, chỉ góp ý có nội dung (viên bấm), phân trang.</summary>
    #endregion
*@
@{
    ViewData["Title"] = "Quản trị - Góp ý";

    // Giữ bộ lọc khi chuyển trang hoặc đổi một bộ lọc
    string FeedbacksUrl(int? rating, bool withComment, int page = 1) =>
        Url.Action("Feedbacks", "Admin", new { rating, withComment = withComment ? true : (bool?)null, page }) ?? "/Admin/Feedbacks";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin.css" asp-append-version="true" />
}

<main class="page-shell admin-page">
    <partial name="_AdminTabs" />

    <section class="admin-panel" aria-labelledby="feedback-title">
        @* #region Bộ lọc *@
        <div class="admin-filters">
            <nav class="admin-chips" aria-label="Lọc theo số sao">
                <a class="admin-chip @(Model.Rating == null ? "is-active" : null)" href="@FeedbacksUrl(null, Model.OnlyWithComment)"
                   aria-current="@(Model.Rating == null ? "true" : null)">Tất cả</a>
                @for (int star = 5; star >= 1; star--)
                {
                    <a class="admin-chip @(Model.Rating == star ? "is-active" : null)" href="@FeedbacksUrl(star, Model.OnlyWithComment)"
                       aria-current="@(Model.Rating == star ? "true" : null)" aria-label="@star sao">@star ★</a>
                }
            </nav>
            <a class="admin-chip admin-chip--toggle @(Model.OnlyWithComment ? "is-active" : null)"
               href="@FeedbacksUrl(Model.Rating, !Model.OnlyWithComment)">
                <span class="admin-chip__box" aria-hidden="true">@if (Model.OnlyWithComment) {<i class="fa-solid fa-check"></i>}</span>
                Chỉ góp ý có nội dung
            </a>
        </div>
        @* #endregion *@

        <h2 id="feedback-title" class="admin-count" aria-live="polite">@Model.TotalCount góp ý · Trang @Model.Page/@Model.TotalPages</h2>

        @if (!Model.Feedbacks.Any())
        {
            <div class="admin-empty">
                <strong>Chưa có góp ý phù hợp</strong>
                <span>Góp ý gửi từ trang Góp ý sẽ xuất hiện tại đây.</span>
            </div>
        }
        else
        {
            <ul class="admin-feedbacks">
                @foreach (var f in Model.Feedbacks)
                {
                    <li class="admin-feedback">
                        <div class="admin-feedback__head">
                            <partial name="_AdminStars" model="f.EaseRating" />
                            <span class="admin-tag">Bớt lo lắng: @f.AnxietyHelp</span>
                            <span class="admin-muted">
                                @(string.IsNullOrWhiteSpace(f.UserName) ? f.UserEmail : $"{f.UserName} · {f.UserEmail}")
                                · @f.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(f.Comment))
                        {
                            <p class="admin-feedback__comment">@f.Comment</p>
                        }
                        else
                        {
                            <p class="admin-feedback__comment admin-feedback__comment--empty">Không có nội dung</p>
                        }
                    </li>
                }
            </ul>

            <partial name="_AdminPager" model="(Model.Page, Model.TotalPages, (Func<int, string>)(p => FeedbacksUrl(Model.Rating, Model.OnlyWithComment, p)))" />
        }
    </section>
</main>
