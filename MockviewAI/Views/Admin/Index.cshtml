@model MockviewAI.Models.ViewModels.Admin.AdminDashboardViewModel
@*
    #region Admin/Index
    <summary>[ADMIN] Tổng quan: 4 số liệu chính, buổi luyện 14 ngày, top vị trí, người dùng mới, góp ý gần đây.</summary>
    #endregion
*@
@{
    ViewData["Title"] = "Quản trị - Tổng quan";
    var invariant = System.Globalization.CultureInfo.InvariantCulture;
    int maxPerDay = Math.Max(1, Model.SessionsPerDay.Select(d => d.Count).DefaultIfEmpty(0).Max());
    int maxPosition = Math.Max(1, Model.TopPositions.Select(p => p.Count).DefaultIfEmpty(0).Max());
    double completionRate = Model.TotalSessions == 0 ? 0 : Model.CompletedSessions * 100.0 / Model.TotalSessions;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin.css" asp-append-version="true" />
}

<main class="page-shell admin-page">
    <header class="page-header">
        <div class="page-header__content">
            <span class="page-header__eyebrow">KHU QUẢN TRỊ</span>
            <h1 class="page-header__title">Tổng quan hệ thống</h1>
            <p class="page-header__description">Số liệu người dùng, buổi luyện và góp ý của MockviewAI (chỉ xem).</p>
        </div>
    </header>

    <partial name="_AdminTabs" />

    <section class="admin-stats" aria-label="Số liệu chính">
        <div class="stat-card">
            <span class="stat-card__label">Người dùng</span>
            <span class="stat-card__value">@Model.TotalUsers</span>
            <span class="stat-card__description">+@Model.NewUsers7Days mới · @Model.ActiveUsers7Days đăng nhập trong 7 ngày</span>
        </div>
        <div class="stat-card">
            <span class="stat-card__label">Buổi luyện</span>
            <span class="stat-card__value">@Model.TotalSessions</span>
            <span class="stat-card__description">@Model.Sessions7Days buổi trong 7 ngày · @completionRate.ToString("0")% hoàn thành</span>
        </div>
        <div class="stat-card">
            <span class="stat-card__label">Điểm trung bình</span>
            <span class="stat-card__value">@(Model.AverageScore?.ToString("0.0") ?? "—")</span>
            <span class="stat-card__description">Trên @Model.CompletedSessions buổi đã chấm (thang 100)</span>
        </div>
        <div class="stat-card">
            <span class="stat-card__label">Góp ý</span>
            <span class="stat-card__value">@Model.TotalFeedbacks</span>
            <span class="stat-card__description">Dễ dùng: @(Model.AverageEaseRating?.ToString("0.0") ?? "—")/5 sao</span>
        </div>
    </section>

    <div class="admin-grid">
        <section class="surface-card admin-panel" aria-labelledby="chart-title">
            <span class="section-header__eyebrow">14 NGÀY GẦN NHẤT</span>
            <h2 id="chart-title" class="section-header__title">Buổi luyện mỗi ngày</h2>
            <div class="admin-bars" role="list">
                @foreach (var day in Model.SessionsPerDay)
                {
                    var height = day.Count * 100.0 / maxPerDay;
                    <div class="admin-bars__item" role="listitem" title="@day.Day.ToString("dd/MM"): @day.Count buổi">
                        <span class="admin-bars__value">@(day.Count > 0 ? day.Count.ToString() : "")</span>
                        <span class="admin-bars__bar" style="height:@height.ToString("0.#", invariant)%"></span>
                        <span class="admin-bars__label">@day.Day.ToString("dd/MM")</span>
                    </div>
                }
            </div>
        </section>

        <section class="surface-card admin-panel" aria-labelledby="position-title">
            <span class="section-header__eyebrow">TOP 5</span>
            <h2 id="position-title" class="section-header__title">Vị trí được luyện nhiều nhất</h2>
            @if (!Model.TopPositions.Any())
            {
                <p class="admin-muted admin-empty">Chưa có buổi luyện nào.</p>
            }
            else
            {
                <ul class="admin-ranks">
                    @foreach (var p in Model.TopPositions)
                    {
                        <li class="admin-ranks__item">
                            <span class="admin-ranks__name">@p.Position</span>
                            <span class="admin-ranks__track"><span class="admin-ranks__fill" style="width:@((p.Count * 100.0 / maxPosition).ToString("0.#", invariant))%"></span></span>
                            <span class="admin-ranks__count">@p.Count</span>
                        </li>
                    }
                </ul>
            }
        </section>
    </div>

    <div class="admin-grid">
        <section class="surface-card admin-panel" aria-labelledby="recent-users-title">
            <div class="admin-panel__head">
                <div>
                    <span class="section-header__eyebrow">MỚI ĐĂNG KÝ</span>
                    <h2 id="recent-users-title" class="section-header__title">Người dùng mới</h2>
                </div>
                <a class="text-link" href="/Admin/Users">Xem tất cả</a>
            </div>
            @if (!Model.RecentUsers.Any())
            {
                <p class="admin-muted admin-empty">Chưa có người dùng nào.</p>
            }
            else
            {
                <ul class="admin-list">
                    @foreach (var u in Model.RecentUsers)
                    {
                        <li class="admin-list__item">
                            <div>
                                <strong>@u.DisplayName</strong>
                                <span class="admin-muted">@u.Email</span>
                            </div>
                            <span class="admin-muted">@u.CreateAt.ToString("dd/MM/yyyy")</span>
                        </li>
                    }
                </ul>
            }
        </section>

        <section class="surface-card admin-panel" aria-labelledby="recent-feedback-title">
            <div class="admin-panel__head">
                <div>
                    <span class="section-header__eyebrow">MỚI NHẤT</span>
                    <h2 id="recent-feedback-title" class="section-header__title">Góp ý gần đây</h2>
                </div>
                <a class="text-link" href="/Admin/Feedbacks">Xem tất cả</a>
            </div>
            @if (!Model.RecentFeedbacks.Any())
            {
                <p class="admin-muted admin-empty">Chưa có góp ý nào.</p>
            }
            else
            {
                <ul class="admin-list">
                    @foreach (var f in Model.RecentFeedbacks)
                    {
                        <li class="admin-list__item admin-list__item--stack">
                            <div class="admin-feedback__head">
                                <partial name="_AdminStars" model="f.EaseRating" />
                                <span class="admin-muted">@f.UserEmail · @f.CreatedAt.ToString("dd/MM HH:mm")</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(f.Comment))
                            {
                                <p class="admin-feedback__comment">@f.Comment</p>
                            }
                        </li>
                    }
                </ul>
            }
        </section>
    </div>
</main>
