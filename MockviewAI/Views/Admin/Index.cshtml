@model MockviewAI.Models.ViewModels.Admin.AdminDashboardViewModel

@{
    ViewData["Title"] = "Quản trị - Tổng quan";
    var invariant = System.Globalization.CultureInfo.InvariantCulture;
    int maxPerDay = Math.Max(1, Model.SessionsPerDay.Select(d => d.Count).DefaultIfEmpty(0).Max());
    int totalPerDay = Model.SessionsPerDay.Sum(d => d.Count);
    int maxPosition = Math.Max(1, Model.TopPositions.Select(p => p.Count).DefaultIfEmpty(0).Max());
    double completionRate = Model.TotalSessions == 0 ? 0 : Model.CompletedSessions * 100.0 / Model.TotalSessions;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin.css" asp-append-version="true" />
}

<main class="page-shell admin-page">
    <partial name="_AdminTabs" />

    @* #region Số liệu chính *@
    <section class="admin-stats" aria-label="Số liệu chính">
        <div class="admin-stat">
            <span class="admin-stat__label">Người dùng</span>
            <strong class="admin-stat__value">@Model.TotalUsers</strong>
            <span class="admin-stat__note">+@Model.NewUsers7Days mới · @Model.ActiveUsers7Days đăng nhập trong 7 ngày</span>
        </div>
        <div class="admin-stat">
            <span class="admin-stat__label">Buổi luyện</span>
            <strong class="admin-stat__value">@Model.TotalSessions</strong>
            <span class="admin-stat__note">@Model.Sessions7Days trong 7 ngày · @completionRate.ToString("0")% hoàn thành</span>
        </div>
        <div class="admin-stat">
            <span class="admin-stat__label">Điểm trung bình</span>
            <strong class="admin-stat__value">@(Model.AverageScore?.ToString("0.0") ?? "—")</strong>
            <span class="admin-stat__note">Trên @Model.CompletedSessions buổi đã chấm, thang 100</span>
        </div>
        <div class="admin-stat">
            <span class="admin-stat__label">Góp ý</span>
            <strong class="admin-stat__value">@Model.TotalFeedbacks</strong>
            <span class="admin-stat__note">Dễ dùng trung bình @(Model.AverageEaseRating?.ToString("0.0") ?? "—")/5 sao</span>
        </div>
    </section>
    @* #endregion *@

    @* #region Biểu đồ + vị trí luyện nhiều nhất *@
    <section class="admin-panel admin-chart" aria-labelledby="chart-title">
        <div class="admin-chart__main">
            <div class="admin-panel__head">
                <h2 id="chart-title" class="admin-panel__title">Buổi luyện 14 ngày qua</h2>
                <span class="admin-muted">Tổng @totalPerDay buổi</span>
            </div>
            <ol class="admin-bars">
                @foreach (var day in Model.SessionsPerDay)
                {
                    // Ngày không có buổi nào vẫn có vạch mỏng để thấy trục
                    var height = Math.Max(day.Count * 100.0 / maxPerDay, 3);
                    <li class="admin-bars__item" title="@day.Day.ToString("dd/MM"): @day.Count buổi">
                        <span class="admin-bars__value">@(day.Count > 0 ? day.Count.ToString() : "")</span>
                        <span class="admin-bars__bar" style="height:@height.ToString("0.#", invariant)%"></span>
                        <span class="admin-bars__label">@day.Day.ToString("dd")</span>
                    </li>
                }
            </ol>
        </div>

        <div class="admin-chart__side">
            <h3 class="admin-panel__title admin-panel__title--small">Vị trí luyện nhiều nhất</h3>
            @if (!Model.TopPositions.Any())
            {
                <p class="admin-muted">Chưa có buổi luyện nào.</p>
            }
            else
            {
                <ol class="admin-ranks">
                    @foreach (var p in Model.TopPositions)
                    {
                        <li class="admin-ranks__item">
                            <span class="admin-ranks__name">@p.Position</span>
                            <span class="admin-ranks__track"><span class="admin-ranks__fill" style="width:@((p.Count * 100.0 / maxPosition).ToString("0.#", invariant))%"></span></span>
                            <strong class="admin-ranks__count">@p.Count</strong>
                        </li>
                    }
                </ol>
            }
        </div>
    </section>
    @* #endregion *@

    @* #region Người dùng mới + góp ý gần đây *@
    <div class="admin-grid">
        <section class="admin-panel" aria-labelledby="recent-users-title">
            <div class="admin-panel__head">
                <h2 id="recent-users-title" class="admin-panel__title">Người dùng mới</h2>
                <a class="admin-link" href="/Admin/Users">Xem tất cả</a>
            </div>
            @if (!Model.RecentUsers.Any())
            {
                <p class="admin-muted">Chưa có người dùng nào.</p>
            }
            else
            {
                <ul class="admin-list">
                    @foreach (var u in Model.RecentUsers)
                    {
                        <li class="admin-list__item">
                            <partial name="_AdminUser" model="u" />
                            <span class="admin-muted">@u.CreateAt.ToString("dd/MM/yyyy")</span>
                        </li>
                    }
                </ul>
            }
        </section>

        <section class="admin-panel" aria-labelledby="recent-feedback-title">
            <div class="admin-panel__head">
                <h2 id="recent-feedback-title" class="admin-panel__title">Góp ý gần đây</h2>
                <a class="admin-link" href="/Admin/Feedbacks">Xem tất cả</a>
            </div>
            @if (!Model.RecentFeedbacks.Any())
            {
                <p class="admin-muted">Chưa có góp ý nào.</p>
            }
            else
            {
                <ul class="admin-list">
                    @foreach (var f in Model.RecentFeedbacks)
                    {
                        <li class="admin-list__item admin-list__item--stack">
                            <div class="admin-feedback__head">
                                <partial name="_AdminStars" model="f.EaseRating" />
                                <span class="admin-muted">@(string.IsNullOrWhiteSpace(f.UserName) ? f.UserEmail : f.UserName) · @f.CreatedAt.ToString("dd/MM HH:mm")</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(f.Comment))
                            {
                                <p class="admin-feedback__comment">@f.Comment</p>
                            }
                            else
                            {
                                <p class="admin-feedback__comment admin-feedback__comment--empty">Không có nội dung</p>
                            }
                        </li>
                    }
                </ul>
            }
        </section>
    </div>
    @* #endregion *@
</main>
