@model MockviewAI.Models.ViewModels.Admin.AdminUserListViewModel
@using MockviewAI.Services.Admin
@*
    #region Admin/Users
    <summary>[ADMIN] Danh sách người dùng (chỉ xem): tìm theo email / tên, lọc trạng thái bằng viên bấm, phân trang.</summary>
    #endregion
*@
@{
    ViewData["Title"] = "Quản trị - Người dùng";

    // Giữ bộ lọc khi chuyển trang hoặc đổi trạng thái
    string UsersUrl(string? status, int page = 1) => Url.Action("Users", "Admin", new { search = Model.Search, status, page }) ?? "/Admin/Users";

    string StatusClass(string status) => status switch
    {
        "Active" => "admin-status--active",
        "Inactive" => "admin-status--inactive",
        _ => "admin-status--locked"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin.css" asp-append-version="true" />
}

<main class="page-shell admin-page">
    <partial name="_AdminTabs" />

    <section class="admin-panel" aria-labelledby="users-title">
        @* #region Bộ lọc *@
        <div class="admin-filters">
            <form class="admin-search" method="get" action="/Admin/Users" role="search">
                <label class="visually-hidden" for="search">Tìm theo email hoặc tên</label>
                <input class="admin-search__input" type="search" id="search" name="search" value="@Model.Search"
                       maxlength="100" placeholder="Tìm theo email hoặc tên" autocomplete="off" />
                @if (!string.IsNullOrEmpty(Model.Status))
                {
                    <input type="hidden" name="status" value="@Model.Status" />
                }
                <button type="submit" class="button button--info button--small">Tìm</button>
            </form>

            <nav class="admin-chips" aria-label="Lọc theo trạng thái">
                <a class="admin-chip @(Model.Status == null ? "is-active" : null)" href="@UsersUrl(null)"
                   aria-current="@(Model.Status == null ? "true" : null)">Tất cả</a>
                @foreach (var s in AdminService.Statuses)
                {
                    <a class="admin-chip @(Model.Status == s ? "is-active" : null)" href="@UsersUrl(s)"
                       aria-current="@(Model.Status == s ? "true" : null)">@AdminService.StatusLabel(s)</a>
                }
            </nav>
        </div>
        @* #endregion *@

        <h2 id="users-title" class="admin-count" aria-live="polite">@Model.TotalCount tài khoản · Trang @Model.Page/@Model.TotalPages</h2>

        @if (!Model.Users.Any())
        {
            <div class="admin-empty">
                <strong>Không tìm thấy tài khoản phù hợp</strong>
                <span>Thử từ khoá khác hoặc chọn "Tất cả".</span>
            </div>
        }
        else
        {
            @* #region Bảng người dùng *@
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th scope="col">Người dùng</th>
                            <th scope="col">Trạng thái</th>
                            <th scope="col" class="admin-table__num">Buổi luyện</th>
                            <th scope="col">Đăng ký</th>
                            <th scope="col">Đăng nhập gần nhất</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.Users)
                        {
                            <tr>
                                <td><partial name="_AdminUser" model="u" /></td>
                                <td><span class="admin-status @StatusClass(u.Status)">@AdminService.StatusLabel(u.Status)</span></td>
                                <td class="admin-table__num">@u.SessionCount</td>
                                <td>@u.CreateAt.ToString("dd/MM/yyyy")</td>
                                <td>@(u.LastLoginAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @* #endregion *@

            <partial name="_AdminPager" model="(Model.Page, Model.TotalPages, (Func<int, string>)(p => UsersUrl(Model.Status, p)))" />
        }
    </section>
</main>
