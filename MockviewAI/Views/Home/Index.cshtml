@model List<MockviewAI.Models.ViewModels.RecentSessionViewModel>

@{
    Layout = null;
    ViewData["ActiveNav"] = "home";

    var userName = User.Identity?.Name ?? "";
    var hour = DateTime.Now.Hour;

    var greeting = hour >= 5 && hour < 12
        ? "Chào buổi sáng"
        : hour >= 12 && hour < 18
            ? "Chào buổi chiều"
            : "Chào buổi tối";

    var recentSessions = Model ?? new List<MockviewAI.Models.ViewModels.RecentSessionViewModel>();
    var scoredSessions = recentSessions.Where(x => x.HasScore).ToList();
    var inProgressSessions = recentSessions.Count(x => x.IsInProgress);
    var averageScore = scoredSessions.Any()
        ? Math.Round(scoredSessions.Average(x => x.Score))
        : (double?)null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Trang chủ - MockviewAI</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/base.css">
    <link rel="stylesheet" href="~/css/components.css">
    <link rel="stylesheet" href="~/css/Index.css">
    <link rel="stylesheet" href="~/css/themes/theme-indigo.css" media="(prefers-color-scheme: light)" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/themes/theme-dark-1.css" media="(prefers-color-scheme: dark)" asp-append-version="true" />
</head>

<body>
    <partial name="Partials/_AppNavigation" />

    <main class="page-shell">
        <header class="page-header">
            <div class="page-header__content">
                <span class="page-header__eyebrow">@greeting</span>
                <h1 class="page-header__title">Xin chào, @userName</h1>
                <p class="page-header__description">
                    Tiếp tục luyện tập, theo dõi tiến độ và chuẩn bị cho buổi phỏng vấn tiếp theo.
                </p>
            </div>
        </header>

        <section class="content-grid content-grid--hero" aria-label="Bắt đầu luyện tập">
            <article class="panel panel--primary">
                <div class="panel__content">
                    <span class="panel__eyebrow">LUYỆN PHỎNG VẤN</span>
                    <h2 class="panel__title">Sẵn sàng cho buổi luyện tiếp theo?</h2>
                    <p class="panel__description">
                        Chọn vị trí ứng tuyển và bắt đầu một phiên phỏng vấn mô phỏng với AI.
                    </p>

                    <div class="panel__actions">
                        <a href="/Interview/Create" class="button button--primary">
                            <i class="fa-solid fa-microphone" aria-hidden="true"></i>
                            Tạo buổi luyện
                        </a>
                    </div>
                </div>
            </article>

            <div class="stack">
                <a href="/Feedback" class="action-card feedback-action-card">
                    <div class="action-card__icon" aria-hidden="true">
                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                    </div>
                    <div class="action-card__content">
                        <span class="action-card__eyebrow">2.0.0</span>
                        <h3 class="action-card__title">Đóng góp ý kiến</h3>
                        <p class="action-card__description">
                            Chia sẻ trải nghiệm để MockviewAI cải thiện tốt hơn.
                        </p>
                        <span class="action-card__action">
                            Gửi góp ý
                            <span class="action-card__chevron" aria-hidden="true">
                                <i class="fa-solid fa-chevron-right"></i>
                            </span>
                        </span>
                    </div>
                </a>

                <article class="info-card">
                    <div class="info-card__icon" aria-hidden="true">
                        <i class="fa-regular fa-lightbulb"></i>
                    </div>
                    <div class="info-card__content">
                        <span class="info-card__eyebrow">MẸO HÔM NAY</span>
                        <h3 class="info-card__title">Trả lời theo cấu trúc STAR</h3>
                        <p class="info-card__description">
                            Tình huống · Nhiệm vụ · Hành động · Kết quả.
                        </p>
                    </div>
                </article>
            </div>
        </section>

        <section class="page-section" aria-labelledby="overview-title">
            <div class="section-header">
                <div class="section-header__content">
                    <span class="section-header__eyebrow">TỔNG QUAN</span>
                    <h2 id="overview-title" class="section-header__title">Tiến độ gần đây</h2>
                    <p class="section-header__description">
                        Tóm tắt nhanh dựa trên các buổi luyện gần nhất đang hiển thị.
                    </p>
                </div>
            </div>

            <div class="stats-grid">
                <article class="stat-card">
                    <span class="stat-card__label">Buổi gần đây</span>
                    <strong class="stat-card__value">@recentSessions.Count</strong>
                    <span class="stat-card__description">Phiên đang hiển thị</span>
                </article>

                <article class="stat-card">
                    <span class="stat-card__label">Đã chấm điểm</span>
                    <strong class="stat-card__value">@scoredSessions.Count</strong>
                    <span class="stat-card__description">Phiên có kết quả</span>
                </article>

                <article class="stat-card">
                    <span class="stat-card__label">Đang thực hiện</span>
                    <strong class="stat-card__value">@inProgressSessions</strong>
                    <span class="stat-card__description">Phiên chưa hoàn tất</span>
                </article>

                <article class="stat-card">
                    <span class="stat-card__label">Điểm trung bình</span>
                    <strong class="stat-card__value">
                        @(averageScore.HasValue ? averageScore.Value.ToString("0") : "—")
                    </strong>
                    <span class="stat-card__description">Từ các phiên đã chấm</span>
                </article>
            </div>
        </section>

        <section class="page-section" aria-labelledby="recent-title">
            <div class="section-header section-header--with-action">
                <div class="section-header__content">
                    <span class="section-header__eyebrow">LỊCH SỬ</span>
                    <h2 id="recent-title" class="section-header__title">Buổi luyện gần đây</h2>
                    <p class="section-header__description">
                        Tiếp tục phiên đang dở hoặc xem lại kết quả các buổi gần nhất.
                    </p>
                </div>

                <a href="/Home/History" class="section-header__action">
                    Xem tất cả
                    <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                </a>
            </div>

            @if (!recentSessions.Any())
            {
                <div class="empty-state">
                    <div class="empty-state__icon" aria-hidden="true">
                        <i class="fa-regular fa-clock"></i>
                    </div>

                    <div class="empty-state__content">
                        <h3 class="empty-state__title">Chưa có buổi luyện nào</h3>
                        <p class="empty-state__description">
                            Bắt đầu phiên đầu tiên để lịch sử và tiến độ xuất hiện tại đây.
                        </p>
                    </div>

                    <a href="/Interview/Create" class="button button--secondary">
                        Tạo buổi luyện
                    </a>
                </div>
            }
            else
            {
                <div class="session-list">
                    @foreach (var session in recentSessions)
                    {
                        <partial name="Partials/_SessionCard" model="session" />
                    }
                </div>
            }
        </section>

        <section class="page-section" aria-labelledby="quick-actions-title">
            <div class="section-header">
                <div class="section-header__content">
                    <span class="section-header__eyebrow">TRUY CẬP NHANH</span>
                    <h2 id="quick-actions-title" class="section-header__title">Bạn muốn làm gì tiếp theo?</h2>
                </div>
            </div>

            <div class="action-grid">
                <a href="/Interview/Create" class="action-card">
                    <div class="action-card__icon" aria-hidden="true">
                        <i class="fa-solid fa-microphone"></i>
                    </div>
                    <div class="action-card__content">
                        <h3 class="action-card__title">Luyện phỏng vấn</h3>
                        <p class="action-card__description">Bắt đầu một phiên luyện mới.</p>
                    </div>
                    <span class="action-card__chevron" aria-hidden="true">
                        <i class="fa-solid fa-chevron-right"></i>
                    </span>
                </a>

                <a href="/Home/History" class="action-card">
                    <div class="action-card__icon" aria-hidden="true">
                        <i class="fa-regular fa-clock"></i>
                    </div>
                    <div class="action-card__content">
                        <h3 class="action-card__title">Xem lịch sử</h3>
                        <p class="action-card__description">Xem lại các phiên đã thực hiện.</p>
                    </div>
                    <span class="action-card__chevron" aria-hidden="true">
                        <i class="fa-solid fa-chevron-right"></i>
                    </span>
                </a>

                <a href="/Profile" class="action-card">
                    <div class="action-card__icon" aria-hidden="true">
                        <i class="fa-regular fa-user"></i>
                    </div>
                    <div class="action-card__content">
                        <h3 class="action-card__title">Hồ sơ cá nhân</h3>
                        <p class="action-card__description">Kiểm tra thông tin và định hướng nghề nghiệp.</p>
                    </div>
                    <span class="action-card__chevron" aria-hidden="true">
                        <i class="fa-solid fa-chevron-right"></i>
                    </span>
                </a>
            </div>
        </section>
    </main>

    <partial name="Partials/_Notify" />
    <partial name="Partials/_AppFooter" />
</body>
</html>
