@model List<MockviewAI.Models.ViewModels.RecentSessionViewModel>
@{
    Layout = null;
    // Chữ cái đầu của tên người đang đăng nhập (hiện trên avatar góc phải)
    var userName = User.Identity?.Name ?? "";
    var initial = string.IsNullOrWhiteSpace(userName) ? "?" : userName.Substring(0, 1).ToUpper();
    // Ảnh Google của tài khoản (nếu có), không có thì hiện chữ cái đầu
    var avatarUrl = User.FindFirst("AvatarUrl")?.Value;
    var hour = DateTime.Now.Hour;
    var greeting = hour >= 5 && hour < 12 ? "Chào buổi sáng" : hour >= 12 && hour < 18 ? "Chào buổi chiều" : "Chào buổi tối";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trang chủ - MockviewAI</title>
    <link rel="stylesheet" href="~/css/Index.css">
</head>
<body>
    <!-- THANH ĐIỀU HƯỚNG MÁY TÍNH -->
    <nav class="desktop-nav hide-on-mobile">
        <div class="nav-container">
            <div class="nav-left">
                <div class="logo">Mockview<span>AI</span></div>
                <ul class="nav-links">
                    <li><a href="/Home" class="active">Trang chủ</a></li>
                    <li><a href="/Interview/Create">Luyện tập</a></li>
                    <li><a href="/Home/History">Lịch sử</a></li>
                </ul>
            </div>
            <div class="nav-right">
                <span class="badge badge-v1">BETA</span>
                <div class="avatar" style="cursor: pointer;" title="Hồ sơ" onclick="location.href='/Profile'">@if (!string.IsNullOrEmpty(avatarUrl)) { <img src="@avatarUrl" alt="" referrerpolicy="no-referrer" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;" /> } else { @initial }</div>
            </div>
        </div>
    </nav>

    <!-- NỘI DUNG CHÍNH -->
    <main class="dashboard-layout">

        <!-- Header (Lời chào) -->
        <div class="item-greeting">
            <div class="greeting-texts">
                <div class="greeting-sub">@greeting</div>
                <div class="greeting-main">Xin chào, @userName</div>
            </div>
            <!-- Avatar hiển thị cạnh lời chào trên Điện thoại -->
            <div class="avatar hide-on-desktop">@initial</div>
        </div>

        <!-- Khối CTA chính (Xanh biển) -->
        <div class="box cta-box item-cta">
            <h2>Sẵn sàng luyện phỏng vấn?</h2>
            <p>Chọn vị trí, AI sẽ hỏi bạn như một buổi phỏng vấn thật.</p>
            <button type="button" class="btn-create" onclick="location.href='/Interview/Create'">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path>
                    <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                    <line x1="12" y1="19" x2="12" y2="22"></line>
                </svg>
                Tạo buổi luyện
            </button>
        </div>

        <!-- Khối thông báo Beta (Màu cam nhạt) -->
        <div class="box beta-box item-beta" style="cursor: pointer;" onclick="location.href='/Feedback'">
            <h3>Bạn đang dùng bản BETA</h3>
            <p>Bấm vào đây để góp ý, mất khoảng 2 phút.</p>
        </div>

        <!-- Khối Mẹo hôm nay -->
        <div class="box tip-box item-tip">
            <h3>Mẹo hôm nay</h3>
            <p>Trả lời theo cấu trúc STAR: Tình huống, Nhiệm vụ, Hành động, Kết quả.</p>
        </div>

        <!-- Header Buổi gần đây -->
        <div class="recent-header item-recent-header">
            <h3>Buổi gần đây</h3>
            <div class="header-actions hide-on-mobile">
                <a href="/Home/History" class="link-primary">Xem toàn bộ lịch sử</a>
                <a href="#" class="link-help">? Hướng dẫn nhanh</a>
            </div>
            <div class="header-actions hide-on-desktop">
                <a href="/Home/History" class="link-primary">Xem tất cả</a>
            </div>
        </div>

        <!-- Danh sách thẻ (Cards) Buổi gần đây -->
        <div class="item-recent-cards">
            @if (!Model.Any())
            {
                <div class="session-card">
                    <div class="card-header">
                        <span class="role">Bạn chưa có buổi luyện nào. Bấm "Tạo buổi luyện" để bắt đầu.</span>
                    </div>
                </div>
            }
            @for (int i = 0; i < Model.Count; i++)
            {
                var s = Model[i];
                // Thẻ thứ 2 ẩn trên điện thoại như thiết kế
                <div class="session-card @(i >= 1 ? "hide-on-mobile" : "")" style="cursor: pointer;"
                     onclick="location.href='@(s.IsInProgress ? "/Interview/Room/" + s.SessionId : "/Home/InterviewDetail/" + s.SessionId)'">
                    <div class="card-header">
                        <span class="role">@s.RoleName</span>
                        <span class="date">@s.DateFormatted</span>
                    </div>
                    <div class="card-tags">
                        <span class="tag tag-blue">@(s.HasScore ? s.Score + " điểm" : s.StatusText)</span>
                        @if (!string.IsNullOrEmpty(s.AnxietyText))
                        {
                            <span class="tag tag-green">@s.AnxietyText</span>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Link Hướng dẫn nhanh cho Điện thoại -->
        <a href="#" class="link-help mobile-help item-mobile-help hide-on-desktop">? Hướng dẫn nhanh</a>
    </main>

    <!-- THANH ĐIỀU HƯỚNG DƯỚI ĐÁY CHO ĐIỆN THOẠI -->
    <nav class="mobile-nav hide-on-desktop">
        <a href="/Home" class="nav-item active">
            <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
            <span>Trang chủ</span>
        </a>
        <a href="/Interview/Create" class="nav-item">
            <svg viewBox="0 0 24 24"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path></svg>
            <span>Luyện tập</span>
        </a>
        <a href="/Home/History" class="nav-item">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            <span>Lịch sử</span>
        </a>
        <a href="/Profile" class="nav-item">
            <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            <span>Hồ sơ</span>
        </a>
    </nav>
    <partial name="Partials/_Notify" />
</body>
</html>