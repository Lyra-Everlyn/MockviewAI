@model List<MockviewAI.Models.ViewModels.RecentSessionViewModel>

@{
    Layout = null;
    ViewData["ActiveNav"] = "home";

    var userName = User.Identity?.Name ?? "";
    var hour = MockviewAI.Services.Admin.VietnamTime.FromUtc(DateTime.UtcNow).Hour;

    var greeting = hour >= 5 && hour < 12
        ? "Chào buổi sáng"
        : hour >= 12 && hour < 18
            ? "Chào buổi chiều"
            : "Chào buổi tối";

    var recentSessions = Model ?? new List<MockviewAI.Models.ViewModels.RecentSessionViewModel>();
    var scoredSessions = recentSessions.Where(x => x.HasScore).ToList();
    var inProgressSessions = recentSessions.Count(x => x.IsInProgress);
    var averageScore = scoredSessions.Any()
        ? Math.Round(scoredSessions.Average(x => x.Score))
        : (double?)null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Trang chủ - MockviewAI</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/base.css">
    <link rel="stylesheet" href="~/css/components.css">
    <link rel="stylesheet" href="~/css/Index.css">
    <partial name="Partials/_ThemeHead" />
</head>

<body>
    <partial name="Partials/_AppNavigation" />

    <main class="page-shell">
        <header class="page-header">
            <div class="page-header__content">
                <span class="page-header__eyebrow label-plain">@greeting</span>
                <h1 class="page-header__title">Xin chào, @userName</h1>
                <p class="page-header__description">
                    Tiếp tục luyện tập, theo dõi tiến độ và chuẩn bị cho buổi phỏng vấn tiếp theo.
                </p>
            </div>
        </header>

        <section class="action-tiles" aria-label="Bắt đầu">
            <article class="action-tile action-tile--practice">
                <span class="action-tile__bubble" aria-hidden="true">
                    <i class="fa-solid fa-microphone"></i>
                </span>
                <div class="action-tile__content">
                    <span class="action-tile__label">Luyện phỏng vấn</span>
                    <h2 class="action-tile__title">Sẵn sàng cho buổi luyện tiếp theo?</h2>
                    <p class="action-tile__description">
                        Chọn vị trí ứng tuyển và bắt đầu một phiên phỏng vấn mô phỏng với AI.
                    </p>
                    <div class="action-tile__actions">
                        <a href="/Interview/Create" class="button button--primary button--icon">
                            <span class="button__icon" aria-hidden="true"><i class="fa-solid fa-arrow-right"></i></span>
                            Tạo buổi luyện
                        </a>
                    </div>
                </div>
            </article>

            <article class="action-tile action-tile--cv">
                <span class="action-tile__bubble" aria-hidden="true">
                    <i class="fa-solid fa-file-arrow-up"></i>
                </span>
                <div class="action-tile__content">
                    <span class="action-tile__label">CV của bạn</span>
                    <h2 class="action-tile__title">Tải CV để câu hỏi sát với bạn hơn</h2>
                    <p class="action-tile__description">
                        AI đọc kinh nghiệm và dự án trong CV để đặt câu hỏi phù hợp. Chỉ nhận file PDF.
                    </p>
                    <div class="action-tile__actions">
                        <a href="/CV/UploadCv" class="button button--alt button--icon">
                            <span class="button__icon" aria-hidden="true"><i class="fa-solid fa-arrow-up"></i></span>
                            Tải CV lên
                        </a>
                        <a href="/CV" class="action-tile__link">CV đã lưu</a>
                    </div>
                </div>
            </article>
        </section>

        <section class="page-section" aria-labelledby="overview-title">
            <div class="section-header">
                <div class="section-header__content">
                    <h2 id="overview-title" class="section-header__title section-header__title--marked">Tiến độ gần đây</h2>
                    <p class="section-header__description">
                        Tóm tắt nhanh dựa trên các buổi luyện gần nhất đang hiển thị.
                    </p>
                </div>
            </div>

            <div class="stats-grid">
                <article class="stat-card">
                    <span class="stat-card__label label-plain">Buổi gần đây</span>
                    <strong class="stat-card__value">@recentSessions.Count</strong>
                    <span class="stat-card__description">Phiên đang hiển thị</span>
                </article>

                <article class="stat-card">
                    <span class="stat-card__label label-plain">Đã chấm điểm</span>
                    <strong class="stat-card__value stat-card__value--success">@scoredSessions.Count</strong>
                    <span class="stat-card__description">Phiên có kết quả</span>
                </article>

                <article class="stat-card">
                    <span class="stat-card__label label-plain">Đang thực hiện</span>
                    <strong class="stat-card__value stat-card__value--info">@inProgressSessions</strong>
                    <span class="stat-card__description">Phiên chưa hoàn tất</span>
                </article>

                <article class="stat-card">
                    <span class="stat-card__label label-plain">Điểm trung bình</span>
                    <strong class="stat-card__value @(averageScore.HasValue ? null : "stat-card__value--muted")">
                        @(averageScore.HasValue ? averageScore.Value.ToString("0") : "—")
                    </strong>
                    <span class="stat-card__description">Từ các phiên đã chấm</span>
                </article>
            </div>
        </section>

        <div class="page-section home-bottom">
            <section class="home-bottom__main" aria-labelledby="recent-title">
                <div class="section-header section-header--with-action">
                    <div class="section-header__content">
                        <h2 id="recent-title" class="section-header__title section-header__title--marked">Buổi luyện gần đây</h2>
                        <p class="section-header__description">
                            Tiếp tục phiên đang dở hoặc xem lại kết quả các buổi gần nhất.
                        </p>
                    </div>

                    <a href="/Home/History" class="button button--info button--small">
                        Xem tất cả
                    </a>
                </div>

                @if (!recentSessions.Any())
                {
                    <div class="empty-state">
                        <div class="empty-state__icon" aria-hidden="true">
                            <i class="fa-regular fa-clock"></i>
                        </div>

                        <div class="empty-state__content">
                            <h3 class="empty-state__title">Chưa có buổi luyện nào</h3>
                            <p class="empty-state__description">
                                Bắt đầu phiên đầu tiên để lịch sử và tiến độ xuất hiện tại đây.
                            </p>
                        </div>

                        <a href="/Interview/Create" class="button button--secondary">
                            Tạo buổi luyện
                        </a>
                    </div>
                }
                else
                {
                    <div class="session-list">
                        @foreach (var session in recentSessions)
                        {
                            <partial name="Partials/_SessionCard" model="session" />
                        }
                    </div>
                }
            </section>

            <aside class="home-bottom__aside stack">
                <a href="/Feedback" class="action-card feedback-action-card">
                    <div class="action-card__icon" aria-hidden="true">
                        <i class="fa-regular fa-comment"></i>
                    </div>
                    <div class="action-card__content">
                        <span class="action-card__eyebrow label-plain">Góp ý</span>
                        <h3 class="action-card__title">Đóng góp ý kiến</h3>
                        <p class="action-card__description">
                            Chia sẻ trải nghiệm để MockviewAI cải thiện tốt hơn.
                        </p>
                        <span class="action-card__action">
                            <span class="button button--secondary button--small">Gửi góp ý</span>
                        </span>
                    </div>
                </a>

                <article class="info-card">
                    <div class="info-card__icon" aria-hidden="true">
                        <i class="fa-regular fa-lightbulb"></i>
                    </div>
                    <div class="info-card__content">
                        <span class="info-card__eyebrow label-plain">Mẹo hôm nay</span>
                        <h3 class="info-card__title">Trả lời theo cấu trúc STAR</h3>
                        <p class="info-card__description">
                            Tình huống, Nhiệm vụ, Hành động, Kết quả.
                        </p>
                    </div>
                </article>
            </aside>
        </div>
    </main>

    <partial name="Partials/_Notify" />
</body>
</html>
