@{
    Layout = null;
    ViewData["ActiveNav"] = "policy";

    // Cập nhật ngày này mỗi khi nội dung chính sách thay đổi
    var lastUpdated = new DateTime(2026, 11, 18);
    var supportEmail = "support@mockview.ai"; // TODO: thay bằng email hỗ trợ thật

    var sections = new[]
    {
        new { Id = "gioi-thieu",   Icon = "fa-solid fa-circle-info",     Title = "Giới thiệu" },
        new { Id = "thu-thap",     Icon = "fa-solid fa-database",        Title = "Dữ liệu chúng tôi thu thập" },
        new { Id = "muc-dich",     Icon = "fa-solid fa-bullseye",        Title = "Mục đích sử dụng dữ liệu" },
        new { Id = "ai-giong-noi", Icon = "fa-solid fa-microphone",      Title = "Ghi âm và xử lý bằng AI" },
        new { Id = "ben-thu-ba",   Icon = "fa-solid fa-share-nodes",     Title = "Chia sẻ với bên thứ ba" },
        new { Id = "bao-mat",      Icon = "fa-solid fa-shield-halved",   Title = "Bảo mật và lưu trữ" },
        new { Id = "quyen",        Icon = "fa-solid fa-user-shield",     Title = "Quyền của bạn" },
        new { Id = "cookie",       Icon = "fa-solid fa-cookie-bite",     Title = "Cookie" },
        new { Id = "dieu-khoan",   Icon = "fa-solid fa-file-contract",   Title = "Điều khoản sử dụng" },
        new { Id = "thay-doi",     Icon = "fa-solid fa-clock-rotate-left", Title = "Thay đổi chính sách" },
        new { Id = "lien-he",      Icon = "fa-regular fa-envelope",      Title = "Liên hệ" }
    };
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chính sách &amp; Điều khoản - MockviewAI</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/Policy.css" asp-append-version="true">
    <partial name="Partials/_ThemeHead" />
</head>

<body class="app-layout">
    <div class="policy-progress" aria-hidden="true"><span class="policy-progress__bar" data-policy-progress></span></div>

    <partial name="Partials/_AppNavigation" />

    <div class="app-layout__content">
        <main class="page-shell">
            <header class="page-header policy-header">
                <div class="page-header__content">
                    <span class="page-header__eyebrow">PHÁP LÝ</span>
                    <h1 class="page-header__title">Chính sách &amp; Điều khoản</h1>
                    <p class="page-header__description">
                        Cách MockviewAI thu thập, sử dụng và bảo vệ dữ liệu của bạn, cùng các điều khoản khi sử dụng nền tảng luyện phỏng vấn.
                    </p>
                </div>

                <div class="policy-meta">
                    <span class="status-chip">
                        <i class="fa-regular fa-calendar" aria-hidden="true"></i>
                        Cập nhật: @lastUpdated.ToString("dd/MM/yyyy")
                    </span>
                    <span class="status-chip status-chip--success">
                        <i class="fa-regular fa-clock" aria-hidden="true"></i>
                        <span data-policy-read-time>~5 phút đọc</span>
                    </span>
                    <button type="button" class="button button--secondary policy-print" data-policy-print>
                        <i class="fa-solid fa-print" aria-hidden="true"></i>
                        In / Lưu PDF
                    </button>
                </div>
            </header>

            <div class="policy-layout">
                <!-- ---------- Mục lục ---------- -->
                <aside class="policy-aside">
                    <nav class="policy-toc" aria-label="Mục lục chính sách">
                        <button type="button" class="policy-toc__toggle" data-policy-toc-toggle aria-expanded="false" aria-controls="policy-toc-list">
                            <span><i class="fa-solid fa-list-ul" aria-hidden="true"></i> Mục lục</span>
                            <i class="fa-solid fa-chevron-down policy-toc__caret" aria-hidden="true"></i>
                        </button>

                        <span class="policy-toc__title">MỤC LỤC</span>
                        <ol id="policy-toc-list" class="policy-toc__list">
                            @for (var i = 0; i < sections.Length; i++)
                            {
                                <li>
                                    <a class="policy-toc__link" href="#@sections[i].Id" data-policy-toc-link>
                                        <span class="policy-toc__index">@((i + 1).ToString("00"))</span>
                                        <span>@sections[i].Title</span>
                                    </a>
                                </li>
                            }
                        </ol>
                    </nav>
                </aside>

                <!-- ---------- Nội dung ---------- -->
                <article class="policy-content surface-card" data-policy-content>
                    <div class="policy-summary">
                        <div class="policy-summary__icon" aria-hidden="true"><i class="fa-solid fa-lightbulb"></i></div>
                        <div>
                            <strong>Tóm tắt nhanh</strong>
                            <p>Chúng tôi chỉ dùng dữ liệu để vận hành buổi luyện phỏng vấn và đánh giá câu trả lời của bạn. Chúng tôi không bán dữ liệu cá nhân. Bạn có thể yêu cầu xem, sửa hoặc xóa dữ liệu bất cứ lúc nào.</p>
                        </div>
                    </div>

                    <section id="@sections[0].Id" class="policy-section" data-policy-section>
                        <h2 class="policy-section__title"><span class="policy-section__icon"><i class="@sections[0].Icon" aria-hidden="true"></i></span>1. @sections[0].Title</h2>
                        <p>MockviewAI ("chúng tôi") là nền tảng giúp người dùng luyện phỏng vấn với AI trong môi trường mô phỏng. Chính sách này áp dụng cho website, ứng dụng và mọi dịch vụ liên quan của MockviewAI.</p>
                        <p>Khi tạo tài khoản hoặc sử dụng dịch vụ, bạn xác nhận đã đọc và đồng ý với nội dung dưới đây.</p>
                    </section>

                    <section id="@sections[1].Id" class="policy-section" data-policy-section>
                        <h2 class="policy-section__title"><span class="policy-section__icon"><i class="@sections[1].Icon" aria-hidden="true"></i></span>2. @sections[1].Title</h2>
                        <div class="policy-grid">
                            <div class="policy-card">
                                <i class="fa-regular fa-id-card" aria-hidden="true"></i>
                                <strong>Thông tin tài khoản</strong>
                                <p>Họ tên, email, ảnh đại diện (khi đăng nhập bằng Google) và mật khẩu đã được mã hóa.</p>
                            </div>
                            <div class="policy-card">
                                <i class="fa-solid fa-briefcase" aria-hidden="true"></i>
                                <strong>Hồ sơ nghề nghiệp</strong>
                                <p>Vị trí ứng tuyển, cấp độ kinh nghiệm và định hướng nghề nghiệp mà bạn cung cấp.</p>
                            </div>
                            <div class="policy-card">
                                <i class="fa-regular fa-comments" aria-hidden="true"></i>
                                <strong>Nội dung buổi luyện</strong>
                                <p>Câu hỏi, câu trả lời dạng văn bản hoặc giọng nói, điểm số và nhận xét.</p>
                            </div>
                            <div class="policy-card">
                                <i class="fa-solid fa-laptop" aria-hidden="true"></i>
                                <strong>Dữ liệu kỹ thuật</strong>
                                <p>Địa chỉ IP, loại trình duyệt, thời gian truy cập và nhật ký lỗi để đảm bảo an toàn hệ thống.</p>
                            </div>
                        </div>
                    </section>

                    <section id="@sections[2].Id" class="policy-section" data-policy-section>
                        <h2 class="policy-section__title"><span class="policy-section__icon"><i class="@sections[2].Icon" aria-hidden="true"></i></span>3. @sections[2].Title</h2>
                        <ul class="policy-list">
                            <li><i class="fa-solid fa-check" aria-hidden="true"></i>Tạo và cá nhân hóa buổi phỏng vấn theo vị trí bạn chọn.</li>
                            <li><i class="fa-solid fa-check" aria-hidden="true"></i>Chấm điểm, đưa nhận xét và theo dõi tiến độ luyện tập.</li>
                            <li><i class="fa-solid fa-check" aria-hidden="true"></i>Xác thực tài khoản, gửi mã OTP và thông báo quan trọng.</li>
                            <li><i class="fa-solid fa-check" aria-hidden="true"></i>Phát hiện gian lận, spam và bảo vệ hệ thống.</li>
                            <li><i class="fa-solid fa-check" aria-hidden="true"></i>Cải thiện chất lượng sản phẩm dựa trên dữ liệu thống kê đã ẩn danh.</li>
                        </ul>
                        <div class="policy-callout policy-callout--success">
                            <i class="fa-solid fa-hand" aria-hidden="true"></i>
                            <p><strong>Cam kết:</strong> chúng tôi không bán và không cho thuê dữ liệu cá nhân của bạn cho bất kỳ bên nào.</p>
                        </div>
                    </section>

                    <section id="@sections[3].Id" class="policy-section" data-policy-section>
                        <h2 class="policy-section__title"><span class="policy-section__icon"><i class="@sections[3].Icon" aria-hidden="true"></i></span>4. @sections[3].Title</h2>
                        <p>Khi bạn trả lời bằng giọng nói, trình duyệt sẽ xin quyền dùng micro. Bản ghi âm được chuyển thành văn bản để AI phân tích. Bạn có thể tắt micro và trả lời bằng văn bản bất cứ lúc nào.</p>
                        <div class="policy-callout policy-callout--warning">
                            <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                            <p><strong>Lưu ý:</strong> điểm và nhận xét do AI tạo ra chỉ mang tính tham khảo cho việc luyện tập, không thay thế đánh giá của nhà tuyển dụng thật.</p>
                        </div>
                    </section>

                    <section id="@sections[4].Id" class="policy-section" data-policy-section>
                        <h2 class="policy-section__title"><span class="policy-section__icon"><i class="@sections[4].Icon" aria-hidden="true"></i></span>5. @sections[4].Title</h2>
                        <p>Chúng tôi chỉ chia sẻ phần dữ liệu cần thiết với các đối tác kỹ thuật để vận hành dịch vụ:</p>
                        <div class="policy-table-wrap">
                            <table class="policy-table">
                                <thead>
                                    <tr><th scope="col">Dịch vụ</th><th scope="col">Mục đích</th><th scope="col">Dữ liệu liên quan</th></tr>
                                </thead>
                                <tbody>
                                    <tr><td>Google OAuth</td><td>Đăng nhập bằng Google</td><td>Tên, email, ảnh đại diện</td></tr>
                                    <tr><td>Cloudflare Turnstile</td><td>Chống bot khi đăng nhập</td><td>Tín hiệu trình duyệt, IP</td></tr>
                                    <tr><td>Nhà cung cấp mô hình AI</td><td>Tạo câu hỏi, chấm điểm</td><td>Nội dung câu trả lời</td></tr>
                                    <tr><td>Dịch vụ email</td><td>Gửi OTP, thông báo</td><td>Địa chỉ email</td></tr>
                                </tbody>
                            </table>
                        </div>
                        <p>Ngoài các trường hợp trên, chúng tôi chỉ cung cấp dữ liệu khi có yêu cầu hợp pháp từ cơ quan nhà nước có thẩm quyền.</p>
                    </section>

                    <section id="@sections[5].Id" class="policy-section" data-policy-section>
                        <h2 class="policy-section__title"><span class="policy-section__icon"><i class="@sections[5].Icon" aria-hidden="true"></i></span>6. @sections[5].Title</h2>
                        <ul class="policy-list">
                            <li><i class="fa-solid fa-lock" aria-hidden="true"></i>Kết nối được mã hóa bằng HTTPS/TLS.</li>
                            <li><i class="fa-solid fa-key" aria-hidden="true"></i>Mật khẩu được băm (hash), không lưu dạng văn bản thuần.</li>
                            <li><i class="fa-solid fa-user-lock" aria-hidden="true"></i>Chỉ nhân sự được ủy quyền mới truy cập được dữ liệu, và mọi lần truy cập đều được ghi nhật ký.</li>
                            <li><i class="fa-solid fa-box-archive" aria-hidden="true"></i>Dữ liệu được lưu khi tài khoản còn hoạt động và được xóa hoặc ẩn danh sau khi bạn yêu cầu xóa tài khoản.</li>
                        </ul>
                    </section>

                    <section id="@sections[6].Id" class="policy-section" data-policy-section>
                        <h2 class="policy-section__title"><span class="policy-section__icon"><i class="@sections[6].Icon" aria-hidden="true"></i></span>7. @sections[6].Title</h2>
                        <div class="policy-grid policy-grid--3">
                            <div class="policy-card"><i class="fa-regular fa-eye" aria-hidden="true"></i><strong>Truy cập</strong><p>Xem dữ liệu chúng tôi đang lưu về bạn.</p></div>
                            <div class="policy-card"><i class="fa-regular fa-pen-to-square" aria-hidden="true"></i><strong>Chỉnh sửa</strong><p>Cập nhật thông tin trong trang Hồ sơ.</p></div>
                            <div class="policy-card"><i class="fa-regular fa-trash-can" aria-hidden="true"></i><strong>Xóa</strong><p>Yêu cầu xóa tài khoản và lịch sử luyện tập.</p></div>
                        </div>
                        <div class="policy-actions">
                            <a href="/Profile" class="button button--secondary"><i class="fa-regular fa-user" aria-hidden="true"></i> Đến trang Hồ sơ</a>
                        </div>
                    </section>

                    <section id="@sections[7].Id" class="policy-section" data-policy-section>
                        <h2 class="policy-section__title"><span class="policy-section__icon"><i class="@sections[7].Icon" aria-hidden="true"></i></span>8. @sections[7].Title</h2>
                        <p>Chúng tôi dùng cookie <strong>bắt buộc</strong> để duy trì phiên đăng nhập và chống giả mạo yêu cầu (anti-forgery), cùng bộ nhớ trình duyệt để ghi nhớ giao diện sáng/tối bạn chọn. Nếu tắt cookie, một số chức năng như đăng nhập sẽ không hoạt động.</p>
                    </section>

                    <section id="@sections[8].Id" class="policy-section" data-policy-section>
                        <h2 class="policy-section__title"><span class="policy-section__icon"><i class="@sections[8].Icon" aria-hidden="true"></i></span>9. @sections[8].Title</h2>
                        <p>Khi sử dụng MockviewAI, bạn đồng ý:</p>
                        <ul class="policy-list policy-list--danger">
                            <li><i class="fa-solid fa-xmark" aria-hidden="true"></i>Không chia sẻ tài khoản hoặc dùng tài khoản của người khác.</li>
                            <li><i class="fa-solid fa-xmark" aria-hidden="true"></i>Không gửi nội dung vi phạm pháp luật, xúc phạm hoặc chứa mã độc.</li>
                            <li><i class="fa-solid fa-xmark" aria-hidden="true"></i>Không khai thác lỗ hổng, tấn công hoặc thu thập dữ liệu tự động từ hệ thống.</li>
                        </ul>
                        <p>Chúng tôi có quyền tạm khóa tài khoản vi phạm. Trước khi khóa, chúng tôi sẽ thông báo nếu điều kiện cho phép.</p>
                    </section>

                    <section id="@sections[9].Id" class="policy-section" data-policy-section>
                        <h2 class="policy-section__title"><span class="policy-section__icon"><i class="@sections[9].Icon" aria-hidden="true"></i></span>10. @sections[9].Title</h2>
                        <p>Chính sách có thể được cập nhật khi tính năng hoặc quy định pháp luật thay đổi. Ngày cập nhật gần nhất luôn hiển thị ở đầu trang. Khi có thay đổi quan trọng, chúng tôi sẽ thông báo qua email hoặc ngay trên ứng dụng.</p>
                    </section>

                    <section id="@sections[10].Id" class="policy-section" data-policy-section>
                        <h2 class="policy-section__title"><span class="policy-section__icon"><i class="@sections[10].Icon" aria-hidden="true"></i></span>11. @sections[10].Title</h2>
                        <p>Nếu bạn có câu hỏi hoặc muốn thực hiện quyền đối với dữ liệu của mình, hãy liên hệ:</p>
                        <div class="policy-contact">
                            <a class="action-card" href="mailto:@supportEmail">
                                <div class="action-card__icon" aria-hidden="true"><i class="fa-regular fa-envelope"></i></div>
                                <div class="action-card__content">
                                    <span class="action-card__eyebrow">EMAIL</span>
                                    <h3 class="action-card__title">@supportEmail</h3>
                                    <p class="action-card__description">Phản hồi trong 3–5 ngày làm việc.</p>
                                </div>
                                <span class="action-card__chevron" aria-hidden="true"><i class="fa-solid fa-chevron-right"></i></span>
                            </a>
                            <a class="action-card" href="/Feedback">
                                <div class="action-card__icon" aria-hidden="true"><i class="fa-solid fa-wand-magic-sparkles"></i></div>
                                <div class="action-card__content">
                                    <span class="action-card__eyebrow">GÓP Ý</span>
                                    <h3 class="action-card__title">Gửi ý kiến</h3>
                                    <p class="action-card__description">Góp ý trực tiếp trên MockviewAI.</p>
                                </div>
                                <span class="action-card__chevron" aria-hidden="true"><i class="fa-solid fa-chevron-right"></i></span>
                            </a>
                        </div>
                    </section>
                </article>
            </div>
        </main>
    </div>

    <button type="button" class="policy-top" data-policy-top aria-label="Lên đầu trang" hidden>
        <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
    </button>

    <partial name="Partials/_AppFooter" />
    <partial name="Partials/_Notify" />

    <script src="~/js/Policy.js" asp-append-version="true" defer></script>
</body>
</html>
