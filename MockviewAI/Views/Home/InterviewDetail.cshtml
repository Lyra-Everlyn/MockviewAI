@model MockviewAI.Models.ViewModels.InterviewDetailViewModel
@{
    Layout = null;
    ViewData["ActiveNav"] = "history";   // mục sáng trên thanh menu dùng chung
    var m = Model;
    // [UI-DARK] Màu ô người phỏng vấn theo tên (Linh / Nam / An)
    var faceClass = m.InterviewerName switch { "Nam" => "f-nam", "An" => "f-an", _ => "" };
    var faceLetter = string.IsNullOrEmpty(m.InterviewerName) ? "?" : m.InterviewerName.Substring(0, 1).ToUpper();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Xem lại hội thoại - MockviewAI</title>

    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/themes/theme-indigo.css" asp-append-version="true" />

    @* [UI-DARK] Đợt 4 (02/11): giao diện tối "phòng thu". Bản sáng cũ: InterviewDetail.css + theme.css *@
    <link rel="stylesheet" href="~/css/studio.css">
    <link rel="stylesheet" href="~/css/studio-detail.css">
</head>
<body class="studio">
    <partial name="Partials/_AppNavigation" />

    <main class="wrap">
        <a href="/Home/History" class="back-link">&lsaquo; Lịch sử</a>
        <h1>Xem lại hội thoại</h1>
        <p class="sub">@m.Position &middot; @m.InterviewerName &middot; @m.StartedAt.ToString("dd/MM") &middot; @m.QuestionCount câu &middot; toàn bộ hội thoại được lưu lại
            @if (m.IsLive) { <span class="mode-tag">Thực chiến</span> }</p>

        <!-- Tóm tắt điểm + hành động -->
        <section class="panel summary-strip" aria-label="Tóm tắt buổi luyện">
            <div class="stat"><span class="label">Điểm tham khảo</span><b>@(m.HasScore ? m.TotalScore.ToString() : "—")</b></div>
            <div class="stat"><span class="label">Nội dung</span><b>@(m.HasScore && m.HasContentScore ? m.ContentScore.ToString() : "—")</b></div>
            <div class="stat"><span class="label">Cách nói</span><b>@(m.HasScore ? m.DeliveryScore.ToString() : "—")</b></div>
            @if (m.AnxietyIndicator > 0)
            {
                <div class="stat"><span class="label">Dấu hiệu lo lắng</span><b>@m.AnxietyIndicator<small>/10</small></b></div>
            }
            <div class="strip-acts">
                <a href="/Interview/Create" class="btn btn-ghost">Luyện lại vị trí này</a>
                <form method="post" asp-controller="Home" asp-action="DeleteSession" asp-route-id="@m.SessionId"
                      onsubmit="return confirm('Xoá buổi luyện này? Không thể khôi phục.');">
                    <button type="submit" class="btn btn-stop">Xoá buổi này</button>
                </form>
            </div>
        </section>

        <div class="layout">
            <!-- Danh sách câu (chấm màu theo nhãn) -->
            <nav class="index" aria-label="Danh sách câu">
                @foreach (var t in m.Turns)
                {
                    var dot = t.InvalidReason != null ? "bg-sai" : t.Category != null ? "bg-" + t.Category : "dot-none";
                    <a href="#cau-@t.Number"><span class="dot @dot"></span><span class="idx-text">Câu @t.Number@(t.FollowUp != null ? " +" : "")<span class="idx-q"> · @t.Question</span></span></a>
                }
            </nav>

            <div class="turns">
                @if (!m.Turns.Any())
                {
                    <p class="note info">Bạn đã dừng buổi này trước khi trả lời câu nào.</p>
                }
                @foreach (var t in m.Turns)
                {
                    <article class="turn" id="cau-@t.Number">
                        <div class="asker"><span class="face sm @faceClass">@faceLetter</span><span class="qno">Câu @t.Number · @m.InterviewerName hỏi</span></div>
                        <p class="q">@t.Question</p>
                        <p class="mine @(t.Skipped ? "skipped" : "")">@(t.Skipped ? "(Đã bỏ qua câu này)" : t.Answer)</p>
                        @if (!string.IsNullOrEmpty(t.VoiceText))
                        {
                            <p class="voice-line">@t.VoiceText</p>   @* [VOICE] Đợt 7 *@
                        }

                        @if (t.FollowUp != null)
                        {
                            <!-- [FOLLOW-UP] Đợt 8: người phỏng vấn hỏi thêm vì câu trả lời còn thiếu ý -->
                            <div class="followup">
                                <div class="asker"><span class="face sm @faceClass">@faceLetter</span><span class="qno">@m.InterviewerName hỏi thêm</span></div>
                                @if (!string.IsNullOrEmpty(t.FollowUpPointText))
                                {
                                    <p class="followup-why">Vì câu trả lời đầu chưa thấy ý: @t.FollowUpPointText</p>
                                }
                                <p class="q q-sm">@t.FollowUp.Question</p>
                                <p class="mine @(t.FollowUp.Skipped ? "skipped" : "")">@(t.FollowUp.Skipped ? "(Đã bỏ qua câu hỏi thêm)" : t.FollowUp.Answer)</p>
                                @if (!string.IsNullOrEmpty(t.FollowUp.VoiceText))
                                {
                                    <p class="voice-line">@t.FollowUp.VoiceText</p>
                                }
                                @if (t.FollowUp.InvalidReason != null)
                                {
                                    <p class="why">Câu trả lời thêm chưa có ý nghĩa nên không được tính vào câu này.</p>
                                }
                            </div>
                        }

                        @if (t.InvalidReason != null)
                        {
                            <div class="verdict is-sai">
                                <span class="tag is-sai">✗ Tính sai (0 điểm)</span>
                                <p class="why">@t.InvalidReason</p>
                            </div>
                        }
                        else if (t.Category != null)
                        {
                            <!-- [QUESTION-BANK] Xếp loại câu này theo bộ đề -->
                            <div class="verdict is-@t.Category">
                                <div class="verdict-head">
                                    <span class="tag is-@t.Category">@t.CategoryIcon @t.CategoryName</span>
                                    @if (!string.IsNullOrEmpty(t.MatchedPathText))
                                    {
                                        <span class="path">@t.MatchedPathText</span>
                                    }
                                </div>
                                <p class="desc">@t.CategoryDescription</p>
                                @if (!string.IsNullOrEmpty(t.Feedback))
                                {
                                    <p class="why">@t.Feedback</p>
                                }
                                @if (t.MetPoints.Any() || t.MissingPoints.Any())
                                {
                                    <ul class="points">
                                        @foreach (var point in t.MetPoints) { <li class="met">✓ @point</li> }
                                        @foreach (var point in t.MissingPoints) { <li class="miss">✗ @point</li> }
                                    </ul>
                                }
                            </div>
                        }
                    </article>
                }

                <!-- Nhận xét chung của AI -->
                <section class="panel ai-feedback">
                    <h2>Nhận xét chung</h2>
                    <p>@(m.HasScore ? m.AiSummary : "Buổi này chưa được chấm điểm vì bạn dừng trước khi trả lời. Hãy luyện lại để nhận nhận xét của AI.")</p>
                    @if (m.Improvements.Any())
                    {
                        <ul>@foreach (var tip in m.Improvements) { <li>@tip</li> }</ul>
                    }
                </section>
            </div>
        </div>
    </main>

    <nav class="mobile-bottom-nav" aria-label="Điều hướng">
        <a href="/Home">Trang chủ</a>
        <a href="/Interview/Create">Luyện</a>
        <a href="/Interview/Create?mode=live">Thực chiến</a>
        <a href="/Home/History" class="active">Lịch sử</a>
        <a href="/Profile">Hồ sơ</a>
    </nav>
    <partial name="Partials/_Notify" />
</body>
</html>
