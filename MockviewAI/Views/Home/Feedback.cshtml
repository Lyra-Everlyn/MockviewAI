@{
    Layout = null; 
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Góp ý - MockviewAI</title>
    <link rel="stylesheet" href="gopY.css">
</head>
<body>
    <!-- THANH ĐIỀU HƯỚNG MÁY TÍNH -->
    <nav class="desktop-nav hide-on-mobile">
        <div class="nav-container">
            <div class="nav-left">
                <div class="logo">Mockview<span>AI</span></div>
                <ul class="nav-links">
                    <li><a href="#">Trang chủ</a></li>
                    <li><a href="#">Luyện tập</a></li>
                    <li><a href="#">Lịch sử</a></li>
                </ul>
            </div>
            <div class="nav-right">
                <span class="badge badge-v1">BETA</span>
                <div class="avatar">Q</div>
            </div>
        </div>
    </nav>

    <!-- NỘI DUNG CHÍNH -->
    <main class="feedback-wrapper">
        <div class="feedback-container">
            
            <!-- Nút Quay lại Trang chủ (Chỉ hiện trên Điện thoại) -->
            <a href="#" class="back-link hide-on-desktop">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                Trang chủ
            </a>

            <!-- Phần Tiêu đề -->
            <div class="header-section">
                <span class="badge badge-v1">BETA</span>
                <h1>Bạn thấy MockviewAI thế nào?</h1>
                <p class="subtitle">Góp ý của bạn giúp nhóm làm phiên bản sau tốt hơn. Mất khoảng 2 phút.</p>
            </div>

            <!-- Khối Lưới 2 Cột -->
            <div class="feedback-grid">
                
                <!-- Box 1: Đánh giá Sao -->
                <div class="feedback-box">
                    <label class="box-label">Ứng dụng có dễ dùng không?</label>
                    <div class="stars-group">
                        <!-- 4 Sao vàng, 1 Sao xám -->
                        <svg class="star active" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                        <svg class="star active" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                        <svg class="star active" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                        <svg class="star active" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                        <svg class="star inactive" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                    </div>
                </div>

                <!-- Box 2: Lựa chọn Mức độ -->
                <div class="feedback-box">
                    <label class="box-label">Buổi luyện có giúp bạn bớt lo lắng không?</label>
                    <div class="segment-group">
                        <input type="radio" id="opt-co" name="anxiety" checked>
                        <label for="opt-co">Có</label>
                        
                        <input type="radio" id="opt-mot-chut" name="anxiety">
                        <label for="opt-mot-chut">Một chút</label>
                        
                        <input type="radio" id="opt-khong" name="anxiety">
                        <label for="opt-khong">Không</label>
                    </div>
                </div>
            </div>

            <!-- Khối Nhập văn bản Góp ý -->
            <div class="textarea-group">
                <label class="box-label">Bạn muốn nhóm cải thiện điều gì?</label>
                <textarea placeholder="Viết góp ý của bạn..."></textarea>
            </div>

            <!-- Nút Gửi -->
            <button class="btn-submit">Gửi góp ý</button>

        </div>
    </main>
</body>
</html>