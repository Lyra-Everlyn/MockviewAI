@{
    Layout = null;
    ViewData["ActiveNav"] = "";
    const int DefaultRating = 5;
    var ratingLabels = new[] { "", "Khó sử dụng", "Hơi khó sử dụng", "Tạm ổn", "Khá dễ sử dụng", "Rất dễ sử dụng" };
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Góp ý - MockviewAI</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/Feedback.css" asp-append-version="true">
    <partial name="Partials/_ThemeHead" />
</head>
<body>
    <partial name="Partials/_AppNavigation" />

    <main class="page-shell feedback-page">
        <a href="/Home" class="feedback-back">
            <i class="fa-solid fa-chevron-left" aria-hidden="true"></i> Quay lại trang chủ
        </a>

        @* #region Banner *@
        <section class="profile-banner feedback-banner" aria-labelledby="feedback-title">
            <div class="profile-banner__identity">
                <span class="profile-banner__label">Góp ý</span>
                <h1 id="feedback-title" class="profile-banner__name">Bạn thấy MockviewAI thế nào?</h1>
                <p class="profile-banner__status">Ba câu hỏi ngắn, khoảng 2 phút. Góp ý của bạn giúp nhóm cải thiện các buổi luyện phỏng vấn ở phiên bản sau.</p>
            </div>
        </section>
        @* #endregion *@

        <form class="feedback-form" method="post" asp-controller="Home" asp-action="Feedback">
            @Html.AntiForgeryToken()

            @* #region Câu 1: số sao *@
            <section class="feedback-q" aria-labelledby="question-ease">
                <div class="feedback-q__head">
                    <span class="feedback-q__num" aria-hidden="true">1</span>
                    <div>
                        <h2 id="question-ease" class="feedback-q__title">Ứng dụng có dễ dùng không?</h2>
                        <p class="feedback-q__hint">Chọn từ 1 đến 5 sao.</p>
                    </div>
                </div>
                <fieldset class="feedback-stars">
                    <legend class="visually-hidden">Mức độ dễ sử dụng</legend>
                    @for (int rating = 1; rating <= 5; rating++)
                    {
                        <label class="feedback-star">
                            <input class="visually-hidden" type="radio" name="easeRating" value="@rating" @(rating == DefaultRating ? "checked" : null) aria-label="@rating sao: @ratingLabels[rating]" />
                            <i class="fa-solid fa-star" aria-hidden="true"></i>
                        </label>
                    }
                    <span class="feedback-stars__caption" aria-live="polite">
                        <strong id="rating-label">@ratingLabels[DefaultRating]</strong>
                        <span id="rating-value">@DefaultRating/5</span>
                    </span>
                </fieldset>
            </section>
            @* #endregion *@

            @* #region Câu 2: bớt lo lắng *@
            <section class="feedback-q" aria-labelledby="question-anxiety">
                <div class="feedback-q__head">
                    <span class="feedback-q__num" aria-hidden="true">2</span>
                    <div>
                        <h2 id="question-anxiety" class="feedback-q__title">Buổi luyện có giúp bạn bớt lo lắng không?</h2>
                        <p class="feedback-q__hint">Chọn câu trả lời gần nhất với cảm nhận của bạn.</p>
                    </div>
                </div>
                <fieldset class="feedback-choices">
                    <legend class="visually-hidden">Mức độ bớt lo lắng</legend>

                    <input class="visually-hidden" type="radio" id="opt-co" name="anxietyHelp" value="Có" checked>
                    <label class="feedback-choice" for="opt-co">
                        <i class="feedback-choice__face fa-regular fa-face-smile" aria-hidden="true"></i>
                        <span class="feedback-choice__text"><strong>Có</strong><small>Cảm thấy tự tin hơn</small></span>
                        <span class="feedback-choice__check" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
                    </label>

                    <input class="visually-hidden" type="radio" id="opt-mot-chut" name="anxietyHelp" value="Một chút">
                    <label class="feedback-choice" for="opt-mot-chut">
                        <i class="feedback-choice__face fa-regular fa-face-meh" aria-hidden="true"></i>
                        <span class="feedback-choice__text"><strong>Một chút</strong><small>Có cải thiện nhưng chưa nhiều</small></span>
                        <span class="feedback-choice__check" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
                    </label>

                    <input class="visually-hidden" type="radio" id="opt-khong" name="anxietyHelp" value="Không">
                    <label class="feedback-choice" for="opt-khong">
                        <i class="feedback-choice__face fa-regular fa-face-frown" aria-hidden="true"></i>
                        <span class="feedback-choice__text"><strong>Không</strong><small>Chưa cảm nhận được thay đổi</small></span>
                        <span class="feedback-choice__check" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
                    </label>
                </fieldset>
            </section>
            @* #endregion *@

            @* #region Câu 3: góp ý tự do *@
            <section class="feedback-q" aria-labelledby="question-comment">
                <div class="feedback-q__head">
                    <span class="feedback-q__num" aria-hidden="true">3</span>
                    <div>
                        <h2 id="question-comment" class="feedback-q__title">Bạn muốn nhóm cải thiện điều gì?</h2>
                        <p class="feedback-q__hint">Không bắt buộc. Viết điều bạn thấy chưa ổn, khó dùng hoặc còn thiếu.</p>
                    </div>
                </div>
                <div class="feedback-comment">
                    <label class="visually-hidden" for="feedback-comment">Góp ý của bạn</label>
                    <textarea class="feedback-comment__input" id="feedback-comment" name="comment" maxlength="1000" aria-describedby="feedback-comment-help" placeholder="Ví dụ: Tôi muốn phần kết quả giải thích rõ hơn vì sao câu trả lời bị trừ điểm..."></textarea>
                    <div class="feedback-comment__footer">
                        <span id="feedback-comment-help">Góp ý càng cụ thể, nhóm càng dễ xử lý.</span>
                        <span><strong id="char-count">0</strong>/1000</span>
                    </div>
                </div>
            </section>
            @* #endregion *@

            <div class="feedback-actions">
                <a href="/Home" class="button button--secondary">Để sau</a>
                <button type="submit" class="button button--primary button--icon">
                    <span class="button__icon" aria-hidden="true"><i class="fa-solid fa-paper-plane"></i></span>
                    Gửi góp ý
                </button>
            </div>
        </form>
    </main>

    <partial name="Partials/_Notify" />

    <script src="~/js/Feedback.js" asp-append-version="true"></script>
</body>
</html>
