@{
    Layout = null;
    ViewData["ActiveNav"] = "";
    var userName = User.Identity?.Name ?? "";
    var initial = string.IsNullOrWhiteSpace(userName) ? "?" : userName.Substring(0, 1).ToUpper();
    var avatarUrl = User.FindFirst("AvatarUrl")?.Value;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Góp ý - MockviewAI</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/Feedback.css">
    <link rel="stylesheet" href="~/css/theme.css">
</head>
<body>
    <partial name="Partials/_TopNav" />

    <main class="feedback-page">
        <header class="page-heading">
            <h1 class="page-title">Góp ý trải nghiệm</h1>
            <p class="page-description">
                Chia sẻ cảm nhận của bạn để nhóm cải thiện trải nghiệm luyện phỏng vấn ở các phiên bản tiếp theo.
            </p>
        </header>

        <div class="feedback-layout">
            <aside class="feedback-intro-card">
                <div class="intro-icon">
                    <i class="bi bi-stars" aria-hidden="true"></i>
                </div>

                <span class="section-kicker">VER: 2.0.0</span>
                <h2>Ý kiến của bạn rất quan trọng</h2>
                <p>
                    Phiếu góp ý này chỉ mất khoảng 2 phút. Mỗi phản hồi đều giúp MockviewAI hoàn thiện hơn.
                </p>

                <div class="intro-divider"></div>

                <div class="intro-points">
                    <div class="intro-point">
                        <span class="intro-point-icon"><i class="bi bi-clock"></i></span>
                        <div>
                            <strong>Nhanh gọn</strong>
                            <span>Chỉ vài câu hỏi ngắn.</span>
                        </div>
                    </div>

                    <div class="intro-point">
                        <span class="intro-point-icon"><i class="bi bi-chat-square-text"></i></span>
                        <div>
                            <strong>Phản hồi thực tế</strong>
                            <span>Tập trung vào trải nghiệm của bạn.</span>
                        </div>
                    </div>

                    <div class="intro-point">
                        <span class="intro-point-icon"><i class="bi bi-wrench-adjustable-circle"></i></span>
                        <div>
                            <strong>Giúp sản phẩm tốt hơn</strong>
                            <span>Dùng làm cơ sở cho các cải tiến tiếp theo.</span>
                        </div>
                    </div>
                </div>
            </aside>

            <form class="feedback-card" method="post" asp-controller="Home" asp-action="Feedback">
                <div class="feedback-card-header">
                    <span class="eyebrow">ĐÁNH GIÁ NHANH</span>
                    <h2>Bạn thấy MockviewAI thế nào?</h2>
                    <p>Chọn mức phù hợp nhất với trải nghiệm gần đây của bạn.</p>
                </div>

                <section class="feedback-section">
                    <div class="question-heading">
                        <span class="question-icon">
                            <i class="bi bi-hand-thumbs-up"></i>
                        </span>
                        <div>
                            <h3>Ứng dụng có dễ dùng không?</h3>
                            <p>Đánh giá từ 1 đến 5 sao.</p>
                        </div>
                    </div>

                    <div class="rating-card">
                        <input type="hidden" name="easeRating" id="ease-rating" value="4">

                        <div class="stars-group" role="radiogroup" aria-label="Đánh giá mức độ dễ sử dụng">
                            <button type="button" class="star-btn active" data-value="1" aria-label="1 sao">
                                <i class="bi bi-star-fill"></i>
                            </button>
                            <button type="button" class="star-btn active" data-value="2" aria-label="2 sao">
                                <i class="bi bi-star-fill"></i>
                            </button>
                            <button type="button" class="star-btn active" data-value="3" aria-label="3 sao">
                                <i class="bi bi-star-fill"></i>
                            </button>
                            <button type="button" class="star-btn active" data-value="4" aria-label="4 sao">
                                <i class="bi bi-star-fill"></i>
                            </button>
                            <button type="button" class="star-btn" data-value="5" aria-label="5 sao">
                                <i class="bi bi-star-fill"></i>
                            </button>
                        </div>

                        <div class="rating-copy">
                            <strong id="rating-label">Khá dễ sử dụng</strong>
                            <span id="rating-value">4/5</span>
                        </div>
                    </div>
                </section>

                <div class="section-divider"></div>

                <section class="feedback-section">
                    <div class="question-heading">
                        <span class="question-icon">
                            <i class="bi bi-activity"></i>
                        </span>
                        <div>
                            <h3>Buổi luyện có giúp bạn bớt lo lắng không?</h3>
                            <p>Chọn câu trả lời gần nhất với cảm nhận của bạn.</p>
                        </div>
                    </div>

                    <div class="choice-group">
                        <input type="radio" id="opt-co" name="anxietyHelp" value="Có" checked>
                        <label for="opt-co" class="choice-option">
                            <span class="choice-icon"><i class="bi bi-emoji-smile"></i></span>
                            <span class="choice-copy">
                                <strong>Có</strong>
                                <small>Cảm thấy tự tin hơn</small>
                            </span>
                            <span class="choice-check"><i class="bi bi-check-lg"></i></span>
                        </label>

                        <input type="radio" id="opt-mot-chut" name="anxietyHelp" value="Một chút">
                        <label for="opt-mot-chut" class="choice-option">
                            <span class="choice-icon"><i class="bi bi-emoji-neutral"></i></span>
                            <span class="choice-copy">
                                <strong>Một chút</strong>
                                <small>Có cải thiện nhưng chưa nhiều</small>
                            </span>
                            <span class="choice-check"><i class="bi bi-check-lg"></i></span>
                        </label>

                        <input type="radio" id="opt-khong" name="anxietyHelp" value="Không">
                        <label for="opt-khong" class="choice-option">
                            <span class="choice-icon"><i class="bi bi-emoji-frown"></i></span>
                            <span class="choice-copy">
                                <strong>Không</strong>
                                <small>Chưa cảm nhận được thay đổi</small>
                            </span>
                            <span class="choice-check"><i class="bi bi-check-lg"></i></span>
                        </label>
                    </div>
                </section>

                <div class="section-divider"></div>

                <section class="feedback-section">
                    <div class="question-heading">
                        <span class="question-icon">
                            <i class="bi bi-chat-left-text"></i>
                        </span>
                        <div>
                            <h3>Bạn muốn đội ngũ MockviewAI cải thiện điều gì?</h3>
                            <p>Viết điều bạn thấy chưa ổn, khó dùng hoặc còn thiếu.</p>
                        </div>
                    </div>

                    <div class="textarea-wrap">
                        <textarea id="feedback-comment"
                                  name="comment"
                                  maxlength="1000"
                                  placeholder="Ví dụ: Tôi muốn phần kết quả giải thích rõ hơn vì sao câu trả lời bị trừ điểm..."></textarea>

                        <div class="textarea-footer">
                            <span>Phản hồi cụ thể sẽ giúp nhóm xử lý tốt hơn.</span>
                            <span><strong id="char-count">0</strong>/1000</span>
                        </div>
                    </div>
                </section>

                <div class="form-actions">
                    <a href="/Home" class="btn btn-secondary">Để sau</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-send" aria-hidden="true"></i>
                        Gửi góp ý
                    </button>
                </div>
            </form>
        </div>
    </main>

    <script>
            const ratingLabels = {
                  1: 'Khó sử dụng',
                        2: 'Hơi khó sử dụng',

                3: 'Tạm ổn',
            4: 'Khá dễ sử dụng',
                5: 'Rất dễ sử dụng'
                    };
                const ratingInput = document.getElementById('ease-rating');
                    const ratingLabel = document.getElementById('rating-label');
                    const ratingValue = document.getElementById('rating-value');
                    const stars = document.querySelectorAll('.star-btn');

                    stars.forEach(function (star) {
                        star.addEventListener('click', function () {
                    const value = Number(this.dataset.value);
                            ratingInput.value = value;
                            ratingLabel.textContent = ratingLabels[value];
                            ratingValue.textContent = value + '/5';

                            stars.forEach(function (item) {
                                item.classList.toggle('active', Number(item.dataset.value) <= value);
                            });
                        });
                    });

                    const textarea = document.getElementById('feedback-comment');
                    const charCount = document.getElementById('char-count');

                    textarea.addEventListener('input', function () {
                        charCount.textContent = this.value.length;
                    });
    </script>

    <partial name="Partials/_Notify" />
</body>
</html>
