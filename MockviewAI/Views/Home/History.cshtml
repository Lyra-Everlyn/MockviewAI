@model List<MockviewAI.Models.ViewModels.RecentSessionViewModel>
@{
    Layout = null;
    // Chữ cái đầu của tên người đang đăng nhập (hiện trên avatar góc phải)
    var userName = User.Identity?.Name ?? "";
    var initial = string.IsNullOrWhiteSpace(userName) ? "?" : userName.Substring(0, 1).ToUpper();
    // Ảnh Google của tài khoản (nếu có), không có thì hiện chữ cái đầu
    var avatarUrl = User.FindFirst("AvatarUrl")?.Value;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lịch sử luyện tập - MockviewAI</title>
    <link rel="stylesheet" href="~/css/History.css">
</head>
<body>
    <!-- THANH ĐIỀU HƯỚNG MÁY TÍNH -->
    <nav class="desktop-nav hide-on-mobile">
        <div class="nav-container">
            <div class="nav-left">
                <div class="logo">Mockview<span>AI</span></div>
                <ul class="nav-links">
                    <li><a href="/Home">Trang chủ</a></li>
                    <li><a href="/Interview/Create">Luyện tập</a></li>
                    <li><a href="/Home/History" class="active">Lịch sử</a></li>
                </ul>
            </div>
            <div class="nav-right">
                <span class="badge badge-v1">BETA</span>
                <div class="avatar" style="cursor: pointer;" title="Hồ sơ" onclick="location.href='/Profile'">@if (!string.IsNullOrEmpty(avatarUrl)) { <img src="@avatarUrl" alt="" referrerpolicy="no-referrer" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;" /> } else { @initial }</div>
            </div>
        </div>
    </nav>

    <!-- NỘI DUNG CHÍNH -->
    <main class="history-page">
        <div class="main-card">
            
            <!-- Nút Quay lại -->
            <div class="back-link-wrapper">
                <a href="/Profile" class="back-link">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                    Hồ sơ
                </a>
            </div>

            <!-- Header (Tiêu đề + Ô tìm kiếm) -->
            <div class="header-flex">
                <div class="title-area">
                    <h1>Lịch sử luyện tập</h1>
                    <p>@Model.Count buổi &middot; bấm vào một buổi để xem lại hội thoại</p>
                </div>
                <div class="search-area">
                    <label>Tìm theo vị trí</label>
                    <input type="text" id="history-search" placeholder="VD: Lập trình viên">
                </div>
            </div>

            <!-- Lưới Danh sách Lịch sử -->
            <div class="history-grid">
                @if (!Model.Any())
                {
                    <p>Bạn chưa có buổi luyện nào. <a href="/Interview/Create">Bắt đầu buổi đầu tiên</a></p>
                }
                @foreach (var s in Model)
                {
                    <div class="history-card" style="cursor: pointer;" data-role="@s.RoleName"
                         onclick="location.href='@(s.IsInProgress ? "/Interview/Room/" + s.SessionId : "/Home/InterviewDetail/" + s.SessionId)'">
                        <div class="card-top">
                            <span class="role">@s.RoleName</span>
                            <span class="date">@s.DateFormatted &middot; @s.QuestionCount câu</span>
                        </div>
                        <div class="card-badges">
                            <span class="badge-score">@(s.HasScore ? s.Score + " điểm" : s.StatusText)</span>
                            @if (!string.IsNullOrEmpty(s.AnxietyText))
                            {
                                <span class="@(s.AnxietyImproved ? "badge-anxiety-good" : "badge-anxiety-warn")">@s.AnxietyText</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </main>

    <!-- THANH ĐIỀU HƯỚNG DƯỚI ĐÁY CHO ĐIỆN THOẠI -->
    <nav class="mobile-nav hide-on-desktop">
        <a href="/Home" class="nav-item">
            <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
            <span>Trang chủ</span>
        </a>
        <a href="/Interview/Create" class="nav-item">
            <svg viewBox="0 0 24 24"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path></svg>
            <span>Luyện tập</span>
        </a>
        <a href="/Home/History" class="nav-item active">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            <span>Lịch sử</span>
        </a>
        <a href="/Profile" class="nav-item">
            <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            <span>Hồ sơ</span>
        </a>
    </nav>
    <script>
        // Lọc thẻ theo vị trí ngay trên trình duyệt
        document.getElementById('history-search').addEventListener('input', function () {
            var q = this.value.trim().toLowerCase();
            document.querySelectorAll('.history-card').forEach(function (card) {
                card.style.display = card.dataset.role.toLowerCase().includes(q) ? '' : 'none';
            });
        });
    </script>
    <partial name="Partials/_Notify" />
</body>
</html>