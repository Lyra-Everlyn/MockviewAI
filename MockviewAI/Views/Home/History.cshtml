@model List<MockviewAI.Models.ViewModels.RecentSessionViewModel>

@{
    Layout = null;
    ViewData["ActiveNav"] = "history";
    var sessions = Model ?? new List<MockviewAI.Models.ViewModels.RecentSessionViewModel>();

    // Trạng thái dùng cho viên lọc: scored (đã chấm), progress (chưa xong), stopped (đã dừng)
    string StateOf(MockviewAI.Models.ViewModels.RecentSessionViewModel s) => s.HasScore ? "scored" : s.IsInProgress ? "progress" : "stopped";
    var filters = new[]
    {
        (Key: "all", Label: "Tất cả", Count: sessions.Count),
        (Key: "scored", Label: "Đã chấm", Count: sessions.Count(s => s.HasScore)),
        (Key: "progress", Label: "Chưa xong", Count: sessions.Count(s => s.IsInProgress)),
        (Key: "live", Label: "Thực chiến", Count: sessions.Count(s => s.IsLive))
    };
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lịch sử luyện tập - MockviewAI</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/History.css" asp-append-version="true">
    <partial name="Partials/_ThemeHead" />
    <script src="~/js/History.js" asp-append-version="true" defer></script>
</head>
<body>
    <partial name="Partials/_AppNavigation" />

    <main class="page-shell history-page">
        <h1 class="visually-hidden">Lịch sử luyện tập</h1>

        @if (!sessions.Any())
        {
            <section class="history-empty">
                <h2>Chưa có buổi luyện nào</h2>
                <p>Bắt đầu một buổi phỏng vấn để lịch sử luyện tập xuất hiện ở đây.</p>
                <a class="button button--primary button--icon" href="/Interview/Create">
                    <span class="button__icon" aria-hidden="true"><i class="fa-solid fa-microphone"></i></span>
                    Bắt đầu luyện tập
                </a>
            </section>
        }
        else
        {
            @* #region Thanh công cụ: tìm + lọc *@
            <div class="history-toolbar">
                <label class="history-search">
                    <span class="visually-hidden">Tìm theo vị trí</span>
                    <i class="fa-solid fa-magnifying-glass history-search__icon" aria-hidden="true"></i>
                    <input class="history-search__input" type="search" id="history-search"
                           placeholder="Tìm theo vị trí, ví dụ Lập trình viên" autocomplete="off" aria-controls="history-list" />
                </label>

                <div class="history-filters" role="group" aria-label="Lọc buổi luyện">
                    @foreach (var f in filters)
                    {
                        <button type="button" class="history-filter @(f.Key == "all" ? "is-active" : null)"
                                data-filter="@f.Key" aria-pressed="@(f.Key == "all" ? "true" : "false")">
                            @f.Label <span class="history-filter__count">@f.Count</span>
                        </button>
                    }
                </div>

                <span class="history-count" id="history-count" aria-live="polite">@sessions.Count buổi luyện</span>
            </div>
            @* #endregion *@

            <ul class="history-list" id="history-list">
                @foreach (var session in sessions)
                {
                    <li class="history-entry" data-role="@session.RoleName" data-state="@StateOf(session)" data-live="@(session.IsLive ? "true" : "false")">
                        <partial name="Partials/_SessionCard" model="session" />
                    </li>
                }
            </ul>

            <section class="history-empty" id="history-no-results" hidden role="status">
                <h2>Không có buổi luyện phù hợp</h2>
                <p>Thử từ khoá khác hoặc chọn "Tất cả".</p>
                <button type="button" class="button button--secondary" id="history-clear">Xoá tìm kiếm và bộ lọc</button>
            </section>
        }
    </main>

    <partial name="Partials/_Notify" />
</body>
</html>
