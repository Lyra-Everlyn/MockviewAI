@model List<MockviewAI.Models.ViewModels.RecentSessionViewModel>
@{
    Layout = null;
    ViewData["ActiveNav"] = "history";
    var sessions = Model ?? new List<MockviewAI.Models.ViewModels.RecentSessionViewModel>();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lịch sử luyện tập - MockviewAI</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/History.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/themes/theme-indigo.css" media="(prefers-color-scheme: light)" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/themes/theme-dark-1.css" media="(prefers-color-scheme: dark)" asp-append-version="true" />
    <script src="~/js/History.js" asp-append-version="true" defer></script>
</head>
<body>
    <partial name="Partials/_AppNavigation" />

    <main class="page-shell history-page">
        <header class="page-header">
            <div class="page-header__content">
                <span class="page-header__eyebrow">HÀNH TRÌNH CỦA BẠN</span>
                <h1 class="page-header__title">Lịch sử luyện tập</h1>
                <p class="page-header__description">
                    Xem lại hội thoại, kết quả đánh giá và tiếp tục các buổi phỏng vấn chưa hoàn thành.
                </p>
            </div>
        </header>

        <section class="surface-card history-panel" aria-labelledby="history-list-title">
            <div class="section-header history-panel__header">
                <div class="section-header__content">
                    <span class="section-header__eyebrow">DANH SÁCH BUỔI LUYỆN</span>
                    <h2 id="history-list-title" class="section-header__title">Tất cả buổi luyện</h2>
                    <p class="section-header__description" id="history-count" aria-live="polite">
                        @sessions.Count buổi luyện · Chọn một buổi để xem chi tiết.
                    </p>
                </div>
                <div class="form-field history-search">
                    <label class="form-field__label" for="history-search">Tìm theo vị trí</label>
                    <div class="form-control-wrap">
                        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                        <input class="form-control" type="search" id="history-search"
                               placeholder="VD: Lập trình viên"
                               autocomplete="off" aria-controls="history-list" />
                    </div>
                </div>
            </div>

            @if (!sessions.Any())
            {
                <div class="empty-state">
                    <span class="empty-state__icon" aria-hidden="true"><i class="fa-regular fa-clock"></i></span>
                    <div class="empty-state__content">
                        <h3 class="empty-state__title">Chưa có buổi luyện tập nào</h3>
                        <p class="empty-state__description">Bắt đầu một buổi phỏng vấn để lịch sử luyện tập xuất hiện ở đây.</p>
                    </div>
                    <a class="button button--secondary" href="/Interview/Create">Bắt đầu luyện tập <i class="fa-solid fa-chevron-right" aria-hidden="true"></i></a>
                </div>
            }
            else
            {
                <div class="session-list history-list" id="history-list">
                    @foreach (var session in sessions)
                    {
                        <div class="history-entry" data-role="@session.RoleName">
                            <partial name="Partials/_SessionCard" model="session" />
                        </div>
                    }
                </div>
                <div class="history-no-results" id="history-no-results" hidden role="status">
                    <span class="history-no-results__icon" aria-hidden="true"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <h3>Không tìm thấy buổi luyện phù hợp</h3>
                    <p>Thử từ khóa khác hoặc xóa nội dung tìm kiếm.</p>
                    <button type="button" class="button button--secondary" id="history-clear">Xóa tìm kiếm</button>
                </div>
            }
        </section>
    </main>

    <partial name="Partials/_Notify" />
</body>
</html>