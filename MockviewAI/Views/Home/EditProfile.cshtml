@model MockviewAI.Models.ViewModels.ProfileEditViewModel
@{
    Layout = null;
    // Lựa chọn trong 2 ô chọn. Giá trị lưu vào DB là chính chữ hiển thị (giống bước Onboarding).
    var majors = new List<string> { "Công nghệ thông tin", "Hệ thống thông tin", "Kỹ thuật phần mềm" };
    var positions = new List<string> { "Lập trình viên", "Kiểm thử phần mềm", "Business Analyst" };
    // Giá trị đã nhập ở Onboarding mà không có trong danh sách thì vẫn giữ để không bị mất
    if (!string.IsNullOrEmpty(Model.Major) && !majors.Contains(Model.Major)) majors.Insert(0, Model.Major);
    if (!string.IsNullOrEmpty(Model.Position) && !positions.Contains(Model.Position)) positions.Insert(0, Model.Position);
    var initial = string.IsNullOrEmpty(Model.FullName) ? "?" : Model.FullName.Substring(0, 1).ToUpper();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sửa hồ sơ - MockviewAI</title>
    <!-- Font Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/EditProfile.css">
</head>
<body>

    <!-- Header Desktop -->
    <header class="desktop-header">
        <div class="header-content">
            <div class="logo-nav">
                <div class="logo">Mockview<span>AI</span></div>
                <nav class="nav-links">
                    <a href="/Home">Trang chủ</a>
                    <a href="/Interview/Create">Luyện tập</a>
                    <a href="/Home/History">Lịch sử</a>
                </nav>
            </div>
            <div class="header-actions">
                <span class="badge-beta">Bản thử V1</span>
                <div class="profile-icon">@initial</div>
            </div>
        </div>
    </header>

    <!-- Nội dung chính -->
    <main class="main-container">
        
        <!-- Nút quay lại & Tiêu đề -->
        <div class="page-header">
            <a href="/Profile" class="back-link">&lsaquo; Hồ sơ</a>
            <h1 class="page-title">Sửa hồ sơ</h1>
        </div>

        <!-- Thẻ chứa Form sửa hồ sơ -->
        <div class="edit-profile-card">
            
            <!-- Khối bên trái: Ảnh đại diện -->
            <div class="avatar-section">
                <div class="avatar-circle">@initial</div>
                <a href="#" class="change-avatar-btn">Đổi ảnh đại diện</a>
            </div>

            <!-- Khối bên phải: Form nhập thông tin -->
            <form class="profile-form" method="post" asp-controller="Home" asp-action="EditProfile">
                
                <!-- Họ và tên -->
                <div class="form-group full-width">
                    <label class="form-label" for="fullname">Họ và tên</label>
                    <input type="text" id="fullname" name="fullName" class="form-input" value="@Model.FullName" maxlength="100" required>
                </div>

                <!-- Hàng 2 cột: Chuyên ngành & Vị trí ứng tuyển -->
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" for="major">Chuyên ngành</label>
                        <div class="select-wrapper">
                            <select id="major" name="major" class="form-select">
                                @foreach (var m in majors)
                                {
                                    <option value="@m" selected="@(m == Model.Major)">@m</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="position">Vị trí muốn ứng tuyển</label>
                        <div class="select-wrapper">
                            <select id="position" name="position" class="form-select">
                                @foreach (var p in positions)
                                {
                                    <option value="@p" selected="@(p == Model.Position)">@p</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Tình trạng sinh viên/ra trường -->
                <div class="form-group full-width">
                    <label class="form-label">Bạn là</label>
                    <input type="hidden" id="studentStatus" name="studentStatus" value="@Model.StudentStatus">
                    <div class="status-options">
                        <button type="button" class="status-btn @(Model.StudentStatus == "Expecting Graduation" ? "active" : "")" onclick="selectStatus('Expecting Graduation', this)">Sắp ra trường</button>
                        <button type="button" class="status-btn @(Model.StudentStatus == "Graduated" ? "active" : "")" onclick="selectStatus('Graduated', this)">Đã ra trường</button>
                    </div>
                </div>

                <!-- Cụm nút bấm lưu/huỷ -->
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                    <button type="button" class="btn btn-outline" onclick="location.href='/Profile'">Huỷ</button>
                </div>

            </form>

        </div>
    </main>

    <script>
        function selectStatus(value, btn) {
            document.getElementById('studentStatus').value = value;
            document.querySelectorAll('.status-btn').forEach(function(b) {
                b.classList.remove('active');
            });
            btn.classList.add('active');
        }
    </script>
    <partial name="Partials/_Notify" />
</body>
</html>
