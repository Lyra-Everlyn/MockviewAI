@{
    Layout = null;
    ViewData["ActiveNav"] = "terms";

    var lastUpdated = new DateTime(2026, 11, 22);
    var supportEmail = "mockviewai@gmail.com";
    var isSignedIn = User.Identity?.IsAuthenticated == true;

    var sections = new[]
    {
        new { Id = "chap-thuan", Title = "Chấp thuận điều khoản" },
        new { Id = "dich-vu", Title = "Mô tả dịch vụ" },
        new { Id = "tai-khoan", Title = "Tài khoản người dùng" },
        new { Id = "quy-tac", Title = "Quy tắc sử dụng" },
        new { Id = "noi-dung-ai", Title = "Nội dung do AI tạo ra" },
        new { Id = "du-lieu", Title = "Dữ liệu và quyền riêng tư" },
        new { Id = "giay-phep", Title = "Mã nguồn và giấy phép MIT" },
        new { Id = "kha-dung", Title = "Tính khả dụng của dịch vụ" },
        new { Id = "trach-nhiem", Title = "Giới hạn trách nhiệm" },
        new { Id = "thay-doi", Title = "Thay đổi điều khoản" },
        new { Id = "lien-he", Title = "Liên hệ" }
    };

    // Tiêu đề mục: số thứ tự trong vòng tròn + tên mục
    Microsoft.AspNetCore.Html.IHtmlContent SectionTitle(string id)
    {
        var index = Array.FindIndex(sections, x => x.Id == id);
        return Html.Raw($"<span class=\"legal-section__number\">{index + 1}</span>"
                      + $"<span>{System.Net.WebUtility.HtmlEncode(sections[index].Title)}</span>");
    }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Các quy định khi bạn sử dụng MockviewAI. Khi tạo tài khoản hoặc tiếp tục sử dụng nền tảng, bạn đồng ý với những điều khoản dưới đây." />
    <title>Điều khoản sử dụng - MockviewAI</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Legal.css" asp-append-version="true" />
    <partial name="Partials/_ThemeHead" />
</head>
<body class="@(isSignedIn ? "app-layout" : "legal-guest")">
    @if (isSignedIn)
    {
        <partial name="Partials/_AppNavigation" />
    }
    else
    {
        <header class="legal-guestbar">
            <a class="legal-guestbar__brand" href="/Auth/Login" aria-label="MockviewAI - Đăng nhập">
                <img src="~/favicon.ico" asp-append-version="true" alt="" aria-hidden="true" />
                <span>Mockview<span>AI</span></span>
            </a>
            <div class="legal-guestbar__actions">
                <a class="button button--secondary button--small" href="/Auth/Login">Đăng nhập</a>
                <a class="button button--primary button--small" href="/Auth/Register">Đăng ký</a>
            </div>
        </header>
    }

    <div class="legal-progress" aria-hidden="true"><span class="legal-progress__bar" data-legal-progress></span></div>

    <div class="app-layout__content">
        <main class="page-shell legal-page">
            @* #region Banner *@
            <section class="profile-banner legal-banner" aria-labelledby="legal-title">
                <div class="profile-banner__identity">
                    <nav class="legal-switch" aria-label="Trang pháp lý">
                        <a class="legal-switch__link is-current" asp-controller="Home" asp-action="Terms" aria-current="page">Điều khoản sử dụng</a>
                        <a class="legal-switch__link " asp-controller="Home" asp-action="Privacy">Quyền riêng tư</a>
                    </nav>
                    <h1 id="legal-title" class="profile-banner__name">Điều khoản sử dụng</h1>
                    <p class="profile-banner__status">Các quy định khi bạn sử dụng MockviewAI. Khi tạo tài khoản hoặc tiếp tục sử dụng nền tảng, bạn đồng ý với những điều khoản dưới đây.</p>
                    <div class="legal-meta">
                        <span class="legal-chip">Cập nhật @lastUpdated.ToString("dd/MM/yyyy")</span>
                        <span class="legal-chip" data-legal-read-time>~5 phút đọc</span>
                        <button type="button" class="button button--secondary button--small legal-print" data-legal-print>
                            <i class="fa-solid fa-print" aria-hidden="true"></i> In / Lưu PDF
                        </button>
                    </div>
                </div>
            </section>
            @* #endregion *@

            <div class="legal-layout">
                <aside class="legal-aside">
                    <nav class="legal-toc" aria-label="Mục lục">
                        <button type="button" class="legal-toc__toggle" data-legal-toc-toggle aria-expanded="false" aria-controls="legal-toc-list">
                            <span><i class="fa-solid fa-list-ul" aria-hidden="true"></i> Mục lục</span>
                            <i class="fa-solid fa-chevron-down legal-toc__caret" aria-hidden="true"></i>
                        </button>
                        <h2 class="legal-toc__title">Mục lục</h2>
                        <ol id="legal-toc-list" class="legal-toc__list">
                            @for (var i = 0; i < sections.Length; i++)
                            {
                                <li>
                                    <a class="legal-toc__link" href="#@sections[i].Id" data-legal-toc-link>
                                        <span class="legal-toc__index">@(i + 1)</span>
                                        <span>@sections[i].Title</span>
                                    </a>
                                </li>
                            }
                        </ol>
                    </nav>
                </aside>

                <article class="legal-content" data-legal-content>
                    <div class="legal-summary">
                        <div>
                            <strong>Tóm tắt nhanh</strong>
                            <p>MockviewAI là công cụ <strong>luyện tập</strong> phỏng vấn, được phát triển trong một dự án nghiên cứu học thuật. Điểm số và nhận xét do AI tạo ra chỉ để tham khảo, không bảo đảm kết quả tuyển dụng. Mã nguồn được công bố theo giấy phép MIT.</p>
                        </div>
                    </div>

                    <section id="chap-thuan" class="legal-section" data-legal-section>
                        <h2 class="legal-section__title">@SectionTitle("chap-thuan")</h2>
                        <p>Các Điều khoản sử dụng này điều chỉnh việc truy cập và sử dụng nền tảng MockviewAI ("chúng tôi"). Bằng việc tạo tài khoản, đăng nhập hoặc tiếp tục sử dụng dịch vụ, bạn xác nhận đã đọc, hiểu và đồng ý với các điều khoản này.</p>
                        <p>Nếu không đồng ý với bất kỳ nội dung nào, vui lòng ngừng sử dụng nền tảng.</p>
                    </section>

                    <section id="dich-vu" class="legal-section" data-legal-section>
                        <h2 class="legal-section__title">@SectionTitle("dich-vu")</h2>
                        <p>MockviewAI cung cấp môi trường mô phỏng phỏng vấn kỹ thuật cho ứng viên ngành CNTT, có ứng dụng trí tuệ nhân tạo:</p>
                        <ul class="legal-list">
                            <li><i class="fa-solid fa-check" aria-hidden="true"></i>Tạo buổi phỏng vấn theo vị trí, chế độ Luyện tập hoặc Thực chiến.</li>
                            <li><i class="fa-solid fa-check" aria-hidden="true"></i>Trả lời bằng giọng nói (được chuyển thành văn bản) hoặc gõ phím.</li>
                            <li><i class="fa-solid fa-check" aria-hidden="true"></i>Nhận câu hỏi nối tiếp, điểm số, nhận xét và xem lại lịch sử luyện tập.</li>
                            <li><i class="fa-solid fa-check" aria-hidden="true"></i>Tải CV (PDF) lên để nhà tuyển dụng AI đặt câu hỏi theo kinh nghiệm của bạn.</li>
                        </ul>
                        <p>Tính năng có thể được cập nhật, điều chỉnh hoặc ngừng cung cấp trong quá trình phát triển.</p>
                    </section>

                    <section id="tai-khoan" class="legal-section" data-legal-section>
                        <h2 class="legal-section__title">@SectionTitle("tai-khoan")</h2>
                        <p>Khi đăng ký và sử dụng tài khoản, bạn có trách nhiệm:</p>
                        <ul class="legal-list">
                            <li><i class="fa-solid fa-check" aria-hidden="true"></i>Cung cấp thông tin đăng ký chính xác và cập nhật khi có thay đổi.</li>
                            <li><i class="fa-solid fa-check" aria-hidden="true"></i>Bảo vệ mật khẩu, không chia sẻ tài khoản cho người khác.</li>
                            <li><i class="fa-solid fa-check" aria-hidden="true"></i>Báo cho chúng tôi khi phát hiện dấu hiệu truy cập bất thường.</li>
                        </ul>
                        <p>Để bảo vệ tài khoản, hệ thống tạm khoá đăng nhập sau nhiều lần nhập sai và có thể hạn chế quyền truy cập khi phát hiện dấu hiệu vi phạm.</p>
                    </section>

                    <section id="quy-tac" class="legal-section" data-legal-section>
                        <h2 class="legal-section__title">@SectionTitle("quy-tac")</h2>
                        <p>Bạn đồng ý <strong>không</strong> sử dụng MockviewAI để:</p>
                        <ul class="legal-list legal-list--danger">
                            <li><i class="fa-solid fa-xmark" aria-hidden="true"></i>Thực hiện hành vi vi phạm pháp luật hoặc xâm phạm quyền của người khác.</li>
                            <li><i class="fa-solid fa-xmark" aria-hidden="true"></i>Gửi nội dung đe doạ, quấy rối, lừa đảo hoặc chứa mã độc.</li>
                            <li><i class="fa-solid fa-xmark" aria-hidden="true"></i>Tấn công, dò quét lỗ hổng hoặc gửi yêu cầu tự động hàng loạt tới hệ thống đang vận hành.</li>
                            <li><i class="fa-solid fa-xmark" aria-hidden="true"></i>Tải lên tài liệu (như CV) mà bạn không có quyền sử dụng.</li>
                        </ul>
                        <p>Quy định này áp dụng cho <strong>dịch vụ đang chạy</strong> tại mockviewai.com. Việc sử dụng mã nguồn tuân theo giấy phép MIT (mục 7).</p>
                    </section>

                    <section id="noi-dung-ai" class="legal-section" data-legal-section>
                        <h2 class="legal-section__title">@SectionTitle("noi-dung-ai")</h2>
                        <p>Câu hỏi, bản chép giọng nói, nhận xét và điểm số do AI tạo ra có thể chưa đầy đủ, chưa chính xác hoặc không phản ánh tiêu chí của nhà tuyển dụng thực tế.</p>
                        <div class="legal-callout legal-callout--warning">
                            <i class="fa-solid fa-lightbulb" aria-hidden="true"></i>
                            <p>Hãy xem kết quả như tài liệu tham khảo để tự luyện tập, và kết hợp với kinh nghiệm thực tế, tài liệu chuyên môn và góp ý từ người hướng dẫn.</p>
                        </div>
                        <p>MockviewAI không cam kết bạn sẽ được tuyển dụng, đạt một mức điểm cụ thể hay nhận được lời mời phỏng vấn.</p>
                    </section>

                    <section id="du-lieu" class="legal-section" data-legal-section>
                        <h2 class="legal-section__title">@SectionTitle("du-lieu")</h2>
                        <p>Cách chúng tôi thu thập, sử dụng, lưu trữ và bảo vệ dữ liệu được trình bày trong <a class="legal-link" asp-controller="Home" asp-action="Privacy" target="_blank" rel="noopener noreferrer">Chính sách quyền riêng tư</a>.</p>
                        <p>Bạn giữ quyền đối với nội dung mình cung cấp (câu trả lời, CV). Khi sử dụng dịch vụ, bạn cho phép MockviewAI xử lý nội dung đó — gồm cả việc gửi tới các nhà cung cấp AI được liệt kê trong Chính sách — chỉ để vận hành buổi luyện tập. Vui lòng không đưa thông tin nhạy cảm không cần thiết vào câu trả lời hoặc tài liệu tải lên.</p>
                    </section>

                    <section id="giay-phep" class="legal-section" data-legal-section>
                        <h2 class="legal-section__title">@SectionTitle("giay-phep")</h2>
                        <p>Mã nguồn MockviewAI được công bố theo <strong>giấy phép MIT</strong> (Copyright © 2026 Lyra Everlyn). Bạn được tự do sử dụng, sao chép, sửa đổi, hợp nhất, xuất bản, phân phối, cấp phép lại và/hoặc bán bản sao của phần mềm, với điều kiện giữ nguyên thông báo bản quyền và nội dung giấy phép trong mọi bản sao hoặc phần đáng kể của phần mềm.</p>
                        <div class="legal-grid">
                            <div class="legal-card">
                                <i class="fa-solid fa-code-branch" aria-hidden="true"></i>
                                <strong>Áp dụng cho</strong>
                                <p>Mã nguồn của dự án tại kho lưu trữ công khai.</p>
                            </div>
                            <div class="legal-card">
                                <i class="fa-solid fa-ban" aria-hidden="true"></i>
                                <strong>Không bao gồm</strong>
                                <p>Dữ liệu và nội dung của người dùng, cũng như dịch vụ và API của bên thứ ba (Google, Groq, Cloudflare...) — những phần này theo điều khoản riêng của chủ sở hữu.</p>
                            </div>
                        </div>
                        <p>Phần mềm được cung cấp <strong>"NGUYÊN TRẠNG" (AS IS)</strong>, không kèm bất kỳ bảo đảm nào, theo đúng nội dung giấy phép MIT.</p>
                        <div class="legal-actions">
                            <a class="button button--secondary" href="https://github.com/Lyra-Everlyn/MockviewAI/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">
                                <i class="fa-brands fa-github" aria-hidden="true"></i> Xem mã nguồn và giấy phép
                            </a>
                        </div>
                    </section>

                    <section id="kha-dung" class="legal-section" data-legal-section>
                        <h2 class="legal-section__title">@SectionTitle("kha-dung")</h2>
                        <p>Là sản phẩm của một dự án nghiên cứu, MockviewAI không bảo đảm dịch vụ luôn hoạt động liên tục hoặc không có lỗi. Một số tính năng có thể tạm thời không khả dụng do bảo trì, cập nhật, giới hạn lượt dùng của nhà cung cấp AI hoặc sự cố kết nối.</p>
                    </section>

                    <section id="trach-nhiem" class="legal-section" data-legal-section>
                        <h2 class="legal-section__title">@SectionTitle("trach-nhiem")</h2>
                        <p>Trong phạm vi pháp luật cho phép, MockviewAI không chịu trách nhiệm đối với quyết định tuyển dụng của bên thứ ba, kết quả nghề nghiệp cá nhân hoặc thiệt hại phát sinh từ việc phụ thuộc hoàn toàn vào nội dung AI mà không tự kiểm tra.</p>
                        <p>Không nội dung nào trong điều khoản này loại trừ trách nhiệm mà pháp luật hiện hành không cho phép loại trừ.</p>
                    </section>

                    <section id="thay-doi" class="legal-section" data-legal-section>
                        <h2 class="legal-section__title">@SectionTitle("thay-doi")</h2>
                        <p>Điều khoản có thể được cập nhật khi dịch vụ hoặc quy định pháp luật thay đổi. Ngày cập nhật gần nhất luôn hiển thị ở đầu trang. Việc bạn tiếp tục sử dụng nền tảng sau khi thay đổi có hiệu lực đồng nghĩa với việc chấp thuận phiên bản mới.</p>
                    </section>

                    <section id="lien-he" class="legal-section" data-legal-section>
                        <h2 class="legal-section__title">@SectionTitle("lien-he")</h2>
                        <p>Nếu có câu hỏi về Điều khoản sử dụng, vui lòng liên hệ:</p>
                        <div class="legal-contact">
                            <a class="legal-contact__card" href="mailto:@supportEmail">
                                <span class="legal-contact__icon legal-contact__icon--mail" aria-hidden="true"><i class="fa-regular fa-envelope"></i></span>
                                <span class="legal-contact__text"><strong>@supportEmail</strong><small>Phản hồi trong 3–5 ngày làm việc.</small></span>
                            </a>
                            <a class="legal-contact__card" href="/Feedback">
                                <span class="legal-contact__icon" aria-hidden="true"><i class="fa-regular fa-message"></i></span>
                                <span class="legal-contact__text"><strong>Gửi góp ý</strong><small>Góp ý trực tiếp trên MockviewAI (cần đăng nhập).</small></span>
                            </a>
                        </div>
                    </section>
                </article>
            </div>
        </main>
    </div>

    <button type="button" class="legal-top" data-legal-top aria-label="Lên đầu trang" hidden>
        <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
    </button>

    <partial name="Partials/_AppFooter" />
    <partial name="Partials/_Notify" />

    <script src="~/js/Legal.js" asp-append-version="true" defer></script>
</body>
</html>
