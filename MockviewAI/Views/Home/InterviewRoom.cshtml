@model MockviewAI.Models.DTOs.InterviewRoomViewModel
@{
    Layout = null; 
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Phòng phỏng vấn - MockviewAI</title>
    <link rel="stylesheet" href="~/css/InterviewRoom.css">
</head>
<body>
    <!-- THANH ĐIỀU HƯỚNG MÁY TÍNH -->
    <nav class="desktop-nav hide-on-mobile">
        <div class="nav-container">
            <div class="nav-left">
                <div class="logo">Mockview<span>AI</span></div>
                <div class="nav-title">Phòng phỏng vấn thử &middot; @Model.Position</div>
            </div>
            <div class="nav-right">
                <span class="badge-step">Câu @Model.QuestionNumber / @Model.TotalQuestions</span>
            </div>
        </div>
    </nav>

    <!-- NỘI DUNG CHÍNH (PHÒNG PHỎNG VẤN) -->
    <main class="interview-container" id="interview-room" data-session-id="@Model.SessionId" data-total="@Model.TotalQuestions">
        @Html.AntiForgeryToken()
        
        <!-- Header riêng cho Điện thoại -->
        <div class="mobile-header hide-on-desktop">
            <div class="mobile-step">Câu @Model.QuestionNumber / @Model.TotalQuestions</div>
            <div class="badge-role">@Model.Position</div>
        </div>

        <!-- Thanh tiến trình (Dùng chung cho cả PC và Mobile) -->
        <div class="progress-track">
            <div class="progress-fill" style="width: @(Model.ProgressPercent)%;"></div>
        </div>

        <div class="layout-grid">
            
            <!-- CỘT TRÁI: Nội dung phỏng vấn -->
            <div class="content-pane">
                <!-- Khu vực Avatar -->
                <div class="avatar-section">
                    <div class="avatar-circle">
                        <!-- SVG vẽ hình Avatar mô phỏng -->
                        <svg width="100" height="100" viewBox="0 0 100 100">
                            <circle cx="50" cy="50" r="50" fill="#fde68a"/>
                            <path d="M 20 50 C 20 10, 80 10, 80 50 C 70 50, 60 40, 50 40 C 40 40, 30 50, 20 50 Z" fill="#451a03"/>
                            <circle cx="50" cy="48" r="28" fill="#fed7aa"/>
                            <path d="M 25 50 C 25 15, 75 15, 75 50 L 85 65 C 70 55, 30 55, 15 65 Z" fill="#451a03"/>
                            <circle cx="40" cy="50" r="3" fill="#451a03"/>
                            <circle cx="60" cy="50" r="3" fill="#451a03"/>
                            <path d="M 44 58 Q 50 64 56 58" fill="none" stroke="#451a03" stroke-width="3" stroke-linecap="round"/>
                            <path d="M 25 100 C 25 70, 75 70, 75 100 Z" fill="#2949ff"/>
                        </svg>
                    </div>
                    <div class="interviewer-name">@Model.InterviewerName &middot; @Model.InterviewerRole</div>
                    <div class="status-tag">Đang hỏi...</div>
                </div>

                <!-- Khu vực Câu hỏi -->
                <div class="question-box">
                    <div class="box-label">Câu hỏi</div>
                    <div class="question-text" id="question-text">@Model.QuestionText</div>
                </div>

                <!-- Khu vực Bản ghi câu trả lời -->
                <div class="transcript-box">
                    <div class="box-label">Bản ghi chữ câu trả lời của bạn</div>
                    <div class="transcript-text" id="transcript-text">Câu trả lời của bạn sẽ hiện ở đây.</div>
                    <textarea class="answer-input" id="answer-input" rows="4" maxlength="2000" hidden
                              placeholder="Gõ câu trả lời của bạn..."></textarea>
                </div>
            </div>

            <!-- CỘT PHẢI: Bảng điều khiển -->
            <div class="control-pane">
                <h3 class="control-title hide-on-mobile">Điều khiển</h3>
                
                <button class="btn btn-primary" id="btn-speak" type="button">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" y1="19" x2="12" y2="22"></line></svg>
                    Bấm để nói
                </button>

                <!-- Bọc 2 nút này để xếp ngang trên điện thoại -->
                <div class="btn-row">
                    <button class="btn btn-outline" id="btn-type" type="button">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2" ry="2"></rect><line x1="6" y1="8" x2="6" y2="8"></line><line x1="10" y1="8" x2="10" y2="8"></line><line x1="14" y1="8" x2="14" y2="8"></line><line x1="18" y1="8" x2="18" y2="8"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                        Gõ câu trả lời
                    </button>
                    
                    <button class="btn btn-outline" id="btn-skip" type="button">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 4 15 12 5 20 5 4"></polygon><line x1="19" y1="5" x2="19" y2="19"></line></svg>
                        Bỏ qua câu này
                    </button>
                </div>

                <button class="btn btn-primary" id="btn-send" type="button" hidden>Gửi câu trả lời</button>
                <p class="helper-text" id="room-message" hidden></p>

                <button class="btn btn-danger" id="btn-stop-session" type="button">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="6" width="12" height="12" rx="2" ry="2"></rect></svg>
                    Dừng buổi luyện
                </button>

                <p class="helper-text hide-on-mobile">Mẹo: nói chậm, rõ; trả lời trong khoảng 1-2 phút.</p>
            </div>
        </div>
    </main>

    <!-- HỘP THOẠI (MODAL): Dừng buổi luyện -->
    <div class="modal-overlay" id="stop-modal">
        <div class="modal-box">
            <div class="modal-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="6" width="12" height="12" rx="2" ry="2"></rect></svg>
            </div>
            <h2 class="modal-title">Dừng buổi luyện?</h2>
            <p class="modal-desc">Bạn đã trả lời <span id="answered-count">@Model.AnsweredCount</span> / @Model.TotalQuestions câu. Các câu đã trả lời vẫn được chấm điểm và lưu vào lịch sử.</p>
            <div class="modal-actions">
                <button class="btn btn-outline" id="btn-resume">Tiếp tục phỏng vấn</button>
                <button class="btn btn-danger-fill" id="btn-finish" type="button">Dừng và xem kết quả</button>
            </div>
        </div>
    </div>

    <script src="~/js/InterviewRoom.js"></script>
</body>
</html>