@model MockviewAI.Models.ViewModels.InterviewRoomViewModel
@{
    Layout = null;
    // [UI-DARK] Màu ô người phỏng vấn theo tên (Linh / Nam / An)
    var faceClass = Model.InterviewerName switch { "Nam" => "f-nam", "An" => "f-an", _ => "" };
    var faceLetter = string.IsNullOrEmpty(Model.InterviewerName) ? "?" : Model.InterviewerName.Substring(0, 1).ToUpper();
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Phòng phỏng vấn - MockviewAI</title>
    @* [UI-DARK] Đợt 4 (02/11): giao diện tối "phòng thu". Bản sáng cũ: InterviewRoom.css.
       GIỮ NGUYÊN mọi id / class mà InterviewRoom.js dùng (badge-step, progress-fill, status-tag, btn-*, room-wave...). *@
    <link rel="stylesheet" href="~/css/studio.css">
    <link rel="stylesheet" href="~/css/studio-room.css">
</head>
<body class="studio">
    <!-- Thanh trên: tiến độ dạng dải băng + nút dừng -->
    <header class="roombar">
        <div class="logo">Mockview<span>AI</span></div>
        <div class="tapewrap">
            <div class="step"><b class="badge-step">Câu @Model.QuestionNumber / @Model.TotalQuestions</b> &middot; @Model.Position</div>
            <div class="tape tape-room" aria-hidden="true">
                @for (int i = 1; i <= Model.TotalQuestions; i++)
                {
                    <span class="seg @(i < Model.QuestionNumber ? "done" : i == Model.QuestionNumber ? "now" : "")"></span>
                }
            </div>
            @* Thanh tiến trình cũ: JS vẫn cập nhật nên giữ lại (ẩn) *@
            <div class="progress-track" hidden><div class="progress-fill" style="width: @(Model.ProgressPercent)%;"></div></div>
        </div>
        <button class="btn btn-stop" id="btn-stop-session" type="button">Dừng buổi luyện</button>
    </header>

    <main class="stage" id="interview-room" data-session-id="@Model.SessionId" data-total="@Model.TotalQuestions">
        @Html.AntiForgeryToken()

        <!-- Người phỏng vấn + trạng thái -->
        <div class="asker">
            <div class="face @faceClass">@faceLetter</div>
            <div class="asker-text">
                <div class="who">@Model.InterviewerName</div>
                <div class="role">@Model.InterviewerRole</div>
            </div>
            <div class="status-tag" id="status-tag">Đang hỏi...</div>
            <!-- [#17] Đọc lại câu hỏi bằng giọng nói -->
            <button class="replay" id="btn-replay" type="button" title="Nghe lại câu hỏi">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
                Nghe lại
            </button>
        </div>

        <!-- Câu hỏi -->
        <h1 class="question" id="question-text">@Model.QuestionText</h1>
        <p class="voice-note" id="voice-note" hidden>Máy chưa có giọng đọc tiếng Việt. Bạn vẫn đọc câu hỏi ở trên và trả lời bình thường.</p>

        <!-- Câu trả lời: viền cam + "Đang ghi âm" khi micro đang nghe (CSS :has(.status-tag.is-listening)) -->
        <section class="answer transcript-box" aria-label="Câu trả lời của bạn">
            <div class="ans-head">
                <span class="rec">Đang ghi âm</span>
                <span class="ans-label">Câu trả lời của bạn</span>
            </div>
            <div class="transcript-text" id="transcript-text">Câu trả lời của bạn sẽ hiện ở đây.</div>
            <div class="transcript-meta" id="transcript-meta" hidden></div>
            <textarea class="answer-input" id="answer-input" rows="5" maxlength="2000" hidden
                      placeholder="Gõ câu trả lời của bạn..."></textarea>
            <!-- Sóng âm đo trực tiếp từ micro: sóng động = hệ thống đang nghe thấy bạn -->
            <div class="wave wave-room" id="room-wave" aria-hidden="true" hidden></div>
            <!-- 28/10: nói sai thì xoá bản ghi để nói lại (chỉ hiện khi đã có chữ) -->
            <button class="btn-clear-answer" id="btn-clear-answer" type="button" hidden>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path></svg>
                Xoá ghi âm, nói lại
            </button>
        </section>

        <!-- Xác nhận câu trả lời vừa gửi -->
        <div class="last-answer" id="last-answer" hidden></div>

        <!-- Cụm điều khiển -->
        <div class="dock">
            <button class="btn btn-mic" id="btn-speak" type="button">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" y1="19" x2="12" y2="22"></line></svg>
                Bấm để nói
            </button>
            <button class="btn btn-ghost" id="btn-type" type="button">Gõ câu trả lời</button>
            <button class="btn btn-ghost" id="btn-skip" type="button">Bỏ qua câu này</button>
            <button class="btn btn-main" id="btn-send" type="button" hidden>Gửi câu trả lời</button>
        </div>

        <p class="helper-text" id="room-message" hidden></p>

        <!-- Hiện khi AI chấm lỗi -->
        <div class="score-retry">
            <button class="btn btn-main" id="btn-retry-score" type="button" hidden>Chấm lại</button>
            <button class="btn btn-ghost" id="btn-fallback-score" type="button" hidden>Xem kết quả ngay (chấm sơ bộ, không cần AI)</button>
        </div>

        <p class="tips">Mẹo: nói chậm, rõ; trả lời trong khoảng 1–2 phút.</p>
    </main>

    <!-- HỘP THOẠI: Dừng buổi luyện -->
    <div class="modal-overlay" id="stop-modal">
        <div class="modal-box">
            <h2 class="modal-title">Dừng buổi luyện?</h2>
            <p class="modal-desc">Bạn đã trả lời <span id="answered-count">@Model.AnsweredCount</span> / @Model.TotalQuestions câu. Các câu đã trả lời vẫn được chấm điểm và lưu vào lịch sử.</p>
            <div class="modal-actions">
                <button class="btn btn-ghost" id="btn-resume">Tiếp tục phỏng vấn</button>
                <button class="btn btn-stop-fill" id="btn-finish" type="button">Dừng và xem kết quả</button>
            </div>
        </div>
    </div>

    <!-- [#18] HỘP THOẠI: Kiểm tra micro trước khi bắt đầu (chỉ hiện khi chưa trả lời câu nào) -->
    <div class="modal-overlay" id="mic-check" style="display: @(Model.AnsweredCount == 0 ? "flex" : "none");">
        <div class="modal-box">
            <h2 class="modal-title">Kiểm tra micro</h2>
            <p class="modal-desc">Bấm nút bên dưới rồi nói thử: <strong>"Xin chào, tôi sẵn sàng phỏng vấn"</strong>.</p>
            <p class="browser-warning" id="browser-warning" hidden></p>
            <div class="wave" id="mic-wave" aria-hidden="true"></div>
            <div class="mic-test-box" id="mic-test-text">Chữ bạn nói sẽ hiện ở đây.</div>
            <p class="mic-test-status" id="mic-test-status"></p>
            <button class="btn btn-ghost" id="btn-mic-test" type="button">Bấm để nói thử</button>
            <div class="modal-actions">
                <button class="btn btn-ghost" id="btn-mic-skip" type="button">Bỏ qua, tôi sẽ gõ chữ</button>
                <button class="btn btn-main" id="btn-mic-ok" type="button">Vào phỏng vấn</button>
            </div>
        </div>
    </div>

    <script src="~/js/InterviewRoom.js"></script>
</body>
</html>
