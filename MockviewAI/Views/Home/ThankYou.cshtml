@{
    Layout = null;
    ViewData["ActiveNav"] = "";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cảm ơn bạn - MockviewAI</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/ThankYou.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/themes/theme-indigo.css" media="(prefers-color-scheme: light)" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/themes/theme-dark-1.css" media="(prefers-color-scheme: dark)" asp-append-version="true" />
</head>
<body>
    <partial name="Partials/_AppNavigation" />

    <main class="page-shell thankyou-page">
        <section class="thankyou-panel" aria-labelledby="thankyou-title">
            <span class="thankyou-panel__icon" aria-hidden="true">
                <i class="fa-solid fa-check"></i>
            </span>

            <h1 class="thankyou-panel__title" id="thankyou-title">
                Cảm ơn bạn đã góp ý!
            </h1>
            <p class="thankyou-panel__description">
                Ý kiến của bạn đã được ghi nhận và sẽ giúp nhóm cải thiện phiên bản tiếp theo.
            </p>

            <div class="thankyou-panel__actions">
                <a class="button button--primary" href="/Home">
                    <i class="fa-solid fa-house" aria-hidden="true"></i>
                    Về trang chủ
                </a>
                <a class="button button--secondary" href="/Interview/Create">
                    <i class="fa-solid fa-microphone" aria-hidden="true"></i>
                    Luyện thêm một buổi
                </a>
            </div>
        </section>
    </main>

    <partial name="Partials/_Notify" />
    <partial name="Partials/_AppFooter" />
</body>
</html>
