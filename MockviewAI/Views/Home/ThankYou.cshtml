@{
    Layout = null;
    ViewData["ActiveNav"] = "";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cảm ơn bạn - MockviewAI</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/ThankYou.css" asp-append-version="true">
    <partial name="Partials/_ThemeHead" />
</head>
<body>
    <partial name="Partials/_AppNavigation" />

    <main class="page-shell thankyou-page">
        <section class="thankyou-card" aria-labelledby="thankyou-title">
            @* Dấu tick nổi giữa hai vòng tròn đồng tâm *@
            <span class="thankyou-card__badge" aria-hidden="true">
                <span class="thankyou-card__check"><i class="fa-solid fa-check"></i></span>
            </span>

            <h1 class="thankyou-card__title" id="thankyou-title">Đã gửi góp ý</h1>
            <p class="thankyou-card__text">Cảm ơn bạn. Nhóm đã ghi nhận ý kiến và sẽ dùng để cải thiện phiên bản tiếp theo.</p>

            <div class="thankyou-card__actions">
                <a class="button button--primary button--icon" href="/Interview/Create">
                    <span class="button__icon" aria-hidden="true"><i class="fa-solid fa-microphone"></i></span>
                    Luyện thêm một buổi
                </a>
                <a class="button button--secondary" href="/Home">Về trang chủ</a>
            </div>
        </section>
    </main>

    <partial name="Partials/_Notify" />
</body>
</html>
