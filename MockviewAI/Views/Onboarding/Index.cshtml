@model MockviewAI.Models.DTOs.OnboardingDto
@{
    Layout = null;
    ViewData["Title"] = "Thiết lập hồ sơ";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Thiết lập hồ sơ - MockviewAI</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Onboarding.css" asp-append-version="true" />
    <partial name="Partials/_ThemeHead" />
</head>
<body class="app-layout app-layout--auth">
    <div class="app-layout__content">
        <main class="auth-page">
            <div class="auth-shell">
                @* Cột trái dùng chung khung Auth: logo, câu giới thiệu, thanh 3 bước (Onboarding.js cập nhật trạng thái) *@
                <section class="auth-intro" aria-label="Tiến trình thiết lập hồ sơ">
                    <div class="auth-intro__top">
                        <a class="auth-brand" asp-controller="Home" asp-action="Index" aria-label="MockviewAI - Trang chủ">
                            <span>Mockview<span>AI</span></span>
                        </a>
                        <partial name="Partials/_ThemeToggle" />
                    </div>

                    <p class="auth-intro__pitch">Ba câu hỏi để AI hiểu mục tiêu của bạn.</p>

                    <ol class="auth-track" aria-label="Tiến trình">
                        <li class="auth-track__step is-current" id="trackerStep1" aria-current="step">
                            <span class="auth-track__dot">1</span>
                            <span class="auth-track__text"><strong>Ngành học & vị trí</strong><small data-hint="Mục tiêu ứng tuyển">Mục tiêu ứng tuyển</small></span>
                        </li>
                        <li class="auth-track__step" id="trackerStep2">
                            <span class="auth-track__dot">2</span>
                            <span class="auth-track__text"><strong>Giai đoạn học tập</strong><small data-hint="Đang học hay đã tốt nghiệp">Đang học hay đã tốt nghiệp</small></span>
                        </li>
                        <li class="auth-track__step" id="trackerStep3">
                            <span class="auth-track__dot">3</span>
                            <span class="auth-track__text"><strong>Kinh nghiệm</strong><small data-hint="Mức độ thực hành">Mức độ thực hành</small></span>
                        </li>
                    </ol>

                    <p class="auth-intro__bottom">Bạn có thể đổi lại bất cứ lúc nào trong trang Hồ sơ.</p>
                </section>

                <section class="auth-panel" aria-labelledby="onboarding-heading">
                    <div class="onboarding-head">
                        <h1 id="onboarding-heading">Thiết lập hồ sơ</h1>
                        <span class="onboarding-count" id="stepCounter">Bước 1 / 3</span>
                    </div>

                    <div class="onboarding-progress" id="onboardingProgress" role="progressbar" aria-label="Tiến độ thiết lập hồ sơ"
                         aria-valuemin="0" aria-valuemax="3" aria-valuenow="1">
                        <span class="onboarding-progress__part is-on"></span>
                        <span class="onboarding-progress__part"></span>
                        <span class="onboarding-progress__part"></span>
                    </div>

                    <form id="onboardingForm" asp-controller="Onboarding" asp-action="Complete" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <section class="wizard-step" id="step1" aria-labelledby="step1Title">
                            <h2 class="onboarding-question" id="step1Title">Bạn đang theo đuổi lĩnh vực nào?</h2>
                            <p class="onboarding-question__hint">AI dùng thông tin này để chọn câu hỏi phù hợp hơn.</p>

                            <div class="onboarding-fields">
                                <div class="form-field">
                                    <label class="form-field__label" for="majorInput">Ngành học / Lĩnh vực chuyên môn</label>
                                    <div class="form-control-wrap">
                                        <i class="fa-solid fa-book-open" aria-hidden="true"></i>
                                        <input class="form-control" type="text" id="majorInput" asp-for="Major" placeholder="Ví dụ: Kỹ thuật phần mềm"
                                               autocomplete="organization-title" required maxlength="200" />
                                    </div>
                                </div>

                                <div class="form-field">
                                    <label class="form-field__label" for="targetPositionInput">Vị trí muốn ứng tuyển</label>
                                    <div class="form-control-wrap">
                                        <i class="fa-solid fa-briefcase" aria-hidden="true"></i>
                                        <input class="form-control" type="text" id="targetPositionInput" asp-for="TargetPosition"
                                               placeholder="Ví dụ: Backend Developer, Tester" required maxlength="200" />
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="wizard-step" id="step2" aria-labelledby="step2Title" hidden>
                            <input type="hidden" id="graduationStatusInput" asp-for="GraduationStatus" />
                            <h2 class="onboarding-question" id="step2Title">Bạn đang ở giai đoạn nào?</h2>
                            <p class="onboarding-question__hint">Chọn tình trạng học tập hiện tại của bạn.</p>

                            <div class="option-grid" role="group" aria-labelledby="step2Title">
                                        <button type="button" class="option-card" data-group="graduation" data-value="Current Student" aria-pressed="false">
                                            <span class="option-card__icon" aria-hidden="true"><i class="fa-solid fa-book-open"></i></span>
                                            <span class="option-card__text"><strong>Đang là sinh viên</strong><small>Vẫn đang theo học</small></span>
                                            <span class="option-card__check" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
                                        </button>
                                        <button type="button" class="option-card" data-group="graduation" data-value="Expecting Graduation" aria-pressed="false">
                                            <span class="option-card__icon" aria-hidden="true"><i class="fa-solid fa-calendar-check"></i></span>
                                            <span class="option-card__text"><strong>Sắp tốt nghiệp</strong><small>Kỳ cuối hoặc gần xong</small></span>
                                            <span class="option-card__check" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
                                        </button>
                                        <button type="button" class="option-card" data-group="graduation" data-value="Graduated" aria-pressed="false">
                                            <span class="option-card__icon" aria-hidden="true"><i class="fa-solid fa-graduation-cap"></i></span>
                                            <span class="option-card__text"><strong>Đã tốt nghiệp</strong><small>Đã hoàn thành chương trình</small></span>
                                            <span class="option-card__check" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
                                        </button>
                                        <button type="button" class="option-card" data-group="graduation" data-value="Other" aria-pressed="false">
                                            <span class="option-card__icon" aria-hidden="true"><i class="fa-solid fa-compass"></i></span>
                                            <span class="option-card__text"><strong>Khác</strong><small>Tự học hoặc chuyển ngành</small></span>
                                            <span class="option-card__check" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
                                        </button>
                            </div>
                        </section>

                        <section class="wizard-step" id="step3" aria-labelledby="step3Title" hidden>
                            <input type="hidden" id="experienceLevelInput" asp-for="ExperienceLevel" />
                            <h2 class="onboarding-question" id="step3Title">Kinh nghiệm của bạn ở mức nào?</h2>
                            <p class="onboarding-question__hint">Chọn mức gần nhất với bạn hiện tại.</p>

                            <div class="option-grid" role="group" aria-labelledby="step3Title">
                                        <button type="button" class="option-card" data-group="experience" data-value="Intern / Fresher" aria-pressed="false">
                                            <span class="option-card__icon" aria-hidden="true"><i class="fa-solid fa-seedling"></i></span>
                                            <span class="option-card__text"><strong>Intern / Fresher</strong><small>0–1 năm</small></span>
                                            <span class="level-bars" aria-hidden="true"><span class="is-on"></span><span></span><span></span><span></span></span>
                                            <span class="option-card__check" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
                                        </button>
                                        <button type="button" class="option-card" data-group="experience" data-value="Junior" aria-pressed="false">
                                            <span class="option-card__icon" aria-hidden="true"><i class="fa-solid fa-code"></i></span>
                                            <span class="option-card__text"><strong>Junior</strong><small>1–2 năm</small></span>
                                            <span class="level-bars" aria-hidden="true"><span class="is-on"></span><span class="is-on"></span><span></span><span></span></span>
                                            <span class="option-card__check" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
                                        </button>
                                        <button type="button" class="option-card" data-group="experience" data-value="Mid-Level" aria-pressed="false">
                                            <span class="option-card__icon" aria-hidden="true"><i class="fa-solid fa-layer-group"></i></span>
                                            <span class="option-card__text"><strong>Mid-Level</strong><small>2–4 năm</small></span>
                                            <span class="level-bars" aria-hidden="true"><span class="is-on"></span><span class="is-on"></span><span class="is-on"></span><span></span></span>
                                            <span class="option-card__check" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
                                        </button>
                                        <button type="button" class="option-card" data-group="experience" data-value="Senior / Lead" aria-pressed="false">
                                            <span class="option-card__icon" aria-hidden="true"><i class="fa-solid fa-star"></i></span>
                                            <span class="option-card__text"><strong>Senior / Lead</strong><small>Trên 4 năm</small></span>
                                            <span class="level-bars" aria-hidden="true"><span class="is-on"></span><span class="is-on"></span><span class="is-on"></span><span class="is-on"></span></span>
                                            <span class="option-card__check" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
                                        </button>
                            </div>
                        </section>

                        <p class="form-validation onboarding-error" id="onboardingError" role="alert" hidden></p>

                        <div class="onboarding-actions">
                            <button type="button" class="button button--secondary" id="btnBack" disabled>
                                <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
                                <span>Quay lại</span>
                            </button>
                            <button type="button" class="button button--primary button--icon" id="btnNext">
                                <span class="button__icon" aria-hidden="true"><i id="btnNextIcon" class="fa-solid fa-arrow-right"></i></span>
                                <span id="btnNextLabel">Tiếp tục</span>
                            </button>
                        </div>
                    </form>
                </section>
            </div>
        </main>
    </div>

    <partial name="Partials/_AppFooter" />
    <partial name="Partials/_Notify" />

    <div class="loading-overlay" id="onboardingLoading" role="alertdialog" aria-modal="true"
         aria-labelledby="onboardingLoadingTitle" aria-describedby="onboardingLoadingDescription" hidden>
        <div class="loading-dialog" tabindex="-1">
            <span class="loading-dialog__spinner" aria-hidden="true"></span>
            <h2 class="loading-dialog__title" id="onboardingLoadingTitle">Đang lưu hồ sơ</h2>
            <p class="loading-dialog__description" id="onboardingLoadingDescription">MockviewAI đang chuẩn bị câu hỏi phù hợp với bạn.</p>
            <small class="loading-dialog__note">Vui lòng không gửi yêu cầu nhiều lần.</small>
        </div>
    </div>

    <script src="~/js/Onboarding.js" asp-append-version="true" defer></script>
</body>
</html>
