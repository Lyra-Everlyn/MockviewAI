@model MockviewAI.Models.ViewModels.CvSavedViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đang lưu CV";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đang lưu CV - MockviewAI</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/UploadCV.css" asp-append-version="true" />
    <partial name="Partials/_ThemeHead" />
    <partial name="~/Views/CV/_CvStorageMeta.cshtml" model="Model" />
</head>
<body class="app-layout cv-page">
    <partial name="Partials/_AppNavigation" />
    <div class="app-layout__content">
        <main class="cv-page__main cv-saved-page">
            <script type="application/json" id="cvSavedData">@Html.Raw(Model.CvJson)</script>

            @* CvSaved.js: lưu xong thì chuyển về /CV, lỗi thì ẩn #cvSavedStatus và hiện #cvSavedError + #cvSavedActions *@
            <section class="cv-saved">
                <div class="cv-saved__state" id="cvSavedStatus" role="status">
                    <span class="cv-saved__spinner" aria-hidden="true">
                        <span class="cv-saved__ring"></span>
                        <span class="cv-saved__bubble"><i class="fa-regular fa-file-lines"></i></span>
                    </span>
                    <h1 class="cv-saved__title">Đang lưu CV</h1>
                    <p class="cv-saved__text">Đang lưu CV vào trình duyệt của bạn. Xong sẽ tự chuyển về "CV của tôi".</p>
                </div>

                <div class="cv-saved__state" id="cvSavedError" role="alert" hidden>
                    <span class="cv-saved__alert" aria-hidden="true"><i class="fa-solid fa-exclamation"></i></span>
                    <h1 class="cv-saved__title">Chưa lưu được CV</h1>
                    <p class="cv-saved__text" id="cvSavedErrorText"></p>
                </div>

                <div class="cv-saved__actions" id="cvSavedActions" hidden>
                    <a class="button button--alt button--icon" asp-controller="CV" asp-action="Index">
                        <span class="button__icon" aria-hidden="true"><i class="fa-solid fa-arrow-right"></i></span>
                        Mở CV của tôi
                    </a>
                </div>

                <noscript>
                    <p class="cv-notice cv-notice--error" role="alert">Trình duyệt đang tắt JavaScript nên không thể lưu CV. Hãy bật JavaScript rồi tải CV lên lại.</p>
                </noscript>
            </section>
        </main>
    </div>
    
    <partial name="Partials/_Notify" />
    <script src="~/js/CvStorage.js" asp-append-version="true"></script>
    <script src="~/js/CvSaved.js" asp-append-version="true"></script>
</body>
</html>
