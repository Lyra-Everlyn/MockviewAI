@model MockviewAI.Models.ViewModels.CvUploadViewModel
@{
    Layout = null;
    ViewData["Title"] = "Tải lên CV";
    ViewData["ActiveNav"] = "";
    var isReview = Model?.IsParsed == true && Model.ParsedData != null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tải lên CV - MockviewAI</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/UploadCV.css" asp-append-version="true" />
    <partial name="Partials/_ThemeHead" />
    <partial name="~/Views/CV/_CvStorageMeta.cshtml" model="Model" />
</head>
<body class="app-layout cv-page">
    <partial name="Partials/_AppNavigation" />
    <div class="app-layout__content">
        <main class="cv-page__main">
            <a class="cv-back" asp-controller="CV" asp-action="Index">
                <i class="fa-solid fa-chevron-left" aria-hidden="true"></i> Quay lại CV của tôi
            </a>

            @* #region Banner + tiến trình *@
            <section class="profile-banner profile-banner--cv cv-upload-banner" aria-labelledby="cv-upload-title">
                <div class="profile-banner__identity">
                    <span class="profile-banner__label">Hồ sơ ứng tuyển</span>
                    <h1 id="cv-upload-title" class="profile-banner__name">Tải lên CV của bạn</h1>
                    <p class="profile-banner__status">
                        AI trích xuất thông tin từ CV để bạn kiểm tra và dùng trong các buổi luyện phỏng vấn.
                        CV được lưu trên trình duyệt của bạn.
                    </p>
                </div>

                <ol class="cv-track" aria-label="Tiến trình xử lý CV">
                    <li class="cv-track__node @(isReview ? "is-done" : "is-current")" aria-current="@(isReview ? null : "step")">
                        <span class="cv-track__dot">
                            @if (isReview)
                            {
                                <i class="fa-solid fa-check" aria-hidden="true"></i>
                                <span class="visually-hidden">Đã xong:</span>
                            }
                            else
                            {
                                @:1
                            }
                        </span>
                        <span class="cv-track__label">Tải CV</span>
                    </li>
                    <li class="cv-track__line @(isReview ? "is-done" : "")" aria-hidden="true"></li>
                    <li class="cv-track__node @(isReview ? "is-current" : "")" aria-current="@(isReview ? "step" : null)">
                        <span class="cv-track__dot">2</span>
                        <span class="cv-track__label">Kiểm tra &amp; lưu</span>
                    </li>
                </ol>
            </section>
            @* #endregion *@

            @* #region Thông báo *@
            @if (!string.IsNullOrWhiteSpace(Model?.ErrorMessage))
            {
                <div class="cv-notice cv-notice--error" role="alert">
                    <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
                    <span>@Model.ErrorMessage</span>
                </div>
            }
            <div asp-validation-summary="ModelOnly" class="cv-validation" role="alert"></div>
            @* #endregion *@

            @if (!isReview)
            {
                @* #region Bước 1: chọn tệp *@
                <div class="cv-notice cv-notice--error" id="cvLimitNotice" role="alert" hidden>
                    <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
                    <span>
                        Bạn đã lưu đủ @Model!.MaxCvs CV trên trình duyệt này.
                        <a asp-controller="CV" asp-action="Index">Mở "CV của tôi"</a> để xoá bớt rồi tải CV mới.
                    </span>
                </div>

                <div class="cv-layout">
                    <section class="cv-card" aria-labelledby="cv-pick-title">
                        <header class="cv-card__head">
                            <h2 id="cv-pick-title">Chọn tài liệu CV</h2>
                            <p>Chỉ nhận file PDF. Nên dùng CV xuất trực tiếp từ Word, Canva, TopCV…</p>
                        </header>

                        <form id="cvUploadForm" asp-controller="CV" asp-action="UploadCv"
                              enctype="multipart/form-data" method="post"
                              data-loading-text="Đang phân tích..."
                              data-loading-overlay="AI đang đọc và trích xuất nội dung CV. Quá trình này thường mất 10–40 giây, vui lòng không đóng trang.">
                            @Html.AntiForgeryToken()
                            <div class="cv-dropzone" id="cvDropzone">
                                <span class="cv-dropzone__bubble" aria-hidden="true"><i class="fa-solid fa-file-arrow-up"></i></span>
                                <strong>Kéo thả CV vào đây</strong>
                                <p>hoặc</p>
                                <label class="button button--info button--small cv-pick-button" for="CvFile">Chọn tệp CV</label>
                                <input id="CvFile" asp-for="CvFile" type="file" accept=".pdf,application/pdf" required class="cv-file-input" aria-describedby="cvFileHelp cvFileError" />
                                <span id="cvFileHelp" class="cv-dropzone__help">PDF, tối đa 10 MB</span>
                            </div>
                            <span asp-validation-for="CvFile" class="cv-validation"></span>
                            <p id="cvFileError" class="cv-file-error" role="alert" aria-live="polite" hidden></p>

                            <div class="cv-selected" id="cvSelected" hidden>
                                <span class="cv-selected__icon" aria-hidden="true">PDF</span>
                                <span class="cv-selected__details"><strong id="cvSelectedName"></strong><small id="cvSelectedSize"></small></span>
                                <button type="button" id="cvRemoveFile" class="cv-selected__remove" aria-label="Bỏ tệp đã chọn" title="Bỏ tệp"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
                            </div>

                            <div class="cv-card__footer">
                                <button class="button button--primary button--icon" type="submit">
                                    <span class="button__icon" aria-hidden="true"><i class="fa-solid fa-arrow-right"></i></span>
                                    Phân tích CV
                                </button>
                            </div>
                        </form>
                    </section>

                    <aside class="cv-side" aria-label="Hướng dẫn tải CV">
                        <section class="cv-card cv-guide" aria-labelledby="cv-how-title">
                            <h2 id="cv-how-title">Điều gì sẽ diễn ra?</h2>
                            <ol class="cv-guide__list">
                                <li><span class="cv-guide__num">1</span><p><strong>Tải lên</strong><small>Chọn file CV dạng PDF.</small></p></li>
                                <li><span class="cv-guide__num">2</span><p><strong>AI trích xuất</strong><small>Phân tích thông tin có trong tài liệu.</small></p></li>
                                <li><span class="cv-guide__num">3</span><p><strong>Bạn xác nhận</strong><small>Kiểm tra, chỉnh sửa rồi mới lưu.</small></p></li>
                            </ol>
                        </section>
                        <p class="cv-hint">
                            <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                            <span>CV có thể chứa thông tin cá nhân. Chỉ tải lên tài liệu bạn có quyền sử dụng và kiểm tra nội dung trước khi lưu.</span>
                        </p>
                    </aside>
                </div>
                @* #endregion *@
            }
            else
            {
                @* #region Bước 2: kiểm tra và lưu *@
                var data = Model!.ParsedData!;
                var hasFound = data.WorkExperiences.Count > 0 || data.Projects.Count > 0 || data.Educations.Count > 0;

                <div class="cv-notice cv-notice--success" role="status">
                    <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                    <span>Đã trích xuất CV. Hãy kiểm tra thông tin AI nhận diện trước khi lưu.</span>
                </div>

                <div class="cv-layout">
                    <form class="cv-card cv-review" asp-controller="CV" asp-action="SaveCv" method="post"
                          aria-label="Kiểm tra thông tin CV"
                          data-loading-text="Đang lưu CV..."
                          data-loading-overlay="Đang lưu CV vào trình duyệt của bạn.">
                        @Html.AntiForgeryToken()

                        <section class="cv-review__section" aria-labelledby="cv-sec-info">
                            <h2 id="cv-sec-info" class="cv-review__title section-header__title--marked">Thông tin cá nhân &amp; vị trí</h2>
                            <div class="cv-fields">
                                <div class="form-field">
                                    <label class="form-field__label" asp-for="ParsedData!.FullName">Họ và tên</label>
                                    <input class="form-control" asp-for="ParsedData!.FullName" maxlength="100" placeholder="Họ và tên trong CV" />
                                </div>
                                <div class="form-field">
                                    <label class="form-field__label" asp-for="ParsedData!.TargetJobTitle">Vị trí ứng tuyển</label>
                                    <input class="form-control" asp-for="ParsedData!.TargetJobTitle" maxlength="120" placeholder="Ví dụ: .NET Developer" />
                                </div>
                                <div class="form-field cv-fields__full">
                                    <label class="form-field__label" asp-for="ParsedData!.CareerObjective">Mục tiêu nghề nghiệp</label>
                                    <textarea class="form-control cv-textarea" asp-for="ParsedData!.CareerObjective" rows="5" maxlength="1500" placeholder="Mục tiêu nghề nghiệp của bạn..."></textarea>
                                </div>
                            </div>
                        </section>

                        <section class="cv-review__section" aria-labelledby="cv-sec-skills">
                            <h2 id="cv-sec-skills" class="cv-review__title section-header__title--marked">Kỹ năng</h2>
                            <div class="form-field">
                                <label class="form-field__label" for="HardSkillsString">Kỹ năng chuyên môn</label>
                                <input class="form-control" id="HardSkillsString" type="text"
                                       name="HardSkillsString"
                                       value="@string.Join(", ", data.HardSkills)"
                                       placeholder="C#, ASP.NET Core, SQL Server..."
                                       aria-describedby="cvSkillsHelp" />
                                <small id="cvSkillsHelp" class="cv-field-help">Ngăn cách từng kỹ năng bằng dấu phẩy.</small>
                            </div>
                        </section>

                        @if (hasFound)
                        {
                            <section class="cv-review__section" aria-labelledby="cv-sec-found">
                                <h2 id="cv-sec-found" class="cv-review__title section-header__title--marked">Kinh nghiệm, dự án &amp; học vấn (AI nhận diện)</h2>
                                @* Luồng 3 nhóm: chấm màu + đường nối dọc, mỗi mục gồm tên và dòng phụ *@
                                <ol class="cv-flow" aria-label="Thông tin AI nhận diện">
                                    @if (data.WorkExperiences.Count > 0)
                                    {
                                        <li class="cv-flow__group cv-flow__group--job">
                                            <span class="cv-flow__label">Kinh nghiệm · @data.WorkExperiences.Count</span>
                                            <ul class="cv-flow__items">
                                                @foreach (var job in data.WorkExperiences)
                                                {
                                                    var jobMeta = string.Join(" · ", new[] { job.CompanyName, job.Duration }.Where(x => !string.IsNullOrWhiteSpace(x)));
                                                    <li>
                                                        <strong class="cv-flow__title">@job.JobTitle</strong>
                                                        @if (!string.IsNullOrEmpty(jobMeta))
                                                        {
                                                            <span class="cv-flow__meta">@jobMeta</span>
                                                        }
                                                    </li>
                                                }
                                            </ul>
                                        </li>
                                    }
                                    @if (data.Projects.Count > 0)
                                    {
                                        <li class="cv-flow__group cv-flow__group--project">
                                            <span class="cv-flow__label">Dự án · @data.Projects.Count</span>
                                            <ul class="cv-flow__items">
                                                @foreach (var project in data.Projects)
                                                {
                                                    <li>
                                                        <strong class="cv-flow__title">@project.Name</strong>
                                                        @if (project.Technologies.Count > 0)
                                                        {
                                                            <span class="cv-flow__meta">@string.Join(", ", project.Technologies)</span>
                                                        }
                                                    </li>
                                                }
                                            </ul>
                                        </li>
                                    }
                                    @if (data.Educations.Count > 0)
                                    {
                                        <li class="cv-flow__group cv-flow__group--school">
                                            <span class="cv-flow__label">Học vấn · @data.Educations.Count</span>
                                            <ul class="cv-flow__items">
                                                @foreach (var school in data.Educations)
                                                {
                                                    <li>
                                                        <strong class="cv-flow__title">@school.SchoolName</strong>
                                                        @if (!string.IsNullOrWhiteSpace(school.Major))
                                                        {
                                                            <span class="cv-flow__meta">@school.Major</span>
                                                        }
                                                    </li>
                                                }
                                            </ul>
                                        </li>
                                    }
                                </ol>
                                <small class="cv-field-help">Kinh nghiệm: khoảng @data.TotalYearsOfExperience năm. Nếu thông tin sai nhiều, hãy chỉnh lại CV rồi tải lên lại.</small>
                            </section>
                        }

                        <div class="cv-review__actions">
                            <a class="button button--secondary" asp-controller="CV" asp-action="UploadCv">
                                <i class="fa-solid fa-rotate-left" aria-hidden="true"></i> Tải CV khác
                            </a>
                            <button class="button button--primary button--icon" type="submit">
                                <span class="button__icon" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
                                Xác nhận &amp; lưu CV
                            </button>
                        </div>
                    </form>

                    <aside class="cv-side" aria-label="Lưu ý khi kiểm tra CV">
                        <section class="cv-card cv-guide" aria-labelledby="cv-before-title">
                            <h2 id="cv-before-title">Trước khi lưu</h2>
                            <p class="cv-guide__copy">AI có thể nhận diện sai với PDF scan mờ, CV nhiều cột hoặc thuật ngữ chuyên ngành.</p>
                            <ul class="cv-checklist">
                                <li><i class="fa-solid fa-check" aria-hidden="true"></i> Kiểm tra lại họ tên và vị trí mong muốn.</li>
                                <li><i class="fa-solid fa-check" aria-hidden="true"></i> Điều chỉnh mục tiêu nghề nghiệp cho đúng ý bạn.</li>
                                <li><i class="fa-solid fa-check" aria-hidden="true"></i> Chỉ giữ lại kỹ năng có trong kinh nghiệm thực tế.</li>
                            </ul>
                        </section>
                    </aside>
                </div>
                @* #endregion *@
            }
        </main>
    </div>
    
    <partial name="Partials/_Notify" />
    <script src="~/js/CvStorage.js" asp-append-version="true" defer></script>
    <script src="~/js/UploadCV.js" asp-append-version="true" defer></script>
    <script src="~/js/_SubmitLoading.js" asp-append-version="true" defer></script>
</body>
</html>
