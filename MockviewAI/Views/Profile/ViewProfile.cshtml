@model MockviewAI.Models.ViewModels.ProfileViewModel
@{
    Layout = null;
    ViewData["ActiveNav"] = "";
    var userName = User.Identity?.Name ?? "";
    var initial = string.IsNullOrWhiteSpace(userName) ? "?" : userName.Substring(0, 1).ToUpper();
    var avatarUrl = User.FindFirst("AvatarUrl")?.Value;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hồ sơ - MockviewAI</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/ViewProfile.css">
    <link rel="stylesheet" href="~/css/theme.css">
</head>
<body>
    <partial name="Partials/_TopNav" />

    <main class="profile-page">
        <header class="page-heading">
            <div>
                <span class="eyebrow">TÀI KHOẢN CỦA BẠN</span>
                <h1 class="page-title">Hồ sơ cá nhân</h1>
                <p class="page-description">Quản lý thông tin và theo dõi hành trình luyện phỏng vấn của bạn.</p>
            </div>
        </header>

        <div class="profile-grid">
            <aside class="profile-sidebar">
                <section class="profile-card">
                    <div class="profile-card-top">
                        <div class="user-avatar">
                            @if (!string.IsNullOrEmpty(avatarUrl))
                            {
                                <img src="@avatarUrl" alt="Ảnh đại diện" referrerpolicy="no-referrer" />
                            }
                            else
                            {
                                @Model.AvatarInitial
                            }
                        </div>
                        <span class="profile-status-dot" aria-label="Tài khoản đang hoạt động"></span>
                    </div>

                    <div class="user-titles">
                        <h2>@Model.FullName</h2>
                        <p class="user-status">@Model.StatusText</p>
                        @if (!string.IsNullOrEmpty(Model.ExperienceLevel))
                        {
                            <span class="experience-label">@Model.ExperienceLevel</span>
                        }
                    </div>

                    <div class="profile-divider"></div>

                    <div class="profile-details">
                        @if (!string.IsNullOrEmpty(Model.Major))
                        {
                            <div class="detail-row">
                                <span class="detail-icon" aria-hidden="true"><i class="bi bi-mortarboard"></i></span>
                                <div>
                                    <span class="detail-label">Chuyên ngành</span>
                                    <span class="detail-value">@Model.Major</span>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.TargetPosition))
                        {
                            <div class="detail-row">
                                <span class="detail-icon" aria-hidden="true"><i class="bi bi-briefcase"></i></span>
                                <div>
                                    <span class="detail-label">Vị trí mục tiêu</span>
                                    <span class="detail-value">@Model.TargetPosition</span>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="profile-action-buttons">
                        <button type="button" class="btn-edit-profile" onclick="location.href='/Profile/Edit'">
                            <i class="bi bi-pencil" aria-hidden="true"></i>
                            Chỉnh sửa hồ sơ
                        </button>
                        <button type="button" class="btn-edit-profile" onclick="location.href='/Profile/CV'">
                            <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                            CV của tôi
                        </button>
                    </div>

                </section>

                <a class="feedback-card" href="/Feedback">
                    <span class="feedback-icon" aria-hidden="true"><i class="bi bi-stars"></i></span>
                    <span class="feedback-content">
                        <strong>Góp ý cho bản BETA</strong>
                        <span>Chia sẻ trải nghiệm để MockviewAI tốt hơn.</span>
                        <em>Gửi góp ý <i class="bi bi-arrow-right" aria-hidden="true"></i></em>
                    </span>
                </a>

                <section class="account-card" aria-label="Cài đặt tài khoản">
                    <div class="account-card-header">
                        <span class="section-kicker">TÀI KHOẢN</span>
                        <h3>Quản lý tài khoản</h3>
                    </div>
                    <div class="account-actions">
                        <a href="#" class="account-action account-action-blue">
                            <span class="account-action-icon" aria-hidden="true"><i class="bi bi-mic-mute"></i></span>
                            <span class="account-action-copy"><strong>Xoá ghi âm</strong><small>Xoá dữ liệu ghi âm đã lưu</small></span>
                            <span class="account-action-arrow" aria-hidden="true"><i class="bi bi-chevron-right"></i></span>
                        </a>
                        <a href="#" class="account-action account-action-danger">
                            <span class="account-action-icon" aria-hidden="true"><i class="bi bi-person-x"></i></span>
                            <span class="account-action-copy"><strong>Xoá tài khoản</strong><small>Xoá vĩnh viễn tài khoản của bạn</small></span>
                            <span class="account-action-arrow" aria-hidden="true"><i class="bi bi-chevron-right"></i></span>
                        </a>
                        <a href="#" class="account-action" onclick="onClickLogout(event)">
                            <span class="account-action-icon" aria-hidden="true"><i class="bi bi-box-arrow-right"></i></span>
                            <span class="account-action-copy"><strong>Đăng xuất</strong><small>Kết thúc phiên đăng nhập hiện tại</small></span>
                            <span class="account-action-arrow" aria-hidden="true"><i class="bi bi-chevron-right"></i></span>
                        </a>
                    </div>
                </section>
            </aside>

            <section class="history-panel">
                <div class="section-heading">
                    <div>
                        <span class="eyebrow">HÀNH TRÌNH CỦA BẠN</span>
                        <h2>Lịch sử luyện tập</h2>
                        <p>Các buổi phỏng vấn gần đây của bạn.</p>
                    </div>
                    <a href="/Home/History" class="view-all-link">Xem tất cả <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                </div>

                <div class="history-list">
                    @if (!Model.RecentSessions.Any())
                    {
                        <div class="empty-history">
                            <div class="empty-history-icon" aria-hidden="true"><i class="bi bi-clock-history"></i></div>
                            <strong>Chưa có buổi luyện tập nào</strong>
                            <p>Bắt đầu một buổi phỏng vấn để xem tiến độ của bạn tại đây.</p>
                            <a href="/Interview/Create">Bắt đầu luyện tập <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                        </div>
                    }
                    @for (int i = 0; i < Model.RecentSessions.Count; i++)
                    {
                        var s = Model.RecentSessions[i];
                        var url = s.IsInProgress ? $"/Interview/Room/{s.SessionId}" : $"/Home/InterviewDetail/{s.SessionId}";

                        <a class="history-card @(i >= 2 ? "hide-on-mobile" : "")" href="@url">
                            <span class="history-leading-icon" aria-hidden="true"><i class="bi bi-journal-text"></i></span>
                            <span class="history-main">
                                <strong class="card-role">@s.RoleName</strong>
                                <span class="card-badges">
                                    <span class="badge-score">@(s.HasScore ? s.Score + " điểm" : s.StatusText)</span>
                                    @if (!string.IsNullOrEmpty(s.AnxietyText))
                                    {
                                        <span class="@(s.AnxietyImproved ? "badge-anxiety-good" : "badge-anxiety-warn")">@s.AnxietyText</span>
                                    }
                                </span>
                            </span>
                            <span class="history-meta">
                                <span class="date-full hide-on-mobile">@s.DateFormatted</span>
                                <span class="date-short hide-on-desktop">@s.DateFormatted</span>
                                <span class="question-count hide-on-mobile">@s.QuestionCount câu hỏi</span>
                            </span>
                            <span class="history-arrow" aria-hidden="true"><i class="bi bi-chevron-right"></i></span>
                        </a>
                    }
                </div>
            </section>
        </div>
    </main>

    <nav class="mobile-nav hide-on-desktop" aria-label="Điều hướng chính">
        <a href="/Home" class="nav-item">
            <i class="bi bi-house-door" aria-hidden="true" style="font-size: 21px;"></i>
            <span>Trang chủ</span>
        </a>
        <a href="/Interview/Create" class="nav-item">
            <i class="bi bi-laptop" aria-hidden="true" style="font-size: 21px;"></i>
            <span>Luyện tập</span>
        </a>
        <a href="/Home/History" class="nav-item">
            <i class="bi bi-clock-history" aria-hidden="true" style="font-size: 21px;"></i>
            <span>Lịch sử</span>
        </a>
        <a href="/Profile" class="nav-item active">
            <i class="bi bi-person" aria-hidden="true" style="font-size: 21px;"></i>
            <span>Hồ sơ</span>
        </a>
    </nav>

    <partial name="Partials/_LogoutPartial" />
    <script src="~/js/_Logout.js"></script>
    <partial name="Partials/_Notify" />
</body>
</html>