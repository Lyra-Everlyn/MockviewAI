@model MockviewAI.Models.ViewModels.ProfileViewModel
@{
    Layout = null;
    ViewData["ActiveNav"] = "profile";

    var userName = User.Identity?.Name ?? "";
    var avatarUrl = User.FindFirst("AvatarUrl")?.Value;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Hồ sơ - MockviewAI</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/base.css">
    <link rel="stylesheet" href="~/css/components.css">
    <link rel="stylesheet" href="~/css/ViewProfile.css">
    <link rel="stylesheet" href="~/css/themes/theme-indigo.css">
</head>
<body>
    <partial name="Partials/_AppNavigation" />

    <main class="page-shell profile-page">
        <header class="page-header profile-page__header">
            <div class="page-header__content">
                <span class="page-header__eyebrow">TÀI KHOẢN CỦA BẠN</span>
                <h1 class="page-header__title">Hồ sơ cá nhân</h1>
                <p class="page-header__description">
                    Quản lý thông tin và theo dõi hành trình luyện phỏng vấn của bạn.
                </p>
            </div>
        </header>

        <div class="profile-layout">
            <aside class="profile-sidebar">
                <section class="profile-summary-card">
                    <div class="profile-summary-card__avatar-wrap">
                        <div class="profile-summary-card__avatar">
                            @if (!string.IsNullOrWhiteSpace(avatarUrl))
                            {
                                <img src="@avatarUrl"
                                     alt="Ảnh đại diện"
                                     referrerpolicy="no-referrer" />
                            }
                            else
                            {
                                @Model.AvatarInitial
                            }
                        </div>

                        <span class="profile-summary-card__status"
                              aria-label="Tài khoản đang hoạt động"></span>
                    </div>

                    <div class="profile-summary-card__identity">
                        <h2 class="profile-summary-card__name">@userName</h2>
                        <p class="profile-summary-card__status-text">@Model.StatusText</p>

                        @if (!string.IsNullOrWhiteSpace(Model.ExperienceLevel))
                        {
                            <span class="status-chip">@Model.ExperienceLevel</span>
                        }
                    </div>

                    <div class="profile-summary-card__divider"></div>

                    <div class="profile-detail-list">
                        @if (!string.IsNullOrWhiteSpace(Model.Major))
                        {
                            <div class="profile-detail">
                                <span class="profile-detail__icon" aria-hidden="true">
                                    <i class="fa-solid fa-graduation-cap"></i>
                                </span>

                                <div class="profile-detail__content">
                                    <span class="profile-detail__label">Chuyên ngành</span>
                                    <strong class="profile-detail__value">@Model.Major</strong>
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.TargetPosition))
                        {
                            <div class="profile-detail">
                                <span class="profile-detail__icon" aria-hidden="true">
                                    <i class="fa-solid fa-briefcase"></i>
                                </span>

                                <div class="profile-detail__content">
                                    <span class="profile-detail__label">Vị trí mục tiêu</span>
                                    <strong class="profile-detail__value">@Model.TargetPosition</strong>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="profile-summary-card__actions">
                        <a href="/Profile/Edit" class="button button--secondary profile-action-button">
                            <i class="fa-solid fa-pen"></i>
                            Chỉnh sửa hồ sơ
                        </a>

                        <a href="/Profile/CV" class="button button--secondary profile-action-button">
                            <i class="fa-regular fa-file-lines"></i>
                            CV của tôi
                        </a>
                    </div>
                </section>

                <a href="/Feedback" class="action-card feedback-action-card">
                    <div class="action-card__icon" aria-hidden="true">
                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                    </div>

                    <div class="action-card__content">
                        <span class="action-card__eyebrow">BETA</span>
                        <h3 class="action-card__title">Đóng góp ý kiến</h3>
                        <p class="action-card__description">
                            Chia sẻ trải nghiệm để MockviewAI cải thiện tốt hơn.
                        </p>

                        <span class="action-card__action">
                            Gửi góp ý
                            <span class="action-card__chevron" aria-hidden="true">
                                <i class="fa-solid fa-chevron-right"></i>
                            </span>
                        </span>
                    </div>
                </a>

                <section class="settings-card" aria-labelledby="account-settings-title">
                    <div class="settings-card__header">
                        <span class="section-header__eyebrow">TÀI KHOẢN</span>
                        <h2 id="account-settings-title" class="settings-card__title">
                            Quản lý tài khoản
                        </h2>
                    </div>

                    <div class="settings-list">
                        <a href="#" class="settings-item">
                            <span class="settings-item__icon" aria-hidden="true">
                                <i class="fa-solid fa-microphone-slash"></i>
                            </span>

                            <span class="settings-item__content">
                                <strong class="settings-item__title">Xoá ghi âm</strong>
                                <span class="settings-item__description">
                                    Xoá dữ liệu ghi âm đã lưu
                                </span>
                            </span>

                            <span class="settings-item__chevron" aria-hidden="true">
                                <i class="fa-solid fa-chevron-right"></i>
                            </span>
                        </a>

                        <a href="#" class="settings-item settings-item--danger">
                            <span class="settings-item__icon" aria-hidden="true">
                                <i class="fa-solid fa-user-xmark"></i>
                            </span>

                            <span class="settings-item__content">
                                <strong class="settings-item__title">Xoá tài khoản</strong>
                                <span class="settings-item__description">
                                    Xoá vĩnh viễn tài khoản của bạn
                                </span>
                            </span>

                            <span class="settings-item__chevron" aria-hidden="true">
                                <i class="fa-solid fa-chevron-right"></i>
                            </span>
                        </a>

                        <a href="#" class="settings-item" onclick="onClickLogout(event)">
                            <span class="settings-item__icon" aria-hidden="true">
                                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                            </span>

                            <span class="settings-item__content">
                                <strong class="settings-item__title">Đăng xuất</strong>
                                <span class="settings-item__description">
                                    Kết thúc phiên đăng nhập hiện tại
                                </span>
                            </span>

                            <span class="settings-item__chevron" aria-hidden="true">
                                <i class="fa-solid fa-chevron-right"></i>
                            </span>
                        </a>
                    </div>
                </section>
            </aside>

            <section class="profile-history-card" aria-labelledby="profile-history-title">
                <div class="section-header section-header--with-action profile-history-card__header">
                    <div class="section-header__content">
                        <span class="section-header__eyebrow">HÀNH TRÌNH CỦA BẠN</span>
                        <h2 id="profile-history-title" class="section-header__title">
                            Lịch sử luyện tập
                        </h2>
                        <p class="section-header__description">
                            Các buổi phỏng vấn gần đây của bạn.
                        </p>
                    </div>

                    <a href="/Home/History" class="section-header__action">
                        Xem tất cả
                        <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                    </a>
                </div>

                @if (!Model.RecentSessions.Any())
                {
                    <div class="empty-state">
                        <div class="empty-state__icon" aria-hidden="true">
                            <i class="fa-regular fa-clock"></i>
                        </div>

                        <div class="empty-state__content">
                            <h3 class="empty-state__title">Chưa có buổi luyện tập nào</h3>
                            <p class="empty-state__description">
                                Bắt đầu một buổi phỏng vấn để xem tiến độ của bạn tại đây.
                            </p>
                        </div>

                        <a href="/Interview/Create" class="button button--secondary">
                            Bắt đầu luyện tập
                            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                        </a>
                    </div>
                }
                else
                {
                    <div class="session-list">
                        @for (int i = 0; i < Model.RecentSessions.Count; i++)
                        {
                            var session = Model.RecentSessions[i];

                            <div class="profile-session-item @(i >= 3 ? "profile-session-item--extra" : "")">
                                <partial name="Partials/_SessionCard" model="session" />
                            </div>
                        }
                    </div>
                }
            </section>
        </div>
    </main>
    <partial name="Partials/_Notify" />
    <partial name="Partials/_AppFooter" />
    <partial name="Partials/_LogoutPartial" />
    <script src="~/js/_Logout.js"></script>
    
</body>
</html>
