@model MockviewAI.Models.ViewModels.ProfileViewModel
@{
    Layout = null;
    ViewData["ActiveNav"] = "profile";

    var userName = User.Identity?.Name ?? "";
    var avatarUrl = User.FindFirst("AvatarUrl")?.Value;
    const string NotSet = "Chưa cập nhật";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Hồ sơ - MockviewAI</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/base.css">
    <link rel="stylesheet" href="~/css/components.css">
    <link rel="stylesheet" href="~/css/ViewProfile.css" asp-append-version="true">
    <partial name="Partials/_ThemeHead" />
</head>
<body>
    <partial name="Partials/_AppNavigation" />

    <main class="page-shell profile-page">
        @* #region Banner *@
        <section class="profile-banner" aria-labelledby="profile-name">
            <div class="profile-banner__avatar-wrap">
                <div class="profile-banner__avatar">
                    @if (!string.IsNullOrWhiteSpace(avatarUrl))
                    {
                        <img src="@avatarUrl" alt="Ảnh đại diện" referrerpolicy="no-referrer" />
                    }
                    else
                    {
                        @Model.AvatarInitial
                    }
                </div>
                <span class="profile-banner__presence" title="Đang hoạt động" aria-label="Tài khoản đang hoạt động"></span>
            </div>

            <div class="profile-banner__identity">
                <span class="profile-banner__label">Hồ sơ cá nhân</span>
                <h1 id="profile-name" class="profile-banner__name">@userName</h1>
                @if (!string.IsNullOrWhiteSpace(Model.StatusText))
                {
                    <p class="profile-banner__status">@Model.StatusText</p>
                }

                <div class="profile-banner__actions">
                    <a href="/Profile/Edit" class="button button--primary button--icon">
                        <span class="button__icon" aria-hidden="true"><i class="fa-solid fa-pen"></i></span>
                        Chỉnh sửa hồ sơ
                    </a>
                    <a href="/CV" class="button button--alt button--icon">
                        <span class="button__icon" aria-hidden="true"><i class="fa-regular fa-file-lines"></i></span>
                        CV của tôi
                    </a>
                </div>
            </div>
        </section>
        @* #endregion *@

        @* #region Thông tin nghề nghiệp *@
        <section class="profile-facts" aria-label="Thông tin nghề nghiệp">
            <div class="profile-fact">
                <span class="profile-fact__icon profile-fact__icon--major" aria-hidden="true"><i class="fa-solid fa-graduation-cap"></i></span>
                <div class="profile-fact__content">
                    <span class="profile-fact__label">Chuyên ngành</span>
                    <strong class="profile-fact__value">@(string.IsNullOrWhiteSpace(Model.Major) ? NotSet : Model.Major)</strong>
                </div>
            </div>

            <div class="profile-fact">
                <span class="profile-fact__icon profile-fact__icon--target" aria-hidden="true"><i class="fa-solid fa-briefcase"></i></span>
                <div class="profile-fact__content">
                    <span class="profile-fact__label">Vị trí mục tiêu</span>
                    <strong class="profile-fact__value">@(string.IsNullOrWhiteSpace(Model.TargetPosition) ? NotSet : Model.TargetPosition)</strong>
                </div>
            </div>

            <div class="profile-fact">
                <span class="profile-fact__icon profile-fact__icon--level" aria-hidden="true"><i class="fa-solid fa-star"></i></span>
                <div class="profile-fact__content">
                    <span class="profile-fact__label">Kinh nghiệm</span>
                    <strong class="profile-fact__value">@(string.IsNullOrWhiteSpace(Model.ExperienceLevel) ? NotSet : Model.ExperienceLevel)</strong>
                </div>
            </div>
        </section>
        @* #endregion *@

        <div class="profile-panels">
            @* #region Quản lý tài khoản *@
            <section class="settings-card" aria-labelledby="account-settings-title">
                <div class="settings-card__header">
                    <h2 id="account-settings-title" class="settings-card__title">Quản lý tài khoản</h2>
                </div>

                <div class="settings-list">
                    <button type="button"
                            class="settings-item settings-item--button"
                            data-theme-toggle
                            aria-pressed="false"
                            aria-label="Chuyển sang giao diện tối">
                        <span class="settings-item__icon" aria-hidden="true">
                            <i class="fa-solid fa-moon theme-state--light"></i>
                            <i class="fa-solid fa-sun theme-state--dark"></i>
                        </span>
                        <span class="settings-item__content">
                            <strong class="settings-item__title">Chế độ tối</strong>
                            <span class="settings-item__description">
                                <span class="theme-state--light">Đang dùng giao diện sáng</span>
                                <span class="theme-state--dark">Đang dùng giao diện tối</span>
                            </span>
                        </span>
                        <span class="settings-switch" aria-hidden="true"></span>
                    </button>

                    <button type="button" class="settings-item settings-item--button" onclick="onClickLogout(event)">
                        <span class="settings-item__icon" aria-hidden="true">
                            <i class="fa-solid fa-arrow-right-from-bracket"></i>
                        </span>
                        <span class="settings-item__content">
                            <strong class="settings-item__title">Đăng xuất</strong>
                            <span class="settings-item__description">Kết thúc phiên đăng nhập hiện tại</span>
                        </span>
                        <span class="settings-item__chevron" aria-hidden="true">
                            <i class="fa-solid fa-chevron-right"></i>
                        </span>
                    </button>

                    <button type="button" class="settings-item settings-item--button settings-item--danger" disabled>
                        <span class="settings-item__icon" aria-hidden="true">
                            <i class="fa-solid fa-user-xmark"></i>
                        </span>
                        <span class="settings-item__content">
                            <strong class="settings-item__title">Xoá tài khoản</strong>
                            <span class="settings-item__description">Chức năng đang được phát triển</span>
                        </span>
                    </button>
                </div>
            </section>
            @* #endregion *@

            @* #region Hành trình của bạn *@
            <section class="journey-card" aria-labelledby="journey-title">
                <div class="journey-card__header">
                    <h2 id="journey-title" class="journey-card__title">Hành trình của bạn</h2>
                    <span class="journey-card__since">Tham gia từ @Model.MemberSince.ToString("dd/MM/yyyy")</span>
                </div>

                <div class="journey-grid">
                    <div class="journey-stat">
                        <span class="journey-stat__label">Chuỗi luyện tập</span>
                        <strong class="journey-stat__value journey-stat__value--streak">@Model.StreakDays <small>ngày liên tiếp</small></strong>
                    </div>
                    <div class="journey-stat">
                        <span class="journey-stat__label">Đã luyện</span>
                        <strong class="journey-stat__value journey-stat__value--sessions">@Model.TotalSessions <small>buổi</small></strong>
                    </div>
                    <div class="journey-stat">
                        <span class="journey-stat__label">Câu đã trả lời</span>
                        <strong class="journey-stat__value journey-stat__value--answers">@Model.AnsweredQuestions</strong>
                    </div>
                    <div class="journey-stat">
                        <span class="journey-stat__label">Đã đồng hành</span>
                        <strong class="journey-stat__value">@Model.DaysWithUs <small>ngày</small></strong>
                    </div>
                </div>

                @if (Model.CurrentLoginAt.HasValue)
                {
                    <p class="journey-card__login">
                        <span class="journey-card__dot" aria-hidden="true"></span>
                        Đăng nhập lần này lúc @Model.CurrentLoginAt.Value.ToString("HH:mm, dd/MM/yyyy")
                    </p>
                }
            </section>
            @* #endregion *@
        </div>
    </main>
    <partial name="Partials/_Notify" />
    <partial name="Partials/_LogoutPartial" />
    <script src="~/js/_Logout.js"></script>
</body>
</html>
