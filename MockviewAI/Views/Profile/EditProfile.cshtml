@model MockviewAI.Models.ViewModels.ProfileEditViewModel

@{
    Layout = null;
    ViewData["ActiveNav"] = "profile";

    var userName = User.Identity?.Name ?? "";
    var initial = string.IsNullOrWhiteSpace(userName) ? "?" : userName.Substring(0, 1).ToUpper();
    var avatarUrl = User.FindFirst("AvatarUrl")?.Value;

    var graduation = string.IsNullOrWhiteSpace(Model?.GraduationStatus) ? "Expecting Graduation" : Model.GraduationStatus;
    var experience = string.IsNullOrWhiteSpace(Model?.ExperienceLevel) ? "Intern / Fresher" : Model.ExperienceLevel;

    var graduationOptions = new[]
    {
        ("Current Student", "Đang đi học"),
        ("Expecting Graduation", "Sắp ra trường"),
        ("Graduated", "Đã ra trường"),
        ("Other", "Khác")
    };

    var experienceOptions = new[]
    {
        ("Intern / Fresher", "Mới bắt đầu sự nghiệp"),
        ("Junior", "Đã có kinh nghiệm nền tảng"),
        ("Mid-Level", "Làm việc độc lập"),
        ("Senior / Lead", "Chuyên sâu hoặc dẫn dắt")
    };
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Chỉnh sửa hồ sơ - MockviewAI</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/EditProfile.css" asp-append-version="true">
    <partial name="Partials/_ThemeHead" />
</head>
<body>
    <partial name="Partials/_AppNavigation" />

    <main class="page-shell edit-profile-page">
        <a href="/Profile" class="text-link edit-profile-page__back">
            <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
            Quay lại hồ sơ
        </a>

        @* #region Banner *@
        <section class="profile-banner" aria-labelledby="edit-title">
            <div class="profile-banner__avatar-wrap">
                <div class="profile-banner__avatar" id="avatarPreview">
                    @if (!string.IsNullOrWhiteSpace(avatarUrl))
                    {
                        <img src="@avatarUrl" alt="Ảnh đại diện hiện tại" referrerpolicy="no-referrer" />
                    }
                    else
                    {
                        @initial
                    }
                </div>
                <button type="button"
                        class="edit-avatar-button"
                        aria-label="Đổi ảnh đại diện"
                        title="Đổi ảnh đại diện"
                        onclick="document.getElementById('avatarInput').click()">
                    <i class="fa-solid fa-camera" aria-hidden="true"></i>
                </button>
            </div>

            <div class="profile-banner__identity">
                <span class="profile-banner__label">Chỉnh sửa hồ sơ</span>
                <h1 id="edit-title" class="profile-banner__name">@userName</h1>
                <p class="profile-banner__status">
                    Bấm vào biểu tượng máy ảnh để đổi ảnh đại diện. Nhận JPG, PNG hoặc WebP, tối đa 5 MB.
                </p>
            </div>
        </section>
        @* #endregion *@

        <form class="edit-profile-form"
              id="profile-edit-form"
              method="post"
              asp-controller="Profile"
              asp-action="Edit"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="form-validation" role="alert"></div>
            <input type="file"
                   id="avatarInput"
                   name="AvatarFile"
                   accept=".jpg,.jpeg,.png,.webp"
                   class="visually-hidden"
                   onchange="previewAvatar(event)">

            @* #region 1. Thông tin cơ bản *@
            <section class="form-step" aria-labelledby="step-basic">
                <h2 id="step-basic" class="form-step__title"><span class="form-step__number">1</span>Thông tin cơ bản</h2>
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-field__label" for="lastName">Họ</label>
                        <input type="text" id="lastName" name="LastName" class="form-control"
                               value="@Model?.LastName" maxlength="50" placeholder="Nhập họ">
                    </div>
                    <div class="form-field">
                        <label class="form-field__label" for="firstName">Tên</label>
                        <input type="text" id="firstName" name="FirstName" class="form-control"
                               value="@Model?.FirstName" maxlength="50" placeholder="Nhập tên" required>
                    </div>
                </div>
            </section>
            @* #endregion *@

            @* #region 2. Định hướng nghề nghiệp *@
            <section class="form-step" aria-labelledby="step-career">
                <h2 id="step-career" class="form-step__title"><span class="form-step__number">2</span>Định hướng nghề nghiệp</h2>
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-field__label" for="major">Chuyên ngành</label>
                        <input type="text" id="major" name="Major" class="form-control"
                               value="@Model?.Major" maxlength="100" placeholder="VD: Kỹ thuật phần mềm">
                    </div>
                    <div class="form-field">
                        <label class="form-field__label" for="position">Vị trí muốn ứng tuyển</label>
                        <input type="text" id="position" name="TargetPosition" class="form-control"
                               value="@Model?.TargetPosition" maxlength="100" placeholder="VD: Backend Developer">
                    </div>
                </div>
            </section>
            @* #endregion *@

            @* #region 3. Trạng thái hiện tại *@
            <section class="form-step" aria-labelledby="step-status">
                <h2 id="step-status" class="form-step__title"><span class="form-step__number">3</span>Trạng thái hiện tại</h2>
                <input type="hidden" id="studentStatus" name="GraduationStatus" value="@graduation">
                <div class="choice-group" id="grad-options">
                    @foreach (var (value, label) in graduationOptions)
                    {
                        var isActive = value == graduation;
                        <button type="button"
                                class="choice-pill @(isActive ? "active" : null)"
                                aria-pressed="@(isActive ? "true" : "false")"
                                onclick="selectChoice('studentStatus', '@value', 'grad-options', this)">
                            @label
                        </button>
                    }
                </div>
            </section>
            @* #endregion *@

            @* #region 4. Mức kinh nghiệm *@
            <section class="form-step" aria-labelledby="step-level">
                <h2 id="step-level" class="form-step__title"><span class="form-step__number">4</span>Mức kinh nghiệm</h2>
                <input type="hidden" id="experienceLevel" name="ExperienceLevel" value="@experience">
                <div class="level-grid" id="exp-options">
                    @for (int i = 0; i < experienceOptions.Length; i++)
                    {
                        var (value, note) = experienceOptions[i];
                        var isActive = value == experience;
                        <button type="button"
                                class="level-card @(isActive ? "active" : null)"
                                aria-pressed="@(isActive ? "true" : "false")"
                                onclick="selectChoice('experienceLevel', '@value', 'exp-options', this)">
                            <span class="level-bars" aria-hidden="true">
                                @for (int bar = 0; bar < experienceOptions.Length; bar++)
                                {
                                    <span class="@(bar <= i ? "is-on" : null)"></span>
                                }
                            </span>
                            <span class="level-card__text">
                                <strong>@value</strong>
                                <small>@note</small>
                            </span>
                        </button>
                    }
                </div>
            </section>
            @* #endregion *@

            <div class="form-footer">
                <a href="/Profile" class="button button--secondary">Huỷ</a>
                <button type="submit" class="button button--primary button--icon">
                    <span class="button__icon" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
                    Lưu thay đổi
                </button>
            </div>
        </form>
    </main>

    <script>
        // Chọn một lựa chọn trong nhóm: ghi vào input ẩn và đổi trạng thái nút
        function selectChoice(inputId, value, groupId, button) {
            var hiddenInput = document.getElementById(inputId);
            if (!hiddenInput) return;
            hiddenInput.value = value;

            document.querySelectorAll('#' + groupId + ' [aria-pressed]').forEach(function (item) {
                item.classList.remove('active');
                item.setAttribute('aria-pressed', 'false');
            });

            button.classList.add('active');
            button.setAttribute('aria-pressed', 'true');
        }

        // Xem trước ảnh vừa chọn (chưa tải lên cho tới khi bấm Lưu)
        function previewAvatar(event) {
            var file = event.target.files && event.target.files[0];
            if (!file || !file.type.startsWith('image/')) return;

            var avatar = document.getElementById('avatarPreview');
            if (!avatar) return;

            var objectUrl = URL.createObjectURL(file);
            var img = document.createElement('img');
            img.alt = 'Xem trước ảnh đại diện';
            img.onload = function () { URL.revokeObjectURL(objectUrl); };
            img.src = objectUrl;
            avatar.replaceChildren(img);
        }
    </script>
    <partial name="Partials/_Notify" />
</body>
</html>
