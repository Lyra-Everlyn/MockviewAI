@model MockviewAI.Models.ViewModels.ProfileEditViewModel
@{
    Layout = null;
    ViewData["ActiveNav"] = "";   // mục sáng trên thanh menu dùng chung
    var initial = string.IsNullOrEmpty(Model?.FullName) ? "?" : Model.FullName.Substring(0, 1).ToUpper();
    var avatarUrl = User.FindFirst("AvatarUrl")?.Value;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sửa hồ sơ - MockviewAI</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/EditProfile.css">
    <link rel="stylesheet" href="~/css/theme.css"> <!-- giao diện chung: nạp SAU CSS của trang -->
</head>
<body>

    <partial name="Partials/_TopNav" />

    <main class="main-container">
        
        <div class="page-header">
            <a href="/Profile" class="back-link">&lsaquo; Hồ sơ</a>
            <h1 class="page-title">Sửa hồ sơ</h1>
        </div>

        <div class="edit-profile-card">
            
            <div class="avatar-section">
                <div class="avatar-circle">
                    @if (!string.IsNullOrEmpty(avatarUrl)) { <img src="@avatarUrl" alt="" referrerpolicy="no-referrer" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;" /> } else { @initial }
                </div>
                <a href="#" class="change-avatar-btn">Đổi ảnh đại diện</a>
            </div>

            <!-- Bắn về ProfileController -->
            <form class="profile-form" method="post" action="/Profile/Edit">
                @Html.AntiForgeryToken()
                
                <div class="form-group full-width">
                    <label class="form-label" for="fullname">Họ và tên</label>
                    <input type="text" id="fullname" name="FullName" class="form-input" value="@Model?.FullName" maxlength="100" required>
                </div>

                <div class="form-row">
                    <!-- THAY BẰNG INPUT TEXT -->
                    <div class="form-group">
                        <label class="form-label" for="major">Chuyên ngành</label>
                        <input type="text" id="major" name="Major" class="form-input" value="@Model?.Major" placeholder="VD: Công nghệ thông tin">
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="position">Vị trí muốn ứng tuyển</label>
                        <input type="text" id="position" name="TargetPosition" class="form-input" value="@Model?.TargetPosition" placeholder="VD: Backend Developer">
                    </div>
                </div>

                <div class="form-group full-width">
                    <label class="form-label">Tình trạng học tập</label>
                    <input type="hidden" id="studentStatus" name="GraduationStatus" value="@(Model?.GraduationStatus ?? "Expecting Graduation")">
                    <div class="status-options" id="grad-options">
                        <button type="button" class="status-btn @(Model?.GraduationStatus == "Current Student" ? "active" : "")" onclick="selectBtn('studentStatus', 'Current Student', 'grad-options', this)">Đang đi học</button>
                        <button type="button" class="status-btn @(Model?.GraduationStatus == "Expecting Graduation" ? "active" : "")" onclick="selectBtn('studentStatus', 'Expecting Graduation', 'grad-options', this)">Sắp ra trường</button>
                        <button type="button" class="status-btn @(Model?.GraduationStatus == "Graduated" ? "active" : "")" onclick="selectBtn('studentStatus', 'Graduated', 'grad-options', this)">Đã ra trường</button>
                        <button type="button" class="status-btn @(Model?.GraduationStatus == "Other" ? "active" : "")" onclick="selectBtn('studentStatus', 'Other', 'grad-options', this)">Khác</button>
                    </div>
                </div>

                <!-- BỔ SUNG KINH NGHIỆM TỪ ONBOARDING -->
                <div class="form-group full-width" style="margin-top: 15px;">
                    <label class="form-label">Kinh nghiệm</label>
                    <input type="hidden" id="experienceLevel" name="ExperienceLevel" value="@(Model?.ExperienceLevel ?? "Intern / Fresher")">
                    <div class="status-options" id="exp-options">
                        <button type="button" class="status-btn @(Model?.ExperienceLevel == "Intern / Fresher" ? "active" : "")" onclick="selectBtn('experienceLevel', 'Intern / Fresher', 'exp-options', this)">Intern/Fresher</button>
                        <button type="button" class="status-btn @(Model?.ExperienceLevel == "Junior" ? "active" : "")" onclick="selectBtn('experienceLevel', 'Junior', 'exp-options', this)">Junior</button>
                        <button type="button" class="status-btn @(Model?.ExperienceLevel == "Mid-Level" ? "active" : "")" onclick="selectBtn('experienceLevel', 'Mid-Level', 'exp-options', this)">Mid-Level</button>
                        <button type="button" class="status-btn @(Model?.ExperienceLevel == "Senior / Lead" ? "active" : "")" onclick="selectBtn('experienceLevel', 'Senior / Lead', 'exp-options', this)">Senior</button>
                    </div>
                </div>

                <div class="form-actions" style="margin-top: 25px;">
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                    <button type="button" class="btn btn-outline" onclick="location.href='/Profile'">Huỷ</button>
                </div>

            </form>

        </div>
    </main>

    <script>
        function selectBtn(inputId, value, groupId, btnElement) {
            document.getElementById(inputId).value = value;
            document.querySelectorAll('#' + groupId + ' .status-btn').forEach(b => b.classList.remove('active'));
            btnElement.classList.add('active');
        }
    </script>
    <partial name="Partials/_Notify" />
</body>
</html>