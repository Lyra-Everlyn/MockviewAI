{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Security": {
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15
  },
  "Gemini": {
    "ApiKey": "",
    "Model": "",
    "MaxTokens": 5000
  },
  "Speech": {
    "WhisperModel": "whisper-large-v3",
    "WhisperFallbackModel": "",
    "NoSpeechThreshold": 0.6,
    "LogprobThreshold": -1.0,
    "CompressionRatioThreshold": 2.4,
    "Language": "auto",
    "MaxAudioBytes": 10485760,
    "UseQuestionAsWhisperPrompt": false,
    "WhisperStylePrompt": "Dạ, em làm backend với C#, .NET Core, Docker, Redis cache, PostgreSQL và REST API.",
    "TranscribeTimeoutSeconds": 30,
    "NormalizeTranscript": true,
    "NormalizerModel": "gemini-3.5-flash-lite",
    "NormalizerFallbackModel": "",
    "NormalizerThinkingLevel": "minimal",
    "NormalizeAttemptTimeoutSeconds": 8,
    "NormalizeTimeoutSeconds": 14,
    "MaxLengthChangeRatio": 0.3
  }
}
