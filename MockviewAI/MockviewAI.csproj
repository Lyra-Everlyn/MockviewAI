    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>9f82b930-0bdc-4b72-b7a2-cb573d600e0d</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="9.0.17" />
